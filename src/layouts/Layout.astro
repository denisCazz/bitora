---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import PerformanceMonitorSimple from '../components/PerformanceMonitorSimple.astro';
import PerformanceOptimizer from '../components/PerformanceOptimizer.astro';
import StickyContactBar from '../components/StickyContactBar.astro';
import { founderNode, organizationNode, webPageNode, websiteNode, type PageType } from '../data/seo';
import '../styles/global.css';
import '../styles/brand.css';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  pageType?: PageType;
  ogType?: 'website' | 'article';
  schema?: Record<string, unknown>[];
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
}

const {
  title,
  description,
  image,
  imageAlt,
  noindex = false,
  pageType = 'WebPage',
  ogType = 'website',
  schema = [],
  publishedTime,
  modifiedTime,
  section,
} = Astro.props;
const siteOrigin = (Astro.site?.origin ?? 'https://bitora.it').replace(/\/$/, '');
const pathname = Astro.url.pathname || '/';
const normalizedPath = pathname === '/' ? '/' : pathname.endsWith('/') ? pathname : `${pathname}/`;
const canonicalUrl = `${siteOrigin}${normalizedPath}`;

const ogImage = image?.startsWith('http')
  ? image
  : image
    ? `${siteOrigin}${image.startsWith('/') ? image : `/${image}`}`
    : `${siteOrigin}/og-bitora.jpg`;

const robotsContent = noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large';

const defaultDescription =
  'Bitora è lo studio digitale di Carmagnola (TO): siti web, e-commerce, gestionali su misura, app mobile e AI per aziende del Piemonte e di tutta Italia. Preventivo gratuito in 24 ore.';
const metaDescription = description ?? defaultDescription;
const ogImageAlt = imageAlt ?? (image ? title : 'Bitora: siti web, e-commerce, gestionali e app su misura');

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    organizationNode(),
    founderNode(),
    websiteNode(),
    ...(noindex
      ? []
      : [
          webPageNode({
            url: canonicalUrl,
            title,
            description: metaDescription,
            image: ogImage,
            type: pageType,
            dateModified: new Date().toISOString().slice(0, 10),
          }),
        ]),
    ...schema,
  ],
};
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      document.documentElement.classList.add('dark');
    </script>

    <!-- Consent Mode v2 defaults (denied until opt-in) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      window.gtag = gtag;
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'denied',
        personalization_storage: 'denied',
        security_storage: 'granted',
        wait_for_update: 500,
      });
    </script>

    <meta
      name="trustpilot-one-time-domain-verification-id"
      content="a73b7189-4327-406d-9010-8bc27db1d6c1"
    />
    <PerformanceOptimizer />
    <PerformanceMonitorSimple />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="robots" content={robotsContent} />
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="it-IT" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <meta name="geo.region" content="IT-TO" />
    <meta name="geo.placename" content="Carmagnola, Torino" />
    <meta name="geo.position" content="44.8477;7.6833" />
    <meta name="ICBM" content="44.8477, 7.6833" />

    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt" />
    {
      normalizedPath === '/blog' || normalizedPath.startsWith('/blog/') ? (
        <link
          rel="alternate"
          type="application/rss+xml"
          href="/blog/rss.xml"
          title="Radar Bitora"
        />
      ) : null
    }

    <style is:global>
      html {
        scroll-behavior: smooth;
        overflow-x: clip;
      }
      body {
        margin: 0;
        padding: 0;
        overflow-x: clip;
      }
    </style>

    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const observer = new IntersectionObserver(
        entries => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            const delay = Number(el.dataset.revealDelay || 0);
            if (delay) el.style.transitionDelay = `${delay * 90}ms`;
            el.classList.add('is-in', 'is-visible', 'rv');
            observer.unobserve(el);
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
      );
      function bootReveal() {
        document.querySelectorAll('[data-reveal], .reveal-on-scroll').forEach(el => {
          if (reduced) el.classList.add('is-in', 'is-visible', 'rv');
          else observer.observe(el);
        });
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bootReveal);
      else bootReveal();
    </script>

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/bitora.png" />
    <meta name="theme-color" content="#050607" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&family=Unbounded:wght@500;600;700&display=swap"
    />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {
      (!image || image.startsWith('/og/')) && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    {
      ogType === 'article' && (
        <>
          {publishedTime && <meta property="article:published_time" content={publishedTime} />}
          {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
          {section && <meta property="article:section" content={section} />}
          <meta property="article:author" content="https://bitora.it/chi-siamo/" />
          <meta name="author" content="Denis Cazzulo" />
        </>
      )
    }
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content="Bitora" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body class="b-body flex flex-col min-h-screen antialiased">
    <a href="#main-content" class="skip-link">Vai al contenuto</a>
    <Header />
    <main id="main-content" class="flex-grow" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <StickyContactBar />

    <script is:inline>
      window.__bitoraTags = window.__bitoraTags || {
        ga: false,
        ads: false,
        meta: false,
        umami: false,
      };

      function getCookieConsent() {
        var cookies = document.cookie.split(';');
        for (var i = 0; i < cookies.length; i++) {
          var parts = cookies[i].trim().split('=');
          if (parts[0] === 'bitora_cookie_consent') {
            try {
              return JSON.parse(decodeURIComponent(parts.slice(1).join('=')));
            } catch (e) {
              return null;
            }
          }
        }
        return null;
      }

      function updateConsentMode(consent) {
        if (typeof gtag !== 'function') return;
        var analytics = !!(consent && consent.analytics);
        var marketing = !!(consent && consent.marketing);
        var functional = !!(consent && consent.functional);
        gtag('consent', 'update', {
          analytics_storage: analytics ? 'granted' : 'denied',
          ad_storage: marketing ? 'granted' : 'denied',
          ad_user_data: marketing ? 'granted' : 'denied',
          ad_personalization: marketing ? 'granted' : 'denied',
          functionality_storage: functional ? 'granted' : 'denied',
          personalization_storage: functional ? 'granted' : 'denied',
        });
      }

      function loadScriptOnce(src, attrs, onload) {
        if (document.querySelector('script[src="' + src + '"]')) {
          if (onload) onload();
          return;
        }
        var s = document.createElement('script');
        s.async = true;
        s.src = src;
        if (attrs) {
          Object.keys(attrs).forEach(function (k) {
            s.setAttribute(k, attrs[k]);
          });
        }
        if (onload) s.onload = onload;
        document.head.appendChild(s);
      }

      function loadGA4() {
        if (window.__bitoraTags.ga) return;
        loadScriptOnce(
          'https://www.googletagmanager.com/gtag/js?id=G-EL32YTDTYH',
          null,
          function () {
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', 'G-EL32YTDTYH', {
              anonymize_ip: true,
              send_page_view: true,
              transport_type: 'beacon',
            });
            window.__bitoraTags.ga = true;
          }
        );
      }

      function loadGoogleAds() {
        if (window.__bitoraTags.ads) return;
        loadScriptOnce(
          'https://www.googletagmanager.com/gtag/js?id=AW-17047013851',
          null,
          function () {
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', 'AW-17047013851');
            window.__bitoraTags.ads = true;
          }
        );
      }

      function loadMetaPixel() {
        if (window.__bitoraTags.meta || typeof fbq === 'function') {
          window.__bitoraTags.meta = true;
          return;
        }
        !(function (f, b, e, v, n, t, s) {
          if (f.fbq) return;
          n = f.fbq = function () {
            n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
          };
          if (!f._fbq) f._fbq = n;
          n.push = n;
          n.loaded = !0;
          n.version = '2.0';
          n.queue = [];
          t = b.createElement(e);
          t.async = !0;
          t.src = v;
          s = b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t, s);
        })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '1145664477751927');
        fbq('track', 'PageView');
        window.__bitoraTags.meta = true;
      }

      function loadUmami() {
        if (window.__bitoraTags.umami) return;
        if (
          document.querySelector('script[data-website-id="a078fba7-a632-4f51-826e-986e1d8fa5c4"]')
        ) {
          window.__bitoraTags.umami = true;
          return;
        }
        var script = document.createElement('script');
        script.defer = true;
        script.src = 'https://umami.bitora.it/script.js';
        script.setAttribute('data-website-id', 'a078fba7-a632-4f51-826e-986e1d8fa5c4');
        document.head.appendChild(script);
        window.__bitoraTags.umami = true;
      }

      function applyTagLoading(consent) {
        updateConsentMode(consent);
        if (consent && consent.analytics) {
          loadGA4();
          loadUmami();
        }
        if (consent && consent.marketing) {
          loadGoogleAds();
          loadMetaPixel();
        }
      }

      function bootConsentTags() {
        applyTagLoading(getCookieConsent());
      }

      document.addEventListener('DOMContentLoaded', bootConsentTags);
      window.addEventListener('cookieConsentChanged', function (e) {
        applyTagLoading(e.detail || getCookieConsent());
      });

      window.bitoraTrack = function (eventName, props) {
        props = props || {};
        try {
          if (typeof umami !== 'undefined' && umami.track) {
            umami.track(eventName, props);
          }
        } catch (e) {}
        try {
          if (typeof gtag === 'function') {
            gtag('event', eventName, props);
            if (
              eventName === 'lead_form_submit' ||
              eventName === 'generate_lead' ||
              eventName === 'roi_report_submit'
            ) {
              gtag('event', 'generate_lead', Object.assign({ event_category: 'lead' }, props));
              if (window.__bitoraTags.ads) {
                gtag('event', 'conversion', { send_to: 'AW-17047013851' });
              }
            }
          }
        } catch (e) {}
        try {
          if (
            typeof fbq === 'function' &&
            (eventName === 'lead_form_submit' || eventName === 'generate_lead')
          ) {
            fbq('track', 'Lead', props);
          }
        } catch (e) {}
      };

      function bindTrackableClicks() {
        document.querySelectorAll('[data-track]').forEach(function (el) {
          if (el.getAttribute('data-track-bound') === '1') return;
          el.setAttribute('data-track-bound', '1');
          el.addEventListener('click', function () {
            var eventName = el.getAttribute('data-track');
            var location = el.getAttribute('data-track-location') || 'page';
            if (eventName) window.bitoraTrack(eventName, { location: location });
          });
        });
      }
      document.addEventListener('DOMContentLoaded', bindTrackableClicks);
      document.addEventListener('astro:page-load', bindTrackableClicks);
    </script>

    <CookieBanner />
  </body>
</html>
