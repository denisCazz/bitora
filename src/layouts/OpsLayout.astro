---
export interface Props {
  title: string;
  heading?: string;
}

const { title, heading } = Astro.props;
const path = Astro.url.pathname;
const normalized = path.endsWith('/') ? path : `${path}/`;

const nav = [
  { href: '/ops/', label: 'Panoramica' },
  { href: '/ops/siti/', label: 'Stato siti' },
  { href: '/ops/vps/', label: 'Monitoraggio VPS' },
  { href: '/ops/storico/', label: 'Storico' },
  { href: '/ops/infrastruttura/', label: 'Infrastruttura' },
  { href: '/ops/incidenti/', label: 'Incidenti' },
];
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <title>{title}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="ops-body">
    <a href="#ops-main" class="ops-skip">Vai al contenuto</a>
    <div class="ops-shell">
      <aside class="ops-sidebar">
        <a href="/ops/" class="ops-brand">
          <span class="ops-brand-mark">B</span>
          <span>
            <strong>Bitora Ops</strong>
            <small>Area privata</small>
          </span>
        </a>
        <nav aria-label="Strumenti interni">
          {
            nav.map(item => (
              <a
                href={item.href}
                class:list={['ops-nav-link', normalized === item.href && 'is-active']}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="ops-sidebar-foot">
          <form method="POST" action="/api/ops/logout/">
            <button type="submit">Esci</button>
          </form>
          <a href="/">bitora.it</a>
        </div>
      </aside>
      <div class="ops-main-wrap">
        <header class="ops-top">
          <p class="ops-kicker">Area privata</p>
          <h1>{heading ?? title}</h1>
        </header>
        <main id="ops-main" class="ops-main">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
  }
  * {
    box-sizing: border-box;
  }
  .ops-body {
    margin: 0;
    min-height: 100vh;
    background: #050505;
    color: #f5f5f7;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .ops-skip {
    position: absolute;
    left: -999px;
    top: 0;
  }
  .ops-skip:focus {
    left: 12px;
    top: 12px;
    z-index: 20;
    background: #fff;
    color: #000;
    padding: 8px 12px;
    border-radius: 8px;
  }
  .ops-shell {
    display: grid;
    grid-template-columns: 240px 1fr;
    min-height: 100vh;
  }
  .ops-sidebar {
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    padding: 28px 20px;
    display: flex;
    flex-direction: column;
    gap: 28px;
    background: #0a0a0b;
  }
  .ops-brand {
    display: flex;
    gap: 12px;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }
  .ops-brand-mark {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: #fff;
    color: #000;
    display: grid;
    place-items: center;
    font-weight: 800;
  }
  .ops-brand strong {
    display: block;
    font-size: 14px;
  }
  .ops-brand small {
    display: block;
    color: rgba(255, 255, 255, 0.45);
    font-size: 12px;
  }
  .ops-sidebar nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .ops-nav-link {
    color: rgba(255, 255, 255, 0.62);
    text-decoration: none;
    padding: 10px 12px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
  }
  .ops-nav-link:hover,
  .ops-nav-link.is-active {
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
  }
  .ops-sidebar-foot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 13px;
    padding-bottom: 4px;
  }
  .ops-sidebar-foot button,
  .ops-sidebar-foot a {
    color: rgba(255, 255, 255, 0.5);
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
    text-align: left;
    text-decoration: none;
  }
  .ops-sidebar-foot button:hover,
  .ops-sidebar-foot a:hover {
    color: #fff;
  }
  .ops-main-wrap {
    min-width: 0;
  }
  .ops-top {
    padding: 36px 36px 0;
  }
  .ops-kicker {
    margin: 0 0 8px;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    font-weight: 700;
  }
  .ops-top h1 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    letter-spacing: -0.04em;
  }
  .ops-main {
    padding: 28px 36px 48px;
  }
  .ops-grid {
    display: grid;
    gap: 16px;
  }
  .ops-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 16px;
  }
  .ops-card {
    display: block;
    background: #111113;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 22px;
    color: inherit;
    text-decoration: none;
  }
  .ops-card h2 {
    margin: 0 0 8px;
    font-size: 18px;
  }
  .ops-section-title {
    margin: 0 0 12px;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }
  .ops-muted {
    color: rgba(255, 255, 255, 0.55);
    font-size: 14px;
    line-height: 1.55;
    margin: 0;
  }
  .ops-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .ops-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #34d399;
  }
  .ops-dot.warn {
    background: #fbbf24;
  }
  .ops-dot.down {
    background: #f87171;
  }
  .ops-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 10px;
    padding: 10px 14px;
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    background: #fff;
    color: #000;
  }
  .ops-btn:hover {
    background: #e8e8ea;
  }
  .ops-btn.ghost {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.16);
  }
  .ops-main input,
  .ops-main select,
  .ops-main textarea {
    min-height: 40px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 10px;
    padding: 8px 11px;
    background: #111113;
    color: #fff;
    font: inherit;
  }
  .ops-table-wrap {
    overflow-x: auto;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    background: #111113;
  }
  .ops-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .ops-table th,
  .ops-table td {
    padding: 14px 16px;
    text-align: left;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    white-space: nowrap;
  }
  .ops-table th {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    font-weight: 700;
  }
  .ops-table a {
    color: inherit;
  }
  .ops-link {
    color: #93c5fd;
    font-weight: 600;
    text-decoration: none;
  }
  .ops-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ops-missing {
    color: #fbbf24;
    font-weight: 600;
  }
  .ops-meter {
    height: 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
    margin-top: 10px;
  }
  .ops-meter span {
    display: block;
    height: 100%;
    background: #34d399;
  }
  .ops-meter.warn span {
    background: #fbbf24;
  }
  .ops-meter.down span {
    background: #f87171;
  }
  .ops-note {
    margin-top: 18px;
    padding: 16px 18px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px dashed rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.6);
    font-size: 13px;
    line-height: 1.6;
  }
  .ops-note code,
  .ops-note pre {
    font-size: 12px;
    color: #fff;
    white-space: pre-wrap;
    word-break: break-word;
  }
  @media (max-width: 860px) {
    .ops-shell {
      grid-template-columns: 1fr;
    }
    .ops-sidebar {
      border-right: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding: 18px;
    }
    .ops-sidebar nav {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .ops-sidebar-foot {
      flex-direction: row;
      align-items: center;
      margin-top: 0;
    }
    .ops-top,
    .ops-main {
      padding-left: 18px;
      padding-right: 18px;
    }
  }
</style>
