---
export interface FAQItem {
  question: string;
  answer: string;
}

export interface Props {
  items: FAQItem[];
  tone?: 'default' | 'on-dark';
}

const { items, tone = 'default' } = Astro.props;
const onDark = tone === 'on-dark';
---

<div class="space-y-3">
  {
    items.map(it => (
      <details
        class:list={[
          'group rounded-2xl border',
          onDark
            ? 'border-white/10 bg-white/[0.03]'
            : 'border-gray-200 dark:border-white/10 bg-white/70 dark:bg-white/[0.03] glass-panel',
        ]}
      >
        <summary class="cursor-pointer list-none px-5 py-4 flex items-center justify-between gap-4">
          <span class:list={['font-semibold', onDark ? 'text-white' : 'text-slate-950 dark:text-white']}>
            {it.question}
          </span>
          <span
            class:list={[
              'w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0',
              onDark ? 'bg-white/10' : 'bg-black/5 dark:bg-white/10',
            ]}
          >
            <svg
              class:list={[
                'w-5 h-5 transition-transform duration-200 group-open:rotate-180',
                onDark ? 'text-white' : 'text-slate-900 dark:text-white',
              ]}
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="m19.5 8.25-7.5 7.5-7.5-7.5"
              />
            </svg>
          </span>
        </summary>
        <div
          class:list={[
            'px-5 pb-5 -mt-1 leading-relaxed',
            onDark ? 'text-white/55' : 'text-slate-600 dark:text-slate-300',
          ]}
        >
          {it.answer}
        </div>
      </details>
    ))
  }
</div>
