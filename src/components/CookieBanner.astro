---
const toggles = [
  {
    id: 'analytics-cookies',
    title: 'Analisi',
    text: 'Google Analytics 4 e Umami, per capire quali pagine sono utili e migliorarle.',
  },
  {
    id: 'marketing-cookies',
    title: 'Marketing',
    text: 'Google Ads e Meta Pixel, per misurare le campagne e mostrarti annunci pertinenti.',
  },
  {
    id: 'functional-cookies',
    title: 'Funzionali',
    text: 'Preferenze non essenziali e funzioni avanzate.',
  },
];
---

<div id="cookie-banner" class="ck" role="region" aria-label="Consenso cookie" hidden>
  <div class="ck__box">
    <div class="ck__text">
      <p class="ck__title">Cookie, in breve.</p>
      <p>
        Usiamo cookie tecnici per far funzionare il sito e, solo se accetti, cookie di analisi e marketing (Google Analytics,
        Google Ads, Meta Pixel). <a href="/cookie-policy/">Cookie policy</a> · <a href="/privacy-policy/">Privacy</a>
      </p>
    </div>
    <div class="ck__actions">
      <button type="button" id="cookie-settings-btn" class="ck__link">Personalizza</button>
      <button type="button" id="cookie-reject" class="b-btn b-btn--ghost b-btn--sm">Rifiuta</button>
      <button type="button" id="cookie-accept" class="b-btn b-btn--primary b-btn--sm">Accetta</button>
    </div>
  </div>
</div>

<div id="cookie-settings-modal" class="ckm" role="dialog" aria-modal="true" aria-labelledby="ckm-title" hidden>
  <div class="ckm__panel">
    <div class="ckm__head">
      <p id="ckm-title" class="ckm__title">Preferenze cookie</p>
      <button type="button" id="close-cookie-settings" class="ckm__close" aria-label="Chiudi">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          ><path d="M6 6l12 12M18 6 6 18"></path></svg
        >
      </button>
    </div>
    <p class="ckm__lede">Scegli cosa attivare. Puoi cambiare idea quando vuoi da "Preferenze cookie" in fondo alla pagina.</p>

    <div class="ckm__rows">
      <div class="ckm__row">
        <div>
          <p class="ckm__row-t">Necessari</p>
          <p>Sicurezza, navigazione e memorizzazione del consenso.</p>
        </div>
        <span class="ckm__always">Sempre attivi</span>
      </div>
      {
        toggles.map(t => (
          <label class="ckm__row" for={t.id}>
            <div>
              <p class="ckm__row-t">{t.title}</p>
              <p>{t.text}</p>
            </div>
            <span class="ckm__switch">
              <input type="checkbox" id={t.id} />
              <span aria-hidden="true" />
            </span>
          </label>
        ))
      }
    </div>

    <div class="ckm__foot">
      <button type="button" id="cookie-reject-modal" class="b-btn b-btn--ghost b-btn--sm">Rifiuta tutti</button>
      <button type="button" id="save-cookie-settings" class="b-btn b-btn--light b-btn--sm">Salva scelte</button>
      <button type="button" id="cookie-accept-modal" class="b-btn b-btn--primary b-btn--sm">Accetta tutti</button>
    </div>
  </div>
</div>

<script>
  type ConsentState = {
    necessary: boolean;
    analytics: boolean;
    marketing: boolean;
    functional: boolean;
    timestamp: number;
  };

  const COOKIE = 'bitora_cookie_consent';
  const EXPIRY_DAYS = 365;
  const banner = document.getElementById('cookie-banner');
  const modal = document.getElementById('cookie-settings-modal');
  const box = (id: string) => document.getElementById(id) as HTMLInputElement | null;

  function getConsent(): ConsentState | null {
    for (const cookie of document.cookie.split(';')) {
      const [name, ...rest] = cookie.trim().split('=');
      if (name !== COOKIE) continue;
      try {
        const parsed = JSON.parse(decodeURIComponent(rest.join('=')));
        return {
          necessary: true,
          analytics: !!parsed.analytics,
          marketing: !!parsed.marketing,
          functional: !!parsed.functional,
          timestamp: parsed.timestamp || Date.now(),
        };
      } catch {
        return null;
      }
    }
    return null;
  }

  function setConsent(choice: Omit<ConsentState, 'necessary' | 'timestamp'>) {
    const consent: ConsentState = { necessary: true, ...choice, timestamp: Date.now() };
    const expires = new Date(Date.now() + EXPIRY_DAYS * 86_400_000).toUTCString();
    const secure = location.protocol === 'https:' ? ';secure' : '';
    document.cookie = `${COOKIE}=${encodeURIComponent(JSON.stringify(consent))};expires=${expires};path=/;samesite=lax${secure}`;
    window.dispatchEvent(new CustomEvent('cookieConsentChanged', { detail: consent }));
    hideBanner();
    hideSettings();
  }

  function showBanner() {
    if (!banner) return;
    banner.hidden = false;
    document.documentElement.classList.add('has-cookie-banner');
    requestAnimationFrame(() => requestAnimationFrame(() => banner.classList.add('is-in')));
  }

  function hideBanner() {
    if (!banner || banner.hidden) return;
    banner.classList.remove('is-in');
    document.documentElement.classList.remove('has-cookie-banner');
    setTimeout(() => (banner.hidden = true), 350);
  }

  function syncToggles() {
    const c = getConsent();
    box('analytics-cookies')!.checked = !!c?.analytics;
    box('marketing-cookies')!.checked = !!c?.marketing;
    box('functional-cookies')!.checked = !!c?.functional;
  }

  function showSettings() {
    if (!modal) return;
    syncToggles();
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => modal.classList.add('is-in'));
    (document.getElementById('save-cookie-settings') as HTMLElement | null)?.focus();
  }

  function hideSettings() {
    if (!modal || modal.hidden) return;
    modal.classList.remove('is-in');
    document.body.style.overflow = '';
    setTimeout(() => (modal.hidden = true), 200);
  }

  const all = (on: boolean) => setConsent({ analytics: on, marketing: on, functional: on });

  document.getElementById('cookie-accept')?.addEventListener('click', () => all(true));
  document.getElementById('cookie-accept-modal')?.addEventListener('click', () => all(true));
  document.getElementById('cookie-reject')?.addEventListener('click', () => all(false));
  document.getElementById('cookie-reject-modal')?.addEventListener('click', () => all(false));
  document.getElementById('cookie-settings-btn')?.addEventListener('click', showSettings);
  document.getElementById('close-cookie-settings')?.addEventListener('click', hideSettings);
  document.getElementById('save-cookie-settings')?.addEventListener('click', () =>
    setConsent({
      analytics: !!box('analytics-cookies')?.checked,
      marketing: !!box('marketing-cookies')?.checked,
      functional: !!box('functional-cookies')?.checked,
    })
  );
  modal?.addEventListener('click', e => {
    if (e.target === modal) hideSettings();
  });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') hideSettings();
  });
  window.addEventListener('openCookieSettings', showSettings);
  document.addEventListener('click', e => {
    const trigger = (e.target as HTMLElement).closest('[data-cookie-settings]');
    if (!trigger) return;
    e.preventDefault();
    showSettings();
  });

  (window as unknown as { resetCookieConsent: () => void }).resetCookieConsent = () => {
    document.cookie = `${COOKIE}=;expires=Thu, 01 Jan 1970 00:00:01 GMT;path=/`;
    location.reload();
  };

  if (!getConsent()) setTimeout(showBanner, 700);
</script>

<style>
  .ck {
    position: fixed;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 90;
    width: min(980px, calc(100% - 1.5rem));
    transform: translate(-50%, calc(100% + 2rem));
    opacity: 0;
    transition:
      transform 0.5s var(--b-ease),
      opacity 0.4s;
  }
  .ck.is-in {
    transform: translate(-50%, 0);
    opacity: 1;
  }
  .ck__box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    padding: 1.1rem 1.25rem 1.1rem 1.5rem;
    border-radius: 20px;
    border: 1px solid var(--b-line-2);
    background: rgba(10, 12, 15, 0.92);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow:
      0 30px 80px -20px rgba(0, 0, 0, 0.8),
      0 0 0 1px rgba(34, 211, 238, 0.06);
  }
  .ck__text {
    flex: 1 1 420px;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--b-fg-2);
  }
  .ck__text p {
    margin: 0;
  }
  .ck__title {
    margin-bottom: 0.25rem !important;
    font-family: var(--f-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--b-fg);
  }
  .ck__text a {
    color: var(--b-fg);
    text-decoration: underline;
    text-decoration-color: var(--b-line-2);
    text-underline-offset: 3px;
  }
  .ck__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .ck__link {
    padding: 0.5rem 0.75rem;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--b-fg-2);
    cursor: pointer;
  }
  .ck__link:hover {
    color: var(--b-cyan);
  }
  @media (max-width: 640px) {
    .ck__actions {
      width: 100%;
    }
    .ck__actions .b-btn {
      flex: 1;
      justify-content: center;
    }
    .ck__link {
      order: 3;
      width: 100%;
      text-align: center;
    }
  }

  .ckm {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: 1rem;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .ckm[hidden] {
    display: none;
  }
  .ckm.is-in {
    opacity: 1;
  }
  .ckm__panel {
    width: min(620px, 100%);
    max-height: calc(100dvh - 2rem);
    overflow-y: auto;
    padding: clamp(1.4rem, 3vw, 2rem);
    border-radius: var(--b-radius);
    border: 1px solid var(--b-line-2);
    background: var(--b-ink-2);
    box-shadow: 0 40px 120px -30px rgba(0, 0, 0, 0.9);
    transform: translateY(12px) scale(0.98);
    transition: transform 0.3s var(--b-ease);
  }
  .ckm.is-in .ckm__panel {
    transform: none;
  }
  .ckm__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .ckm__title {
    margin: 0;
    font-family: var(--f-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--b-fg);
  }
  .ckm__close {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--b-line-2);
    background: transparent;
    color: var(--b-fg-2);
    cursor: pointer;
  }
  .ckm__close:hover {
    color: var(--b-fg);
    border-color: var(--b-fg-3);
  }
  .ckm__lede {
    margin: 0.6rem 0 1.4rem;
    font-size: 0.92rem;
    color: var(--b-fg-2);
  }
  .ckm__rows {
    display: grid;
    gap: 0.6rem;
  }
  .ckm__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1rem 1.1rem;
    border-radius: 14px;
    border: 1px solid var(--b-line);
    background: rgba(255, 255, 255, 0.02);
    cursor: pointer;
  }
  .ckm__row p {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--b-fg-3);
  }
  .ckm__row .ckm__row-t {
    margin-bottom: 0.15rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--b-fg);
  }
  .ckm__always {
    flex: none;
    font-family: var(--f-mono);
    font-size: 0.72rem;
    color: var(--b-cyan);
  }
  .ckm__switch {
    position: relative;
    flex: none;
    width: 46px;
    height: 26px;
  }
  .ckm__switch input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }
  .ckm__switch span {
    position: absolute;
    inset: 0;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid var(--b-line-2);
    transition: background 0.2s;
    pointer-events: none;
  }
  .ckm__switch span::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--b-fg-2);
    transition:
      transform 0.25s var(--b-ease),
      background 0.2s;
  }
  .ckm__switch input:checked + span {
    background: var(--b-cyan);
    border-color: var(--b-cyan);
  }
  .ckm__switch input:checked + span::after {
    transform: translateX(20px);
    background: var(--b-ink);
  }
  .ckm__switch input:focus-visible + span {
    box-shadow: 0 0 0 4px rgba(34, 211, 238, 0.25);
  }
  .ckm__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  @media (max-width: 520px) {
    .ckm__foot .b-btn {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
