---
export interface Props {
  src?: string | null;
  alt?: string | null;
  topic?: string;
  eager?: boolean;
  class?: string;
}

const fallbackByTopic: Record<string, string> = {
  nfc: '/editorial/nfc-restaurant.png',
  web: '/editorial/web-offer.png',
  ai: '/editorial/digital-process.png',
  crm: '/editorial/crm.png',
  gestionali: '/editorial/operations.png',
  ecommerce: '/editorial/ecommerce.png',
  field: '/editorial/operations.png',
};

const { src, alt, topic = 'web', eager = false, class: className } = Astro.props;
const image = src || fallbackByTopic[topic] || '/editorial/web-offer.png';
const webp = image.startsWith('/editorial/') && image.endsWith('.png') ? image.replace(/\.png$/, '.webp') : null;
---

<picture class:list={['bc', className]}>
  {webp && <source srcset={webp} type="image/webp" />}
  <img
    src={image}
    alt={alt ?? ''}
    width="1280"
    height="720"
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : undefined}
  />
</picture>

<style>
  .bc {
    display: block;
    overflow: hidden;
    background: var(--b-ink-3);
  }
  .bc img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 1.2s var(--b-ease);
  }
</style>
