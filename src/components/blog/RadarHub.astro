---
import type { PublicArticle } from '../../lib/editorial/articles';
import { TOPIC_PILLARS } from '../../lib/editorial/topics';
import { formatArticleDate } from '../../lib/editorial/format';
import '../../styles/radar.css';

interface Props {
  articles: PublicArticle[];
}

const { articles } = Astro.props;
const featured = articles[0];
const byTopic = new Map<string, PublicArticle>();
for (const article of articles) {
  if (!byTopic.has(article.topic)) byTopic.set(article.topic, article);
}

const TICKS = Array.from({ length: 72 }, (_, i) => i * 5);
const RINGS = [14, 26, 38, 47.4];
const SWEEP_S = 8;

const contacts = TOPIC_PILLARS.map((pillar, index) => {
  const article = byTopic.get(pillar.id);
  const bearing = (index * 360) / TOPIC_PILLARS.length;
  const rad = ((bearing - 90) * Math.PI) / 180;
  const radius = 29 + (index % 3) * 6.5;
  const x = 50 + radius * Math.cos(rad);
  const y = 50 + radius * Math.sin(rad);
  return {
    pillar,
    article,
    bearing: String(Math.round(bearing)).padStart(3, '0'),
    range: (radius / 50).toFixed(2),
    channel: String(index + 1).padStart(2, '0'),
    x,
    y,
    delay: `${(index / TOPIC_PILLARS.length) * SWEEP_S}s`,
  };
});

const liveCount = contacts.filter(item => item.article).length;
const categories = [...new Set(articles.map(item => item.category))];
---

<section class="radar-shell px-6 md:px-12 lg:px-20 pt-24 md:pt-32">
  <p class="radar-kicker">Radar Bitora</p>
  <div class="max-w-3xl mb-10 md:mb-14">
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight leading-[1.08] mb-5">
      Il segnale tech,<br />tradotto sul campo.
    </h1>
    <p class="text-lg md:text-xl text-gray-600 dark:text-gray-400 leading-relaxed">
      Trend, casi veri e un percorso di lettura che non ti lascia scorrere a vuoto. L’AI propone, un
      umano pubblica. Obiettivo: una richiesta seria, non una pagina vista.
    </p>
  </div>

  <div class="radar-board">
    <div class="radar-console">
      <header class="radar-hud">
        <span class="radar-hud-brand">BTR-01</span>
        <span class="radar-hud-mode">PPI · RNG 1.00</span>
        <span class="radar-hud-live">Live {liveCount}/{contacts.length}</span>
      </header>

      <div class="radar-scope" aria-hidden="true">
        <div class="radar-bezel"></div>
        <div class="radar-glass"></div>
        <div class="radar-vignette"></div>
        <div class="radar-noise"></div>
        <div class="radar-glow"></div>
        <svg class="radar-svg" viewBox="0 0 100 100" role="presentation">
          <defs>
            <radialGradient id="radarDish" cx="50%" cy="38%" r="62%">
              <stop offset="0%" stop-color="#0c4a6e" stop-opacity="0.55"></stop>
              <stop offset="42%" stop-color="#042f4a" stop-opacity="0.28"></stop>
              <stop offset="100%" stop-color="#010409" stop-opacity="0.96"></stop>
            </radialGradient>
            <linearGradient id="radarCross" x1="0" x2="1">
              <stop offset="0%" stop-color="#38bdf8" stop-opacity="0"></stop>
              <stop offset="50%" stop-color="#7dd3fc" stop-opacity="0.55"></stop>
              <stop offset="100%" stop-color="#38bdf8" stop-opacity="0"></stop>
            </linearGradient>
          </defs>
          <circle cx="50" cy="50" r="49.4" fill="url(#radarDish)"></circle>
          {
            TICKS.map(deg => {
              const major = deg % 90 === 0;
              const mid = deg % 15 === 0;
              const outer = 49.2;
              const inner = major ? 45.2 : mid ? 46.6 : 47.8;
              const a = ((deg - 90) * Math.PI) / 180;
              const x1 = 50 + inner * Math.cos(a);
              const y1 = 50 + inner * Math.sin(a);
              const x2 = 50 + outer * Math.cos(a);
              const y2 = 50 + outer * Math.sin(a);
              return (
                <line
                  x1={x1.toFixed(2)}
                  y1={y1.toFixed(2)}
                  x2={x2.toFixed(2)}
                  y2={y2.toFixed(2)}
                  class:list={['radar-tick', major && 'is-major', mid && 'is-mid']}
                />
              );
            })
          }
          {RINGS.map(r => <circle cx="50" cy="50" r={r} class="radar-orbit" />)}
          <circle cx="50" cy="50" r="3.2" class="radar-orbit is-pip"></circle>
          <line x1="2.4" y1="50" x2="46.6" y2="50" stroke="url(#radarCross)" stroke-width="0.16"
          ></line>
          <line x1="53.4" y1="50" x2="97.6" y2="50" stroke="url(#radarCross)" stroke-width="0.16"
          ></line>
          <line x1="50" y1="2.4" x2="50" y2="46.6" stroke="url(#radarCross)" stroke-width="0.16"
          ></line>
          <line x1="50" y1="53.4" x2="50" y2="97.6" stroke="url(#radarCross)" stroke-width="0.16"
          ></line>
          <path class="radar-compass" d="M50 3.6 L51.2 8 L50 7.2 L48.8 8 Z" fill="#e0f2fe"></path>
          <text x="50" y="12.2" text-anchor="middle" class="radar-cardinal">N</text>
          <text x="88.6" y="51.2" text-anchor="middle" class="radar-cardinal">E</text>
          <text x="50" y="92.8" text-anchor="middle" class="radar-cardinal">S</text>
          <text x="11.4" y="51.2" text-anchor="middle" class="radar-cardinal">W</text>
          <text x="64.2" y="49.1" class="radar-range">.25</text>
          <text x="76.2" y="49.1" class="radar-range">.50</text>
          <text x="87.6" y="49.1" class="radar-range">.75</text>
        </svg>
        <div class="radar-sweep"></div>
        <div class="radar-sweep-beam"></div>
        <div class="radar-reticle"></div>
        {
          contacts.map(contact => (
            <span
              class:list={['radar-blip', contact.article ? 'is-live' : 'is-idle']}
              data-topic={contact.pillar.id}
              style={`left:${contact.x}%;top:${contact.y}%;--scan-delay:${contact.delay}`}
            >
              <span class="radar-blip-ring" />
              <span class="radar-blip-core" />
            </span>
          ))
        }
      </div>

      <footer class="radar-hud-foot">
        <span>AZ 000–360</span>
        <span>{contacts.length} settori</span>
        <span class="radar-hud-scan">SCAN</span>
      </footer>
    </div>

    <div class="radar-contacts-wrap">
      <header class="radar-contacts-head">
        <span>Contatti</span>
        <span>{liveCount} in traccia</span>
      </header>
      <ol class="radar-contacts" aria-label="Contatti sul radar">
        {
          contacts.map(contact =>
            contact.article ? (
              <li>
                <a
                  class="radar-contact is-live"
                  data-topic={contact.pillar.id}
                  href={`/blog/${contact.article.slug}/`}
                >
                  <span class="radar-contact-ch">{contact.channel}</span>
                  <span class="radar-contact-mark" />
                  <span class="radar-contact-copy">
                    <span class="radar-contact-topic">
                      {contact.pillar.label}
                      <em>
                        {contact.bearing}° · {contact.range}
                      </em>
                    </span>
                    <strong>{contact.article.title}</strong>
                  </span>
                  <span class="radar-contact-go" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ) : (
              <li>
                <div class="radar-contact is-idle" data-topic={contact.pillar.id}>
                  <span class="radar-contact-ch">{contact.channel}</span>
                  <span class="radar-contact-mark" />
                  <span class="radar-contact-copy">
                    <span class="radar-contact-topic">
                      {contact.pillar.label}
                      <em>
                        {contact.bearing}° · {contact.range}
                      </em>
                    </span>
                    <strong>In ascolto</strong>
                  </span>
                </div>
              </li>
            )
          )
        }
      </ol>
    </div>
  </div>
</section>

{
  featured && (
    <section class="px-6 md:px-12 lg:px-20 py-16">
      <p class="text-xs uppercase tracking-[0.18em] text-gray-500 mb-4">Segnale in evidenza</p>
      <a href={`/blog/${featured.slug}/`} class="group block max-w-4xl">
        <p class="text-sm text-gray-500 mb-2">
          {featured.category} · {formatArticleDate(featured.publishedAt)} · {featured.readTime}
        </p>
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight group-hover:text-gray-600 dark:group-hover:text-gray-300 transition-colors">
          {featured.title}
        </h2>
        <p class="mt-4 text-lg text-gray-600 dark:text-gray-400 max-w-2xl">
          {featured.abstract || featured.excerpt}
        </p>
      </a>
    </section>
  )
}

<section class="px-6 md:px-12 lg:px-20 pb-8">
  <div class="flex flex-wrap gap-2">
    <a
      href="/blog/"
      class="px-3 py-1 rounded-full text-sm border border-gray-300 dark:border-white/15">Tutti</a
    >
    {
      categories.map(category => (
        <a
          href={`#percorso-${category.toLowerCase().replace(/\s+/g, '-')}`}
          class="px-3 py-1 rounded-full text-sm border border-gray-200 dark:border-white/10 text-gray-600 dark:text-gray-300"
        >
          {category}
        </a>
      ))
    }
  </div>
</section>
