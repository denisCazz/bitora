---
import EditorialImage from '../EditorialImage.astro';
import LeadCapture from './LeadCapture.astro';
import Cover from './Cover.astro';
import type { PublicArticle } from '../../lib/editorial/articles';
import { ctaHrefWithArticle, ctaSpec } from '../../lib/editorial/cta';
import { formatArticleDate } from '../../lib/editorial/format';
import { sanitizeRichText } from '../../lib/editorial/sanitize';
import { DEFAULT_STAGES } from '../../lib/editorial/topics';
import { getWorkBySlugs } from '../../data/work';
import { workKindLabels } from '../../data/work';

interface Props {
  article: PublicArticle;
  preview?: boolean;
}

const { article, preview = false } = Astro.props;
const stages = article.content.stages.length ? article.content.stages : DEFAULT_STAGES;
const spec = ctaSpec(article.ctaVariant, article.topic, article.category);
const caseWork = getWorkBySlugs(
  article.content.blocks.flatMap(block => (block.type === 'case' ? [block.slug] : []))
);
const published = article.publishedAt ?? article.createdAt;
const updated = article.updatedAt;
const showUpdated = updated.getTime() - published.getTime() > 86_400_000;
---

{
  preview && (
    <p class="ar-preview">Anteprima bozza · non indicizzata · non pubblica</p>
  )
}

<div class="ar-progress" aria-hidden="true"><span data-progress></span></div>

<article class="ar">
  <header class="ar-hero">
    <div class="ar-hero__grid b-grid-bg" aria-hidden="true"></div>
    <div class="b-glow-orb ar-hero__orb" aria-hidden="true"></div>
    <div class="b-shell ar-hero__inner">
      <nav class="ar-crumbs b-rise" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/blog/">Blog</a>
        <span aria-hidden="true">/</span>
        <span>{article.category}</span>
      </nav>
      <h1 class="b-h1 ar-title b-rise" style="animation-delay:.08s">{article.title}</h1>
      <p class="b-lede ar-lede b-rise" style="animation-delay:.16s">{article.abstract || article.excerpt}</p>
      <div class="ar-byline b-rise" style="animation-delay:.24s">
        <img src="/bitora-mark.png" alt="" width="294" height="135" />
        <div>
          <p><a href="/chi-siamo/" rel="author">Denis Cazzulo</a> · Bitora</p>
          <p class="ar-byline__meta">
            <time datetime={published.toISOString()}>{formatArticleDate(published)}</time>
            {article.readTime && <span> · {article.readTime} di lettura</span>}
            {showUpdated && (
              <span>
                {' '}
                · aggiornato il <time datetime={updated.toISOString()}>{formatArticleDate(updated)}</time>
              </span>
            )}
          </p>
        </div>
      </div>
    </div>
  </header>

  <div class="b-shell ar-cover b-rise" style="animation-delay:.3s">
    <Cover src={article.coverImage} alt={article.coverAlt} topic={article.topic} eager />
  </div>

  <div class="b-shell ar-layout">
    <aside class="ar-rail">
      <div class="ar-rail__sticky">
        <p class="b-eyebrow">In questa guida</p>
        <ol class="ar-toc">
          {
            stages.map((stage, index) => (
              <li>
                <a href={`#stage-${stage.id}`} data-stage-link={stage.id}>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  {stage.label}
                </a>
              </li>
            ))
          }
        </ol>
        <p class="ar-depth" data-depth>Letto 0%</p>
        <div class="ar-rail__cta">
          <p>Hai un caso simile?</p>
          <a class="b-btn b-btn--primary b-btn--sm" href={ctaHrefWithArticle(spec.href, article.slug)}>{spec.label}</a>
        </div>
      </div>
    </aside>

    <div class="ar-body" data-journey-root data-article-slug={article.slug}>
      {
        article.content.blocks.map(block => {
          if (block.type === 'signal') {
            return (
              <section id="stage-signal" data-stage="signal" class="ar-signal">
                <div class="ar-signal__top">
                  <div class="ar-ring" data-signal-ring style="--p: 0">
                    <span>{block.seconds ?? 60}s</span>
                  </div>
                  <p class="b-eyebrow">In sintesi</p>
                </div>
                <h2 class="ar-signal__h">{block.heading}</h2>
                <p>{block.body}</p>
              </section>
            );
          }
          if (block.type === 'heading') {
            const Tag = block.level === 3 ? 'h3' : 'h2';
            return (
              <Tag id={block.stageId ? `stage-${block.stageId}` : undefined} data-stage={block.stageId}>
                {block.text}
              </Tag>
            );
          }
          if (block.type === 'paragraph') {
            return <p data-stage={block.stageId} set:html={sanitizeRichText(block.html)} />;
          }
          if (block.type === 'list') {
            const ListTag = block.ordered ? 'ol' : 'ul';
            return (
              <ListTag data-stage={block.stageId} class="ar-list">
                {block.items.map(item => (
                  <li set:html={sanitizeRichText(item)} />
                ))}
              </ListTag>
            );
          }
          if (block.type === 'image') {
            if (block.src === article.coverImage) return null;
            return (
              <div data-stage={block.stageId}>
                <EditorialImage src={block.src} alt={block.alt} caption={block.caption} eyebrow={block.eyebrow} />
              </div>
            );
          }
          if (block.type === 'proof') {
            return (
              <details data-stage={block.stageId || 'proof'} id="stage-proof" class="ar-proof">
                <summary>{block.title}</summary>
                <p>{block.body}</p>
                {block.sources?.length ? (
                  <ul>
                    {block.sources.map(source => (
                      <li>
                        <a href={source.url} rel="nofollow noopener" target="_blank">
                          {source.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : null}
              </details>
            );
          }
          if (block.type === 'case') {
            const w = caseWork.find(item => item.slug === block.slug);
            const cs = w ?? article.cases.find(item => item.slug === block.slug);
            return (
              <a data-stage={block.stageId || 'field'} id="stage-field" href={`/progetti/${block.slug}/`} class="ar-case">
                {w?.shot && (
                  <img src={w.shot} alt={`Progetto ${w.title}`} width="1200" height="750" loading="lazy" decoding="async" />
                )}
                <div>
                  <p class="b-eyebrow">Caso reale</p>
                  <p class="ar-case__t">{cs?.title ?? block.slug}</p>
                  <p class="ar-case__s">
                    {w ? w.kinds.map(k => workKindLabels[k]).join(' · ') : cs?.subtitle}
                    {cs?.location ? ` · ${cs.location}` : ''}
                  </p>
                  <p>{block.lesson}</p>
                  <span class="ar-case__go">Guarda il progetto →</span>
                </div>
              </a>
            );
          }
          if (block.type === 'quote') {
            return (
              <blockquote data-stage={block.stageId} class="ar-quote">
                <p>{block.text}</p>
                {block.attribution && <cite>{block.attribution}</cite>}
              </blockquote>
            );
          }
          if (block.type === 'demo') {
            return (
              <div data-stage={block.stageId || 'field'} class="ar-box">
                <p class="b-eyebrow">Prova tu</p>
                <p class="ar-box__t">{block.title}</p>
                <p>{block.body}</p>
                {block.kind === 'nfc-tap' ? (
                  <button type="button" class="nfc-stage" data-nfc-demo>
                    <span>
                      <b>Tocca la tessera</b>
                      <small data-nfc-label>Avvicina il telefono o clicca</small>
                    </span>
                    <span class="nfc-pair">
                      <span class="nfc-card">
                        <span class="nfc-waves" />
                      </span>
                      <span class="nfc-phone" />
                    </span>
                  </button>
                ) : (
                  <a class="b-btn b-btn--primary" href={ctaHrefWithArticle(spec.href, article.slug)}>
                    Prova lo strumento
                  </a>
                )}
              </div>
            );
          }
          if (block.type === 'diagnostic') {
            return (
              <form data-stage={block.stageId || 'act'} class="ar-box ar-diag" data-diagnostic>
                <p class="b-eyebrow">Check rapido</p>
                <p class="ar-box__t">Dove sei oggi?</p>
                {block.questions.map(question => (
                  <fieldset>
                    <legend>{question.prompt}</legend>
                    <div class="ar-diag__opts">
                      {question.options.map(option => (
                        <label class="b-choice">
                          <input type="radio" name={question.id} value={option.id} data-cta={option.cta || ''} />
                          <span>{option.label}</span>
                        </label>
                      ))}
                    </div>
                  </fieldset>
                ))}
              </form>
            );
          }
          if (block.type === 'cta') {
            const local = ctaSpec(block.variant, article.topic, article.category);
            return (
              <section data-stage={block.stageId || 'act'} id="stage-act" class="ar-cta">
                <p class="ar-cta__t">{block.headline}</p>
                <p>{block.body}</p>
                <div class="b-cta-row">
                  <a class="b-btn b-btn--primary" href={ctaHrefWithArticle(local.href, article.slug)}>
                    {local.label} →
                  </a>
                  <a class="b-btn b-btn--ghost" href={local.secondaryHref}>
                    {local.secondaryLabel}
                  </a>
                </div>
              </section>
            );
          }
          if (block.type === 'faq') {
            return (
              <div data-stage={block.stageId}>
                <h2>Domande frequenti</h2>
                <div class="b-faq">
                  {block.items.map(item => (
                    <details>
                      <summary>{item.question}</summary>
                      <p>{item.answer}</p>
                    </details>
                  ))}
                </div>
              </div>
            );
          }
          return null;
        })
      }

      {
        article.sources.length > 0 && (
          <section class="ar-sources">
            <p class="b-eyebrow">Fonti</p>
            <ul>
              {article.sources.map(source => (
                <li>
                  <a href={source.url} rel="nofollow noopener" target="_blank">
                    {source.title}
                  </a>
                  {source.domain && <span> · {source.domain}</span>}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        article.generatedByAi && (
          <p class="ar-note">
            Bozza preparata con il supporto dell’intelligenza artificiale, verificata e pubblicata da una persona del team Bitora.
          </p>
        )
      }

      <LeadCapture article={article} />
    </div>
  </div>
</article>

<script>
  const root = document.querySelector('[data-journey-root]');
  if (root) {
    const slug = root.getAttribute('data-article-slug') || '';
    window.bitoraTrack?.('blog_impression', { label: slug, location: 'article' });

    const nodes = [...document.querySelectorAll('[data-stage]')];
    const links = [...document.querySelectorAll('[data-stage-link]')];
    const depthEl = document.querySelector('[data-depth]');
    const bar = document.querySelector('[data-progress]') as HTMLElement | null;
    let maxDepth = 0;
    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          const stage = entry.target.getAttribute('data-stage');
          if (!links.some(link => link.getAttribute('data-stage-link') === stage)) return;
          links.forEach(link => {
            link.classList.toggle('is-active', link.getAttribute('data-stage-link') === stage);
          });
        });
      },
      { threshold: 0.4 }
    );
    nodes.forEach(node => observer.observe(node));

    const onScroll = () => {
      const el = root as HTMLElement;
      const top = el.getBoundingClientRect().top + window.scrollY;
      const total = el.offsetHeight - window.innerHeight * 0.6;
      const passed = Math.min(1, Math.max(0, (window.scrollY - top + window.innerHeight * 0.4) / Math.max(total, 1)));
      const pct = Math.round(passed * 100);
      if (bar) bar.style.transform = `scaleX(${passed})`;
      if (pct > maxDepth) maxDepth = pct;
      if (depthEl) depthEl.textContent = `Letto ${maxDepth}%`;
      if (maxDepth >= 90) window.bitoraTrack?.('blog_complete', { label: slug, value: maxDepth });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    const ring = document.querySelector('[data-signal-ring]') as HTMLElement | null;
    if (ring && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let p = 0;
      const tick = () => {
        p = Math.min(100, p + 1.6);
        ring.style.setProperty('--p', String(p));
        if (p < 100) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    } else ring?.style.setProperty('--p', '100');

    document.querySelector('[data-nfc-demo]')?.addEventListener('click', event => {
      const button = event.currentTarget as HTMLElement;
      button.classList.toggle('is-tapped');
      const label = button.querySelector('[data-nfc-label]');
      if (label)
        label.textContent = button.classList.contains('is-tapped') ? 'Scheda aperta' : 'Avvicina il telefono o clicca';
      window.bitoraTrack?.('blog_demo', { label: slug, custom: 'nfc-tap' });
    });

    const diagnostic = document.querySelector('[data-diagnostic]');
    diagnostic?.addEventListener('change', () => {
      const data = Object.fromEntries(new FormData(diagnostic as HTMLFormElement).entries());
      const output = document.querySelector('[data-diagnostic-output]') as HTMLInputElement | null;
      if (output) output.value = JSON.stringify(data);
      window.bitoraTrack?.('blog_diagnostic', { label: slug });
    });

    const leadForm = document.querySelector('[data-track-form="blog_lead"]');
    const leadTs = leadForm?.querySelector('[name="_ts"]') as HTMLInputElement | null;
    if (leadTs) leadTs.value = String(Date.now());
    leadForm?.addEventListener('submit', async event => {
      event.preventDefault();
      const form = event.currentTarget as HTMLFormElement;
      const status = form.querySelector('[data-lead-status]') as HTMLElement | null;
      const submit = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submit) submit.disabled = true;
      const response = await fetch(form.action, { method: 'POST', body: new FormData(form) }).catch(() => null);
      const json = response ? await response.json().catch(() => ({ ok: false })) : { ok: false };
      if (submit) submit.disabled = false;
      if (status) {
        status.hidden = false;
        status.classList.toggle('is-ok', Boolean(json.ok));
        status.textContent = json.ok ? 'Richiesta inviata. Ti ricontattiamo entro 24 ore.' : json.error || 'Invio non riuscito, riprova o scrivici su WhatsApp.';
      }
      if (json.ok) {
        form.reset();
        window.bitoraTrack?.('lead_form_submit', { label: slug, location: 'blog' });
      }
    });
  }
</script>

<style>
  .ar-preview {
    position: relative;
    z-index: 60;
    margin: 72px 0 0;
    padding: 0.6rem 1rem;
    text-align: center;
    font-size: 0.85rem;
    color: #451a03;
    background: #fcd34d;
  }
  .ar-progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 70;
    height: 2px;
    pointer-events: none;
  }
  .ar-progress span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--b-cyan-deep), var(--b-cyan));
    box-shadow: 0 0 12px var(--b-glow);
    transform: scaleX(0);
    transform-origin: left;
  }

  .ar-hero {
    position: relative;
    overflow: hidden;
    padding: calc(72px + clamp(2.5rem, 6vw, 4.5rem)) 0 clamp(2rem, 4vw, 3rem);
  }
  .ar-hero__grid {
    position: absolute;
    inset: 0;
    mask-image: radial-gradient(ellipse 70% 80% at 50% 0%, #000 30%, transparent 75%);
  }
  .ar-hero__orb {
    top: -22rem;
    left: 50%;
    transform: translateX(-50%);
  }
  .ar-hero__inner {
    position: relative;
    max-width: 920px;
    text-align: center;
  }
  .ar-crumbs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
    font-family: var(--f-mono);
    font-size: 0.78rem;
    color: var(--b-fg-3);
  }
  .ar-crumbs a {
    color: var(--b-fg-2);
    text-decoration: none;
  }
  .ar-crumbs a:hover {
    color: var(--b-cyan);
  }
  .ar-crumbs span:last-child {
    color: var(--b-cyan);
  }
  .ar-title {
    margin: 0 auto;
    font-size: clamp(2rem, 4.6vw, 3.6rem);
    text-wrap: balance;
  }
  .ar-lede {
    max-width: 720px;
    margin: 1.4rem auto 0;
    text-wrap: pretty;
  }
  .ar-byline {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 2rem;
    padding: 0.6rem 1.1rem 0.6rem 0.6rem;
    border-radius: 99px;
    border: 1px solid var(--b-line);
    background: rgba(255, 255, 255, 0.03);
    text-align: left;
  }
  .ar-byline img {
    width: 42px;
    height: 42px;
    padding: 9px 5px;
    object-fit: contain;
    border-radius: 50%;
    background: var(--b-ink-3);
    border: 1px solid var(--b-line-2);
  }
  .ar-byline p {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .ar-byline a {
    color: var(--b-fg);
    text-decoration: none;
  }
  .ar-byline a:hover {
    color: var(--b-cyan);
  }
  .ar-byline__meta {
    font-weight: 400 !important;
    font-size: 0.8rem !important;
    color: var(--b-fg-3);
  }

  .ar-cover {
    max-width: 1120px;
  }
  .ar-cover :global(.bc) {
    border-radius: var(--b-radius);
    border: 1px solid var(--b-line-2);
    box-shadow: 0 60px 120px -50px rgba(34, 211, 238, 0.25);
  }

  .ar-layout {
    display: grid;
    gap: 3rem;
    padding: clamp(3rem, 6vw, 5rem) 0 clamp(4rem, 8vw, 7rem);
  }
  @media (min-width: 1080px) {
    .ar-layout {
      grid-template-columns: 240px minmax(0, 720px);
      justify-content: center;
      gap: 4.5rem;
    }
  }
  .ar-rail {
    display: none;
  }
  @media (min-width: 1080px) {
    .ar-rail {
      display: block;
    }
  }
  .ar-rail__sticky {
    position: sticky;
    top: 110px;
  }
  .ar-toc {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
    border-left: 1px solid var(--b-line);
  }
  .ar-toc a {
    display: flex;
    gap: 0.7rem;
    padding: 0.45rem 0 0.45rem 1rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--b-fg-3);
    text-decoration: none;
    font-size: 0.9rem;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .ar-toc a span {
    font-family: var(--f-mono);
    font-size: 0.72rem;
    padding-top: 0.15rem;
  }
  .ar-toc a:hover,
  .ar-toc a.is-active {
    color: var(--b-fg);
  }
  .ar-toc a.is-active {
    border-left-color: var(--b-cyan);
  }
  .ar-toc a.is-active span {
    color: var(--b-cyan);
  }
  .ar-depth {
    margin: 1.2rem 0 0;
    font-family: var(--f-mono);
    font-size: 0.75rem;
    color: var(--b-fg-3);
  }
  .ar-rail__cta {
    margin-top: 2rem;
    padding: 1.2rem;
    border-radius: 16px;
    border: 1px solid var(--b-line);
    background: var(--b-ink-2);
  }
  .ar-rail__cta p {
    margin: 0 0 0.8rem;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .ar-body {
    min-width: 0;
    font-size: 1.075rem;
    line-height: 1.75;
    color: var(--b-fg-2);
  }
  .ar-body > :global(* + *) {
    margin-top: 1.4rem;
  }
  .ar-body :global(h2),
  .ar-body :global(h3) {
    color: var(--b-fg);
    font-family: var(--f-display);
    letter-spacing: -0.02em;
    line-height: 1.2;
    scroll-margin-top: 100px;
  }
  .ar-body > :global(h2) {
    margin-top: 3.2rem;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }
  .ar-body > :global(h3) {
    margin-top: 2.4rem;
    font-size: 1.3rem;
  }
  .ar-body :global(p) {
    margin-bottom: 0;
  }
  .ar-body :global(strong) {
    color: var(--b-fg);
  }
  .ar-body :global(p a),
  .ar-body :global(li a) {
    color: var(--b-cyan);
    text-decoration: underline;
    text-decoration-color: rgba(34, 211, 238, 0.4);
    text-underline-offset: 3px;
  }
  .ar-list {
    padding-left: 0;
    list-style: none;
    display: grid;
    gap: 0.7rem;
  }
  .ar-list > :global(li) {
    position: relative;
    padding-left: 1.6rem;
  }
  ul.ar-list > :global(li)::before {
    content: '';
    position: absolute;
    left: 0.2rem;
    top: 0.72em;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--b-cyan);
    box-shadow: 0 0 10px var(--b-glow);
  }
  ol.ar-list {
    counter-reset: ar;
  }
  ol.ar-list > :global(li) {
    counter-increment: ar;
    padding-left: 2.2rem;
  }
  ol.ar-list > :global(li)::before {
    content: counter(ar, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.15em;
    font-family: var(--f-mono);
    font-size: 0.8rem;
    color: var(--b-cyan);
  }

  .ar-signal {
    padding: clamp(1.5rem, 3vw, 2.2rem);
    border-radius: var(--b-radius);
    border: 1px solid rgba(34, 211, 238, 0.28);
    background:
      radial-gradient(ellipse 80% 120% at 100% 0%, rgba(34, 211, 238, 0.12), transparent 60%),
      var(--b-ink-2);
  }
  .ar-signal__top {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .ar-signal__top .b-eyebrow {
    margin: 0;
  }
  .ar-signal .ar-signal__h {
    margin: 0 0 0.75rem;
    font-size: clamp(1.3rem, 2.4vw, 1.75rem);
  }
  .ar-ring {
    --p: 0;
    display: grid;
    place-items: center;
    width: 3.4rem;
