---
import { pillars, whatsappLink, phoneDisplay, phoneHref, email } from '../data/services';

const year = new Date().getFullYear();
const path = (Astro.url.pathname.replace(/\/$/, '') || '/') as string;
const hideCta = path === '/contattaci' || path === '/richiedi-demo' || path.startsWith('/ops');

const topicByPath: Record<string, string> = {
  '/siti-web-professionali': 'sito',
  '/e-commerce': 'ecommerce',
  '/nfc-ecosystem': 'nfc',
  '/sistemi-aziendali': 'sistemi',
  '/app-mobile': 'app',
  '/intelligenza-artificiale': 'ai',
};
const topic = topicByPath[path];
const ctaHref = topic ? `/contattaci/?topic=${topic}` : '/contattaci/';
---

{
  !hideCta && (
    <section class="fcta" aria-labelledby="fcta-title">
      <div class="b-glow-orb fcta__orb" aria-hidden="true" />
      <div class="b-shell fcta__inner" data-reveal>
        <p class="b-eyebrow">Prossimo passo</p>
        <h2 id="fcta-title" class="b-display">
          Hai un’idea?
          <br />
          <span class="b-grad">Rendiamola reale.</span>
        </h2>
        <p class="b-lede">
          Raccontaci in due minuti cosa ti serve. Entro 24 ore ricevi una risposta concreta: cosa fare,
          in che ordine, quanto costa. Gratis e senza impegno.
        </p>
        <div class="b-cta-row">
          <a href={ctaHref} class="b-btn b-btn--primary b-btn--lg" data-track="cta_click" data-track-location="footer_cta">
            Richiedi il preventivo gratuito <span class="b-arrow" aria-hidden="true">→</span>
          </a>
          <a
            href={whatsappLink('Ciao Bitora, vorrei parlarvi di un progetto.')}
            class="b-btn b-btn--wa b-btn--lg"
            data-track="whatsapp_click"
            data-track-location="footer_cta"
            target="_blank"
            rel="noopener"
          >
            Scrivici su WhatsApp
          </a>
        </div>
        <ul class="fcta__proof">
          <li>Risposta entro 24 ore</li>
          <li>Preventivo chiaro, a fasi</li>
          <li>Un unico referente</li>
        </ul>
      </div>
    </section>
  )
}

<footer class="ftr">
  <div class="b-shell">
    <div class="ftr__grid">
      <div class="ftr__brand">
        <a href="/" class="ftr__logo" aria-label="Bitora — home">
          <img src="/bitora-mark.png" alt="" width="70" height="32" loading="lazy" />
          <span>BITORA</span>
        </a>
        <p class="b-small">
          Studio digitale a Carmagnola (TO). Siti, e-commerce, gestionali, app e AI per aziende del
          Piemonte e di tutta Italia.
        </p>
        <div class="ftr__contacts">
          <a href={`mailto:${email}`}>{email}</a>
          <a href={phoneHref} data-track="phone_click" data-track-location="footer">{phoneDisplay}</a>
          <a
            href={whatsappLink('Ciao Bitora, vorrei informazioni.')}
            data-track="whatsapp_click"
            data-track-location="footer"
            target="_blank"
            rel="noopener">WhatsApp</a
          >
        </div>
      </div>

      <nav aria-label="Soluzioni">
        <h3>Soluzioni</h3>
        <ul>
          {
            pillars.map(p => (
              <li>
                <a href={p.href}>{p.title}</a>
              </li>
            ))
          }
          <li><a href="https://shopnfc.bitora.it/" rel="noopener">Shop NFC</a></li>
        </ul>
      </nav>

      <nav aria-label="Piattaforme">
        <h3>Piattaforme</h3>
        <ul>
          <li><a href="/gestione-interventi/">Gestione interventi</a></li>
          <li><a href="/rapportini/">Rapportini digitali</a></li>
          <li><a href="/ticketing/">Ticketing</a></li>
          <li><a href="/bitora-crm/">Bitora CRM</a></li>
          <li><a href="/richiedi-demo/">Richiedi demo</a></li>
          <li><a href="/tools/calcolatore-roi-gestionale/">Calcolatore ROI</a></li>
          <li><a href="/tools/">Generatore QR</a></li>
        </ul>
      </nav>

      <nav aria-label="Bitora">
        <h3>Bitora</h3>
        <ul>
          <li><a href="/lavori/">Lavori</a></li>
          <li><a href="/servizi/">Servizi e metodo</a></li>
          <li><a href="/chi-siamo/">Chi siamo</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/contattaci/">Contatti</a></li>
          <li><a href="https://www.instagram.com/bitorait/" target="_blank" rel="noopener noreferrer">Instagram</a></li>
          <li><a href="https://www.facebook.com/people/Bitora-Italia/" target="_blank" rel="noopener noreferrer">Facebook</a></li>
        </ul>
      </nav>
    </div>

    <p class="ftr__wordmark" aria-hidden="true">BITORA</p>

    <div class="ftr__bottom">
      <p>© {year} Bitora di Denis Cazzulo · P.IVA 13359170019 · Carmagnola (TO)</p>
      <div>
        <a href="/privacy-policy/">Privacy</a>
        <a href="/cookie-policy/">Cookie</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .fcta {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--b-line);
    padding-block: clamp(5rem, 12vw, 9rem);
    background:
      radial-gradient(ellipse 60% 80% at 85% 100%, rgba(34, 211, 238, 0.1), transparent 60%),
      var(--b-ink);
  }
  .fcta__orb {
    right: -12rem;
    top: -10rem;
  }
  .fcta__inner {
    position: relative;
  }
  .fcta__proof {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin: 2.25rem 0 0;
    padding: 0;
    color: var(--b-fg-3);
    font-size: 0.9rem;
  }
  .fcta__proof li::before {
    content: '✓';
    color: var(--b-cyan);
    margin-right: 0.5rem;
  }

  .ftr {
    border-top: 1px solid var(--b-line);
    background: var(--b-ink);
    padding: clamp(3.5rem, 7vw, 5rem) 0 calc(1.5rem + 64px);
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .ftr {
      padding-bottom: 1.5rem;
    }
  }
  .ftr__grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 768px) {
    .ftr__grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }
  }
  .ftr__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    color: var(--b-fg);
    text-decoration: none;
  }
  .ftr__logo img {
    height: 32px;
    width: auto;
  }
  .ftr__logo span {
    font-family: var(--f-display);
    font-weight: 600;
    letter-spacing: 0.32em;
  }
  .ftr__brand .b-small {
    max-width: 22rem;
  }
  .ftr__contacts {
    display: grid;
    gap: 0.45rem;
    margin-top: 1.5rem;
  }
  .ftr__contacts a,
  .ftr ul a,
  .ftr__bottom a {
    color: var(--b-fg-2);
    text-decoration: none;
    font-size: 0.92rem;
    transition: color 0.2s;
  }
  .ftr__contacts a:hover,
  .ftr ul a:hover,
  .ftr__bottom a:hover {
    color: var(--b-cyan);
    opacity: 1;
  }
  .ftr h3 {
    font-family: var(--f-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--b-fg-3);
    margin: 0 0 1.1rem;
  }
  .ftr ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .ftr__wordmark {
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(4rem, 19vw, 17rem);
    line-height: 0.8;
    letter-spacing: -0.02em;
    text-align: center;
    color: transparent;
    background: linear-gradient(180deg, rgba(34, 211, 238, 0.16) 0%, rgba(255, 255, 255, 0.04) 55%, transparent 95%);
    -webkit-background-clip: text;
    background-clip: text;
    user-select: none;
  }
  .ftr__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--b-line);
    font-size: 0.85rem;
    color: var(--b-fg-3);
  }
  .ftr__bottom p {
    margin: 0;
  }
  .ftr__bottom div {
    display: flex;
    gap: 1.25rem;
  }
</style>
