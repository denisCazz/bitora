---
import { showcaseShots } from '../../data/work';

export interface Props {
  reverse?: boolean;
  speed?: number;
}
const { reverse = false, speed = 70 } = Astro.props;
const shots = reverse ? [...showcaseShots].reverse() : showcaseShots;
---

<div class="b-marquee sm" style={`--b-marquee-speed:${speed}s`} aria-label="Alcuni siti realizzati da Bitora">
  {
    [0, 1].map(copy => (
      <div class:list={['b-marquee__track', { 'sm--rev': reverse }]} aria-hidden={copy === 1 ? 'true' : undefined}>
        {shots.map(s => (
          <figure class="sm__item">
            <div class="b-browser">
              <div class="b-browser__bar">
                <i />
                <i />
                <i />
              </div>
              <img src={s.src} alt={copy === 0 ? `Sito ${s.name}` : ''} width="1200" height="750" loading="lazy" decoding="async" />
            </div>
            <figcaption>{s.name}</figcaption>
          </figure>
        ))}
      </div>
    ))
  }
</div>

<style>
  .sm__item {
    width: clamp(260px, 30vw, 420px);
    margin: 0;
  }
  .sm__item figcaption {
    margin-top: 0.7rem;
    font-size: 0.82rem;
    color: var(--b-fg-3);
  }
  .sm--rev {
    animation-direction: reverse;
  }
</style>
