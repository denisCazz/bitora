---
import { whatsappLink } from '../data/services';

const path = (Astro.url.pathname.replace(/\/$/, '') || '/') as string;
const hidden = path.startsWith('/ops') || path === '/contattaci' || path === '/richiedi-demo';
---

{
  !hidden && (
    <div class="stk" role="navigation" aria-label="Contatti rapidi">
      <a
        href={whatsappLink('Ciao Bitora, ho visitato il sito e vorrei informazioni.')}
        class="stk__wa"
        data-track="whatsapp_click"
        data-track-location="sticky_bar"
        target="_blank"
        rel="noopener"
      >
        WhatsApp
      </a>
      <a href="/contattaci/" class="stk__cta" data-track="cta_click" data-track-location="sticky_bar">
        Preventivo gratuito →
      </a>
    </div>
  )
}

<style>
  .stk {
    position: fixed;
    inset: auto 0.75rem calc(0.75rem + env(safe-area-inset-bottom)) 0.75rem;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 0.4rem;
    padding: 0.4rem;
    border-radius: 999px;
    background: rgba(10, 12, 15, 0.85);
    border: 1px solid var(--b-line-2);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 20px 50px -20px rgba(0, 0, 0, 0.9);
  }
  @media (min-width: 768px) {
    .stk {
      display: none;
    }
  }
  .stk a {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 0.5rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }
  .stk__wa {
    color: #d9fbe6;
    background: rgba(37, 211, 102, 0.14);
  }
  .stk__cta {
    color: #001318;
    background: var(--b-cyan);
  }
</style>
