---
const navItems = [
  { name: 'Home', url: '/' },
  {
    name: 'Ecosistema',
    url: '/gestione-interventi/',
    children: [
      { name: 'Panoramica ecosistema', url: '/gestione-interventi/' },
      { name: 'Rapportini digitali', url: '/rapportini/' },
      { name: 'Ticketing e pratiche', url: '/ticketing/' },
      { name: 'Sistemi aziendali su misura', url: '/sistemi-aziendali/' },
    ],
  },
  { name: 'Siti web', url: '/siti-web-professionali/' },
  { name: 'E-commerce', url: '/e-commerce/' },
  { name: 'Servizi', url: '/servizi/' },
  { name: 'Lavori', url: '/lavori/' },
  { name: 'Contatti', url: '/contattaci/' },
];

const currentPath = Astro.url.pathname;
const normalizedPath = (currentPath.replace(/\/$/, '') || '/') as string;

const webTopicByPath: Record<string, string> = {
  '/siti-web-professionali': 'sito',
  '/e-commerce': 'ecommerce',
  '/nfc-ecosystem': 'nfc',
};

const informativePrefixes = ['/lavori', '/chi-siamo', '/blog', '/privacy-policy', '/cookie-policy'];

function resolveHeaderCta(path: string) {
  if (path === '/') {
    return { href: '/contattaci/?topic=sito', label: 'Richiedi preventivo' };
  }
  const topic = webTopicByPath[path];
  if (topic) {
    return {
      href: `/contattaci/?topic=${topic}`,
      label: topic === 'ecommerce' ? 'Preventivo e-commerce' : 'Richiedi preventivo',
    };
  }
  if (path === '/servizi') {
    return { href: '/contattaci/', label: 'Richiedi preventivo' };
  }
  if (informativePrefixes.some(p => path === p || path.startsWith(p + '/'))) {
    return { href: '/contattaci/', label: 'Contattaci' };
  }
  return { href: '/richiedi-demo/', label: 'Richiedi demo' };
}

const headerCta = resolveHeaderCta(normalizedPath);

function isActive(url: string) {
  if (url === '/') return normalizedPath === '/';
  const clean = url.replace(/\/$/, '');
  return normalizedPath === clean || normalizedPath.startsWith(clean + '/');
}

function isGroupActive(item: (typeof navItems)[number]) {
  return isActive(item.url) || (item.children ?? []).some(c => isActive(c.url));
}
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50">
  <div class="flex items-center justify-between px-6 md:px-10 lg:px-16 xl:px-24 py-4 gap-4">
    <a href="/" class="flex-shrink-0 z-10 flex items-center gap-3" aria-label="Bitora home">
      <img src="/bitora.png" alt="Bitora" class="h-10 w-10 rounded-full object-cover" />
      <span class="text-sm font-semibold text-white/75 hidden lg:block tracking-tight"
        >bitora<span class="text-white/55">.it</span></span
      >
    </a>

    <nav
      class="hidden md:flex items-center gap-0.5 flex-wrap justify-end"
      aria-label="Navigazione principale"
    >
      {
        navItems
          .filter(i => i.name !== 'Contatti')
          .map(item =>
            item.children ? (
              <div class="nav-group relative">
                <a
                  href={item.url}
                  class={
                    isGroupActive(item)
                      ? 'nav-group-trigger px-2.5 lg:px-3.5 py-2 rounded-lg text-[13px] lg:text-sm font-medium transition-all duration-200 text-white bg-white/[0.09] inline-flex items-center gap-1'
                      : 'nav-group-trigger px-2.5 lg:px-3.5 py-2 rounded-lg text-[13px] lg:text-sm font-medium transition-all duration-200 text-white/70 hover:text-white hover:bg-white/[0.06] inline-flex items-center gap-1'
                  }
                  aria-haspopup="true"
                >
                  {item.name}
                  <svg
                    class="w-3 h-3 opacity-60"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </a>
                <div class="nav-group-panel absolute right-0 top-full pt-2 w-64" role="none">
                  <div class="rounded-xl bg-[#0c0c0e]/95 backdrop-blur-xl border border-white/10 shadow-2xl p-2">
                    {item.children.map(child => (
                      <a
                        href={child.url}
                        class={
                          isActive(child.url)
                            ? 'block px-3.5 py-2.5 rounded-lg text-[13px] font-medium text-white bg-white/[0.09]'
                            : 'block px-3.5 py-2.5 rounded-lg text-[13px] font-medium text-white/70 hover:text-white hover:bg-white/[0.06] transition-colors'
                        }
                      >
                        {child.name}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={item.url}
                class={
                  isActive(item.url)
                    ? 'px-2.5 lg:px-3.5 py-2 rounded-lg text-[13px] lg:text-sm font-medium transition-all duration-200 text-white bg-white/[0.09]'
                    : 'px-2.5 lg:px-3.5 py-2 rounded-lg text-[13px] lg:text-sm font-medium transition-all duration-200 text-white/70 hover:text-white hover:bg-white/[0.06]'
                }
              >
                {item.name}
              </a>
            )
          )
      }
    </nav>

    <div class="flex items-center gap-3 shrink-0">
      <a
        href={headerCta.href}
        class="sl-cta-btn hidden md:inline-flex"
        data-track="cta_click"
        data-track-location="header">{headerCta.label}</a
      >
      <button
        id="mob-toggle"
        class="md:hidden text-white p-2 rounded-lg transition-colors hover:bg-white/10"
        aria-label="Menu"
        aria-expanded="false"
      >
        <svg
          id="mob-icon-open"
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="mob-icon-close"
          class="w-5 h-5 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mob-menu"
    class="hidden md:hidden bg-black/95 backdrop-blur-xl border-t border-white/10 px-8 py-5"
  >
    <nav class="flex flex-col gap-0.5" aria-label="Navigazione mobile">
      {
        navItems.map(item => (
          <>
            <a
              href={item.url}
              class={
                isActive(item.url)
                  ? 'py-3 px-3 text-sm font-medium rounded-lg transition-colors text-white bg-white/[0.08]'
                  : 'py-3 px-3 text-sm font-medium rounded-lg transition-colors text-white/70 hover:text-white hover:bg-white/[0.05]'
              }
            >
              {item.name}
            </a>
            {item.children && (
              <div class="pl-6 flex flex-col gap-0.5">
                {item.children
                  .filter(c => c.url !== item.url)
                  .map(child => (
                    <a
                      href={child.url}
                      class={
                        isActive(child.url)
                          ? 'py-2 px-3 text-[13px] font-medium rounded-lg text-white bg-white/[0.08]'
                          : 'py-2 px-3 text-[13px] font-medium rounded-lg text-white/60 hover:text-white hover:bg-white/[0.05] transition-colors'
                      }
                    >
                      {child.name}
                    </a>
                  ))}
              </div>
            )}
          </>
        ))
      }
      <a
        href={headerCta.href}
        class="py-3 px-3 text-sm font-semibold rounded-lg text-white bg-white/10 mt-2"
        >{headerCta.label}</a
      >
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const mobToggle = document.getElementById('mob-toggle');
  const mobMenu = document.getElementById('mob-menu');
  const mobIconOpen = document.getElementById('mob-icon-open');
  const mobIconClose = document.getElementById('mob-icon-close');

  let ticking = false;
  function onScroll() {
    if (!ticking) {
      requestAnimationFrame(() => {
        if (window.scrollY > 60) {
          header?.classList.add('scrolled');
        } else {
          header?.classList.remove('scrolled');
        }
        ticking = false;
      });
      ticking = true;
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  mobToggle?.addEventListener('click', () => {
    const isOpen = !mobMenu?.classList.contains('hidden');
    if (isOpen) {
      mobMenu?.classList.add('hidden');
      mobIconOpen?.classList.remove('hidden');
      mobIconClose?.classList.add('hidden');
      mobToggle.setAttribute('aria-expanded', 'false');
    } else {
      mobMenu?.classList.remove('hidden');
      mobIconOpen?.classList.add('hidden');
      mobIconClose?.classList.remove('hidden');
      mobToggle.setAttribute('aria-expanded', 'true');
    }
  });
</script>

<style>
  #site-header {
    transition:
      background 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }
  #site-header.scrolled {
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    box-shadow: 0 4px 32px rgba(0, 0, 0, 0.35);
  }

  .nav-group-panel {
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      visibility 0.18s;
  }
  .nav-group:hover .nav-group-panel,
  .nav-group:focus-within .nav-group-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .sl-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.11);
    color: #fff;
    font-weight: 600;
    font-size: 0.875rem;
    padding: 0.5rem 1.25rem;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition:
      background 0.2s,
      border-color 0.2s;
    white-space: nowrap;
  }
  .sl-cta-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.32);
  }
</style>
