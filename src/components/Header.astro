---
import { pillars, whatsappLink } from '../data/services';

const path = (Astro.url.pathname.replace(/\/$/, '') || '/') as string;

const navLinks = [
  { name: 'Lavori', url: '/lavori/' },
  { name: 'Metodo', url: '/servizi/#metodo' },
  { name: 'Chi siamo', url: '/chi-siamo/' },
  { name: 'Blog', url: '/blog/' },
];

const platformLinks = [
  { name: 'Gestione interventi', url: '/gestione-interventi/' },
  { name: 'Rapportini digitali', url: '/rapportini/' },
  { name: 'Ticketing', url: '/ticketing/' },
  { name: 'Bitora CRM', url: '/bitora-crm/' },
];

const topicByPath: Record<string, string> = {
  '/siti-web-professionali': 'sito',
  '/e-commerce': 'ecommerce',
  '/nfc-ecosystem': 'nfc',
  '/sistemi-aziendali': 'sistemi',
  '/app-mobile': 'app',
  '/intelligenza-artificiale': 'ai',
  '/gestione-interventi': 'interventi',
  '/rapportini': 'interventi',
  '/ticketing': 'interventi',
  '/bitora-crm': 'crm',
};
const topic = topicByPath[path];
const ctaHref = topic ? `/contattaci/?topic=${topic}` : '/contattaci/';

function isActive(url: string) {
  const clean = url.replace(/\/$/, '').split('#')[0];
  if (!clean) return false;
  return path === clean || path.startsWith(clean + '/');
}

const solutionsActive =
  pillars.some(p => isActive(p.href)) ||
  platformLinks.some(l => isActive(l.url)) ||
  path === '/servizi';
---

<header id="site-header" class="hdr">
  <div class="hdr__inner b-shell">
    <a href="/" class="hdr__logo" aria-label="Bitora — home">
      <img src="/bitora-mark.png" alt="" width="61" height="28" />
      <span>BITORA</span>
    </a>

    <nav class="hdr__nav" aria-label="Navigazione principale">
      <div class="hdr__group">
        <a href="/servizi/" class:list={['hdr__link', { 'is-active': solutionsActive }]} aria-haspopup="true">
          Soluzioni
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
            ><path d="M6 9l6 6 6-6"></path></svg
          >
        </a>
        <div class="hdr__mega" role="none">
          <div class="hdr__mega-inner">
            <div class="hdr__mega-grid">
              {
                pillars.map(p => (
                  <a href={p.href} class:list={['hdr__item', { 'is-active': isActive(p.href) }]}>
                    <span class="b-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d={p.icon} />
                      </svg>
                    </span>
                    <span>
                      <strong>{p.title}</strong>
                      <small>{p.kicker}</small>
                    </span>
                  </a>
                ))
              }
            </div>
            <aside class="hdr__mega-side">
              <p class="b-eyebrow">Piattaforme pronte</p>
              <ul>
                {
                  platformLinks.map(l => (
                    <li>
                      <a href={l.url}>{l.name}</a>
                    </li>
                  ))
                }
                <li>
                  <a href="https://shopnfc.bitora.it/" rel="noopener" data-track="cta_click" data-track-location="header_mega_shopnfc"
                    >Shop NFC <em>Nuovo</em></a
                  >
                </li>
              </ul>
              <a href="/richiedi-demo/" class="b-btn b-btn--ghost b-btn--sm">Prenota una demo</a>
            </aside>
          </div>
        </div>
      </div>
      {
        navLinks.map(l => (
          <a href={l.url} class:list={['hdr__link', { 'is-active': isActive(l.url) }]}>
            {l.name}
          </a>
        ))
      }
    </nav>

    <div class="hdr__actions">
      <a
        href={whatsappLink('Ciao Bitora, vorrei informazioni per un progetto.')}
        class="hdr__wa"
        aria-label="Scrivici su WhatsApp"
        data-track="whatsapp_click"
        data-track-location="header"
        target="_blank"
        rel="noopener"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path
            d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2-.2-.3 0-.5.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3zM12 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4c-1-1.6-1.5-3.4-1.5-5.3 0-5.4 4.4-9.9 9.9-9.9 2.6 0 5.1 1 7 2.9 1.9 1.9 2.9 4.4 2.9 7 0 5.5-4.4 9.9-10 9.9zm8.4-18.3C18.2 1.2 15.2 0 12 0 5.5 0 .2 5.3.2 11.9c0 2.1.5 4.1 1.6 5.9L0 24l6.3-1.7c1.7.9 3.7 1.4 5.7 1.4 6.6 0 11.9-5.3 11.9-11.9 0-3.2-1.2-6.2-3.5-8.4z"
          ></path></svg
        >
      </a>
      <a href={ctaHref} class="b-btn b-btn--primary b-btn--sm hdr__cta" data-track="cta_click" data-track-location="header">
        Preventivo gratuito
      </a>
      <button id="mob-toggle" class="hdr__burger" aria-label="Apri menu" aria-expanded="false" aria-controls="mob-menu">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div id="mob-menu" class="mob" hidden>
    <div class="b-shell mob__inner">
      <p class="b-eyebrow">Soluzioni</p>
      <div class="mob__grid">
        {
          pillars.map(p => (
            <a href={p.href} class="mob__item">
              <span class="b-mono">{p.n}</span>
              {p.title}
            </a>
          ))
        }
      </div>
      <div class="mob__links">
        {navLinks.map(l => <a href={l.url}>{l.name}</a>)}
        <a href="/gestione-interventi/">Piattaforme</a>
        <a href="/contattaci/">Contatti</a>
      </div>
      <div class="mob__cta">
        <a href={ctaHref} class="b-btn b-btn--primary b-btn--lg" data-track="cta_click" data-track-location="header_mobile"
          >Preventivo gratuito <span class="b-arrow" aria-hidden="true">→</span></a
        >
        <a href="tel:+393514979670" class="b-btn b-btn--ghost b-btn--lg" data-track="phone_click" data-track-location="header_mobile"
          >Chiama +39 351 497 9670</a
        >
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('mob-toggle');
  const menu = document.getElementById('mob-menu');

  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      header?.classList.toggle('is-scrolled', window.scrollY > 24);
      ticking = false;
    });
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Apri menu' : 'Chiudi menu');
    header?.classList.toggle('is-open', !open);
    if (menu) menu.hidden = open;
    document.documentElement.style.overflow = open ? '' : 'hidden';
  });
</script>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 60;
    transition:
      background 0.35s ease,
      border-color 0.35s ease,
      backdrop-filter 0.35s ease;
    border-bottom: 1px solid transparent;
  }
  .hdr.is-scrolled,
  .hdr.is-open {
    background: rgba(5, 6, 7, 0.78);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    border-bottom-color: var(--b-line);
  }
  .hdr__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 72px;
  }
  .hdr__logo {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--b-fg);
  }
  .hdr__logo:hover {
    opacity: 1;
  }
  .hdr__logo img {
    height: 28px;
    width: auto;
  }
  .hdr__logo span {
    font-family: var(--f-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.32em;
  }

  .hdr__nav {
    display: none;
    align-items: center;
    gap: 0.25rem;
  }
  @media (min-width: 1024px) {
    .hdr__nav {
      display: flex;
    }
  }
  .hdr__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--b-fg-2);
    text-decoration: none;
    transition:
      color 0.2s,
      background 0.2s;
  }
  .hdr__link svg {
    width: 14px;
    height: 14px;
    opacity: 0.6;
    transition: transform 0.25s var(--b-ease);
  }
  .hdr__link:hover,
  .hdr__link.is-active {
    opacity: 1;
    color: var(--b-fg);
    background: rgba(255, 255, 255, 0.06);
  }

  .hdr__group {
    position: relative;
  }
  .hdr__group:hover .hdr__link svg,
  .hdr__group:focus-within .hdr__link svg {
    transform: rotate(180deg);
  }
  .hdr__mega {
    position: absolute;
    top: 100%;
    left: -1rem;
    padding-top: 0.75rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity 0.2s ease,
      transform 0.25s var(--b-ease),
      visibility 0.2s;
  }
  .hdr__group:hover .hdr__mega,
  .hdr__group:focus-within .hdr__mega {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .hdr__mega-inner {
    display: grid;
    grid-template-columns: 1fr 220px;
    width: 760px;
    background: rgba(12, 15, 19, 0.97);
    border: 1px solid var(--b-line-2);
    border-radius: 22px;
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.85);
    overflow: hidden;
  }
  .hdr__mega-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem;
    padding: 0.75rem;
  }
  .hdr__item {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding: 0.85rem;
    border-radius: 14px;
    text-decoration: none;
    color: var(--b-fg);
    transition: background 0.2s;
  }
  .hdr__item:hover,
  .hdr__item.is-active {
    opacity: 1;
    background: rgba(255, 255, 255, 0.05);
  }
  .hdr__item strong {
    display: block;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .hdr__item small {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.8rem;
    color: var(--b-fg-3);
  }
  .hdr__mega-side {
    padding: 1.4rem 1.25rem;
    background: rgba(34, 211, 238, 0.04);
    border-left: 1px solid var(--b-line);
  }
  .hdr__mega-side .b-eyebrow {
    margin-bottom: 1rem;
  }
  .hdr__mega-side ul {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .hdr__mega-side a:not(.b-btn) {
    font-size: 0.88rem;
    color: var(--b-fg-2);
    text-decoration: none;
  }
  .hdr__mega-side a:not(.b-btn):hover {
    color: var(--b-fg);
    opacity: 1;
  }
  .hdr__mega-side em {
    font-style: normal;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #001318;
    background: var(--b-cyan);
    border-radius: 999px;
    padding: 0.1rem 0.4rem;
    margin-left: 0.3rem;
  }

  .hdr__actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .hdr__wa {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--b-line-2);
    color: var(--b-fg-2);
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .hdr__wa svg {
    width: 18px;
    height: 18px;
  }
  .hdr__wa:hover {
    opacity: 1;
    color: var(--b-wa);
    border-color: rgba(37, 211, 102, 0.5);
  }
  .hdr__cta {
    display: none;
  }
  @media (min-width: 640px) {
    .hdr__wa,
    .hdr__cta {
      display: inline-flex;
    }
  }

  .hdr__burger {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 42px;
    height: 42px;
    padding: 0 11px;
    border-radius: 999px;
    border: 1px solid var(--b-line-2);
    background: transparent;
    cursor: pointer;
  }
  .hdr__burger span {
    display: block;
    height: 1.5px;
    background: var(--b-fg);
    transition: transform 0.3s var(--b-ease);
  }
  .hdr.is-open .hdr__burger span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }
  .hdr.is-open .hdr__burger span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }
  @media (min-width: 1024px) {
    .hdr__burger {
      display: none;
    }
  }

  .mob {
    height: calc(100dvh - 72px);
    overflow-y: auto;
    border-top: 1px solid var(--b-line);
  }
  .mob__inner {
    padding: 2rem 0 3rem;
  }
  .mob__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }
  .mob__item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
    border-radius: 16px;
    border: 1px solid var(--b-line);
    background: rgba(255, 255, 255, 0.025);
    font-weight: 600;
    color: var(--b-fg);
    text-decoration: none;
  }
  .mob__item .b-mono {
    font-size: 0.72rem;
    color: var(--b-cyan);
  }
  .mob__links {
    display: grid;
    margin-top: 1.75rem;
    border-top: 1px solid var(--b-line);
  }
  .mob__links a {
    padding: 1rem 0;
    border-bottom: 1px solid var(--b-line);
    font-family: var(--f-display);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--b-fg);
    text-decoration: none;
  }
  .mob__cta {
    display: grid;
    gap: 0.6rem;
    margin-top: 2rem;
  }
</style>
