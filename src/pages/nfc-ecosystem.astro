---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import VideoHero from '../components/VideoHero.astro';
import MediaShowcase from '../components/MediaShowcase.astro';
import FAQ from '../components/FAQ.astro';
import ServiceSchema from '../components/schema/Service.astro';
import FAQPageSchema from '../components/schema/FAQPage.astro';
import HowToSchema from '../components/schema/HowTo.astro';
import BreadcrumbListSchema from '../components/schema/BreadcrumbList.astro';
import AnswerFirst from '../components/AnswerFirst.astro';
import ServiceRelatedLinks from '../components/ServiceRelatedLinks.astro';
---

<Layout
  title="Shop NFC e Tessere NFC | Recensioni Google, Menu e Biglietti Smart | Bitora"
  description="Acquista tessere, espositori e tag NFC su Shop NFC Bitora: recensioni Google con un tap, contatti e menu digitali per bar, ristoranti e professionisti. Programmazione inclusa."
  image="/editorial/nfc-restaurant.png"
>
  <main class="bg-white dark:bg-black text-gray-900 dark:text-white overflow-x-hidden">
    <VideoHero
      eyebrow="Shop NFC Bitora"
      title="Biglietti e tessere NFC"
      highlight="smart (1 tap)."
      description="Recensioni Google, contatti, menu digitale e link utili. Ordina online su Shop NFC Bitora o richiedi una fornitura su misura con programmazione inclusa."
      primaryCta={{ label: 'Vai a Shop NFC Bitora →', href: 'https://shopnfc.bitora.it/' }}
      secondaryCta={{ label: 'Preventivo su misura', href: '/contattaci/?topic=nfc' }}
      posterSrc="/editorial/nfc-restaurant.png"
      videoLabel="Tessera NFC in uso"
      images={[
        { src: '/chanty.JPG', alt: 'Bar Chantilly Carmagnola' },
        { src: '/mistral.jpg', alt: 'Mistral Impianti' },
        { src: '/ilportico.png', alt: 'Il Portico' },
      ]}
    />

    <AnswerFirst
      question="Come funzionano le tessere NFC per ristoranti e attività locali?"
      answer="Una tessera NFC programmata apre con un tap dello smartphone una pagina personalizzata: recensioni Google, menu digitale, WhatsApp o contatti. Bitora programma il chip, include gli aggiornamenti previsti nella proposta e nessun abbonamento mensile. Ideale per bar, ristoranti e professionisti in Piemonte."
    />

    <section
      id="come-funziona"
      class="py-20 md:py-24 px-6 md:px-12 lg:px-20 border-b border-gray-200 dark:border-white/5"
    >
      <div class="max-w-6xl mx-auto grid lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-5">
          <p class="text-sm font-semibold tracking-widest uppercase text-slate-500 dark:text-slate-400 mb-3">
            Come funziona
          </p>
          <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-slate-950 dark:text-white">
            Cos’è una tessera NFC?
          </h2>
          <p class="mt-4 text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
            È una tessera con chip NFC programmato. Con un tap lo smartphone apre una pagina:
            recensioni Google, WhatsApp, menu digitale, sito o contatti.
          </p>

          <dl class="mt-8 space-y-4">
            <div class="rounded-2xl border border-gray-200 dark:border-white/10 bg-white/70 dark:bg-white/[0.03] glass-panel p-5">
              <dt class="font-bold text-slate-950 dark:text-white">Programmazione inclusa</dt>
              <dd class="mt-1 text-sm text-slate-600 dark:text-slate-300">
                Impostiamo link, contatti e destinazione. Tu devi solo usarla.
              </dd>
            </div>
            <div class="rounded-2xl border border-gray-200 dark:border-white/10 bg-white/70 dark:bg-white/[0.03] glass-panel p-5">
              <dt class="font-bold text-slate-950 dark:text-white">Nessun abbonamento</dt>
              <dd class="mt-1 text-sm text-slate-600 dark:text-slate-300">
                Aggiornamenti gratuiti: cambi link quando vuoi, senza canone.
              </dd>
            </div>
            <div class="rounded-2xl border border-gray-200 dark:border-white/10 bg-white/70 dark:bg-white/[0.03] glass-panel p-5">
              <dt class="font-bold text-slate-950 dark:text-white">Pellicola intercambiabile</dt>
              <dd class="mt-1 text-sm text-slate-600 dark:text-slate-300">
                Cambi grafica senza cambiare tessera.
              </dd>
            </div>
          </dl>
        </div>

        <div class="lg:col-span-7">
          <MediaShowcase
            items={[
              {
                src: '/editorial/nfc-restaurant.png',
                alt: 'Cliente avvicina lo smartphone a una tessera NFC',
                caption: 'Un tap: niente app, niente ricerca manuale.',
              },
              {
                src: '/shop-nfc-products.jpg',
                alt: 'Tessere, tag, braccialetto e lettore NFC',
                caption: 'Formati diversi, programmati per il tuo utilizzo.',
              },
              {
                src: '/nfc.png',
                alt: 'Tessera NFC Bitora',
                caption: 'Design pulito + QR di backup.',
              },
            ]}
          />
        </div>
      </div>
    </section>

    <section class="py-16 px-6 md:px-12 lg:px-20 border-b border-gray-200 dark:border-white/5">
      <div class="max-w-6xl mx-auto rounded-3xl border border-cyan-500/30 bg-cyan-500/[0.06] p-8 md:p-12 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8">
        <div class="max-w-2xl">
          <p class="text-xs font-semibold tracking-widest uppercase text-cyan-400 mb-2">
            Catalogo online · shopnfc.bitora.it
          </p>
          <h2 class="text-2xl md:text-4xl font-extrabold tracking-tight text-slate-950 dark:text-white">
            Acquista direttamente su Shop NFC Bitora
          </h2>
          <p class="mt-3 text-base md:text-lg text-slate-600 dark:text-slate-300">
            Tessere per recensioni Google, espositori da banco, adesivi NTAG213/215/216,
            braccialetti e lettori NFC. Disponibili da 10 a 100.000 pezzi con spedizione rapida in
            tutta Italia.
          </p>
        </div>
        <div class="flex flex-wrap gap-4 shrink-0">
          <a
            href="https://shopnfc.bitora.it/"
            rel="noopener"
            data-track="cta_click"
            data-track-location="nfc_page_banner"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full bg-cyan-400 text-slate-950 font-bold text-sm hover:bg-cyan-300 transition-colors"
          >
            Apri Shop NFC →
          </a>
          <a
            href="/contattaci/?topic=nfc"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full border border-white/20 text-white font-semibold text-sm hover:border-white/50 transition-colors"
          >
            Richiedi fornitura B2B
          </a>
        </div>
      </div>
    </section>

    <!-- Prima/Dopo rimosso: evitiamo blocchi ridondanti -->

    <section class="py-24 px-6 md:px-12 lg:px-20">
      <div class="max-w-6xl mx-auto grid lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-5">
          <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-slate-950 dark:text-white">
            FAQ tessere NFC
          </h2>
          <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">
            Risposte rapide su costi, tempi e compatibilità.
          </p>
        </div>
        <div class="lg:col-span-7">
          <FAQ
            items={[
              {
                question: 'Le tessere NFC richiedono abbonamento?',
                answer:
                  'No. Programmazione inclusa e aggiornamenti previsti nella proposta, senza canone mensile.',
              },
              {
                question: 'Posso collegarla alle recensioni Google?',
                answer:
                  'Sì. Configuriamo link diretto alla pagina recensioni Google della tua attività.',
              },
              {
                question: 'Funziona su iPhone e Android?',
                answer: 'Sì, su dispositivi moderni. Aggiungiamo anche QR di backup.',
              },
              {
                question: 'Posso cambiare il link in futuro?',
                answer: 'Sì. Ti aggiorniamo la destinazione quando vuoi (gratis).',
              },
              {
                question: 'Cosa posso inserire nel tap?',
                answer:
                  'Recensioni, contatti, WhatsApp, menu digitale, sito, social, PDF, link multipli.',
              },
              {
                question: 'Dove posso acquistare tessere, espositori o tag NFC?',
                answer:
                  'Direttamente online su Shop NFC Bitora (shopnfc.bitora.it) per ordini rapidi da 10 a 100.000 pezzi, oppure contattandoci per forniture B2B personalizzate.',
              },
              {
                question: 'Quanto tempo serve?',
                answer: 'Tipicamente pochi giorni: grafica, approvazione e consegna.',
              },
            ]}
          />
        </div>
      </div>
    </section>

    <ServiceRelatedLinks
      links={[
        {
          href: '/blog/tessere-nfc-ristoranti/',
          label: 'NFC per ristoranti',
          desc: 'Guida recensioni Google con un tap',
        },
        {
          href: '/siti-web-professionali/',
          label: 'Siti web professionali',
          desc: 'La vetrina che il tap apre',
        },
        {
          href: '/servizi/',
          label: 'Tutti i servizi Bitora',
          desc: 'Siti, e-commerce e soluzioni tailormade',
        },
        {
          href: 'https://shopnfc.bitora.it/',
          label: 'Shop NFC Bitora',
          desc: 'Catalogo tag, tessere e lettori',
        },
      ]}
    />
  </main>
</Layout>

<ServiceSchema
  name="Tessere NFC programmate"
  url="https://bitora.it/nfc-ecosystem/"
  serviceType={['Tessere NFC', 'Recensioni Google', 'Menu digitale', 'Biglietti da visita smart']}
  areaServed={['Carmagnola', 'Torino', 'Piemonte', 'Italia']}
/>

<HowToSchema
  name="Come usare una tessera NFC per recensioni Google"
  description="Setup semplice: scegli destinazione, programmiamo chip, poi tap del cliente."
  steps={[
    {
      name: 'Scegli obiettivo',
      text: 'Recensioni Google, contatti, menu digitale o link multipli.',
    },
    { name: 'Programmazione', text: 'Bitora programma chip NFC e configura QR di backup.' },
    {
      name: 'Consegna e uso',
      text: 'Espone in locale o consegni al cliente: un tap e si apre pagina.',
    },
    { name: 'Aggiornamenti', text: 'Quando vuoi, cambiamo destinazione senza canone.' },
  ]}
/>

<FAQPageSchema
  items={[
    {
      question: 'Le tessere NFC richiedono abbonamento?',
      answer:
        'No. Programmazione inclusa e aggiornamenti previsti nella proposta, senza canone mensile.',
    },
    {
      question: 'Posso collegarla alle recensioni Google?',
      answer: 'Sì. Configuriamo link diretto alla pagina recensioni Google della tua attività.',
    },
    {
      question: 'Funziona su iPhone e Android?',
      answer: 'Sì, su dispositivi moderni. Aggiungiamo anche QR di backup.',
    },
    {
      question: 'Posso cambiare il link in futuro?',
      answer: 'Sì. Ti aggiorniamo la destinazione quando vuoi (gratis).',
    },
    {
      question: 'Cosa posso inserire nel tap?',
      answer: 'Recensioni, contatti, WhatsApp, menu digitale, sito, social, PDF, link multipli.',
    },
    {
      question: 'Dove posso acquistare tessere, espositori o tag NFC?',
      answer:
        'Direttamente online su Shop NFC Bitora (shopnfc.bitora.it) per ordini rapidi da 10 a 100.000 pezzi, oppure contattandoci per forniture B2B personalizzate.',
    },
    {
      question: 'Quanto tempo serve?',
      answer: 'Tipicamente pochi giorni: grafica, approvazione e consegna.',
    },
  ]}
/>

<BreadcrumbListSchema
  crumbs={[
    { name: 'Home', item: 'https://bitora.it/' },
    { name: 'Tessere NFC', item: 'https://bitora.it/nfc-ecosystem/' },
  ]}
/>
