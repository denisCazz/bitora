---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import EditorialImage from '../components/EditorialImage.astro';
---

<Layout
  title="Servizi | Siti web, e-commerce e soluzioni su misura | Bitora"
  description="Tre servizi, un unico partner: siti web vetrina, e-commerce e soluzioni tailormade con pratiche digitalizzate, rapportini e ticketing. Sede in Piemonte, copertura nazionale."
>
  <div class="bg-black text-white overflow-x-hidden">

    <!-- HERO -->
    <section class="relative pt-40 pb-20 md:pt-52 md:pb-28 border-b border-white/[0.06]">
      <div class="absolute inset-0" aria-hidden="true">
        <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[820px] h-[420px] rounded-full bg-white/[0.04] blur-[140px]"></div>
      </div>
      <div class="relative z-10 px-8 md:px-16 lg:px-24 max-w-7xl mx-auto">
        <p class="text-xs font-semibold tracking-[0.25em] text-white/50 uppercase mb-5">Cosa facciamo</p>
        <h1 class="text-4xl md:text-6xl lg:text-[4.5rem] font-bold leading-[1.05] tracking-tight mb-6 max-w-4xl">
          Siti vetrina, e-commerce e pratiche digitalizzate.
        </h1>
        <p class="text-base md:text-lg text-white/70 max-w-2xl leading-relaxed">
          Chi ci cerca per un sito professionale e chi vuole digitalizzare l’operatività: stesse competenze, tre servizi chiari. Scegli da dove partire, combiniamo il resto quando serve.
        </p>
      </div>
    </section>

    <section class="px-8 md:px-16 lg:px-24 max-w-7xl mx-auto pt-10">
      <EditorialImage
        src="/editorial/digital-process.png"
        alt="Passaggio da strumenti e documenti separati a un sistema digitale organizzato"
        eyebrow="Il risultato"
        caption="Partiamo dal punto che oggi rallenta di più: visibilità, vendita online oppure processi interni. Le integrazioni arrivano dopo, solo quando servono."
        loading="eager"
      />
    </section>

    <!-- SHOP NFC — nuova branchia -->
    <section class="px-8 md:px-16 lg:px-24 max-w-7xl mx-auto pt-10 md:pt-14">
      <a
        href="https://shopnfc.bitora.it/"
        rel="noopener noreferrer"
        class="block rounded-2xl border border-sky-300/30 bg-gradient-to-br from-sky-500/15 via-white/[0.04] to-white/[0.02] p-8 md:p-10 hover:border-sky-200/50 transition-colors"
        data-track="cta_click"
        data-track-location="servizi_shopnfc"
      >
        <p class="text-xs font-semibold tracking-[0.25em] text-sky-300 uppercase mb-4">Nuova branchia · Progetto Bitora</p>
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
          <div class="max-w-2xl">
            <h2 class="text-2xl md:text-[2rem] font-bold leading-tight mb-3">Shop NFC Bitora</h2>
            <p class="text-white/70 text-sm md:text-base leading-relaxed">
              Catalogo online di tag, tessere, braccialetti e lettori NFC. Programmazione inclusa, assistenza Bitora.
            </p>
          </div>
          <span class="inline-flex items-center gap-2 text-sm font-semibold whitespace-nowrap">
            Entra nello shop
            <span aria-hidden="true">→</span>
          </span>
        </div>
      </a>
    </section>

    <!-- 3 PILASTRI -->
    <section class="py-16 md:py-24 px-8 md:px-16 lg:px-24 max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-3 gap-6">

        <!-- 1. SITI WEB -->
        <article class="flex flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-8 hover:border-white/25 transition-colors">
          <p class="text-xs font-semibold tracking-[0.25em] text-white/45 uppercase mb-4">01 · Siti web</p>
          <h2 class="text-2xl md:text-[1.75rem] font-bold leading-tight mb-4">
            Presenza online che converte.
          </h2>
          <p class="text-white/65 text-sm leading-relaxed mb-6">
            Siti vetrina professionali per PMI e professionisti: design su misura, SEO tecnico, performance e contenuti. Perfetti per chi vuole farsi trovare e contattare.
          </p>
          <ul class="space-y-2.5 mb-8">
            {['Design mobile-first e accessibile', 'SEO tecnico e velocità reali', 'Contenuti che portano richieste', 'Manutenzione e aggiornamenti'].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-white/70">
                <span class="text-white/50 mt-px" aria-hidden="true">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <div class="mt-auto flex flex-wrap gap-3">
            <a href="/siti-web-professionali/" class="sl-btn-primary">Scopri siti web</a>
          </div>
        </article>

        <!-- 2. E-COMMERCE -->
        <article class="flex flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-8 hover:border-white/25 transition-colors">
          <p class="text-xs font-semibold tracking-[0.25em] text-white/45 uppercase mb-4">02 · E-commerce</p>
          <h2 class="text-2xl md:text-[1.75rem] font-bold leading-tight mb-4">
            Negozi online su misura.
          </h2>
          <p class="text-white/65 text-sm leading-relaxed mb-6">
            WooCommerce, Shopify o sviluppo custom: catalogo, pagamenti, spedizioni e gestione ordini. Per vendere online con un canale tuo, senza dipendere dai marketplace.
          </p>
          <ul class="space-y-2.5 mb-8">
            {['Catalogo, carrello e pagamenti', 'Integrazioni ordini e spedizioni', 'SEO prodotto e conversione', 'Supporto post-lancio continuo'].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-white/70">
                <span class="text-white/50 mt-px" aria-hidden="true">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <div class="mt-auto flex flex-wrap gap-3">
            <a href="/e-commerce/" class="sl-btn-primary">Scopri e-commerce</a>
          </div>
        </article>

        <!-- 3. SOLUZIONI TAILORMADE -->
        <article class="flex flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-8 hover:border-white/25 transition-colors">
          <p class="text-xs font-semibold tracking-[0.25em] text-white/45 uppercase mb-4">03 · Soluzioni tailormade</p>
          <h2 class="text-2xl md:text-[1.75rem] font-bold leading-tight mb-4">
            Ecosistema e pratiche digitalizzate.
          </h2>
          <p class="text-white/65 text-sm leading-relaxed mb-6">
            Rapportini, ticketing e pratiche adattabili al tuo processo. Per aziende con tecnici sul territorio che vogliono abbandonare carta, Excel e WhatsApp sparsi.
          </p>
          <ul class="space-y-2.5 mb-8">
            {['Ecosistema gestione interventi', 'Rapportini digitali con firma', 'Ticketing e pratiche adattabili', 'Gestionali e CRM su misura'].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-white/70">
                <span class="text-white/50 mt-px" aria-hidden="true">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <div class="mt-auto flex flex-wrap gap-3">
            <a href="/gestione-interventi/" class="sl-btn-primary">Scopri ecosistema</a>
          </div>
        </article>
      </div>
    </section>

    <!-- PER CHI -->
    <section class="py-16 md:py-24 border-t border-white/[0.06] bg-white/[0.015]">
      <div class="max-w-7xl mx-auto px-8 md:px-16 lg:px-24 grid md:grid-cols-2 gap-10 lg:gap-16">
        <div class="rounded-2xl border border-white/10 p-8 md:p-10">
          <p class="text-xs font-semibold tracking-[0.25em] text-white/45 uppercase mb-4">Se vuoi un sito</p>
          <h2 class="text-2xl md:text-3xl font-bold mb-4">Aziende che cercano visibilità.</h2>
          <p class="text-white/65 text-sm leading-relaxed mb-6">
            Partiamo dal sito vetrina: presenza credibile, SEO locale, richieste che arrivano. Quando serve, colleghiamo e-commerce o strumenti operativi.
          </p>
          <div class="flex flex-wrap gap-x-2 gap-y-2 mb-8">
            {['Sito vetrina', 'Sito professionale', 'SEO locale', 'Restyle', 'Landing page'].map((tag) => (
              <span class="px-3.5 py-1.5 rounded-full border border-white/20 text-xs text-white/60">{tag}</span>
            ))}
          </div>
          <a href="/siti-web-professionali/" class="sl-btn-secondary">Vai ai siti web →</a>
        </div>
        <div class="rounded-2xl border border-white/10 p-8 md:p-10">
          <p class="text-xs font-semibold tracking-[0.25em] text-white/45 uppercase mb-4">Se vuoi digitalizzare</p>
          <h2 class="text-2xl md:text-3xl font-bold mb-4">Aziende con pratiche da ordinare.</h2>
          <p class="text-white/65 text-sm leading-relaxed mb-6">
            Richieste, interventi, rapportini e documentazione in un sistema unico, configurato sul tuo processo. Si parte da una demo sul tuo caso reale.
          </p>
          <div class="flex flex-wrap gap-x-2 gap-y-2 mb-8">
            {['Pratiche digitalizzate', 'Rapportini con firma', 'Ticketing', 'Gestionali custom', 'CRM'].map((tag) => (
              <span class="px-3.5 py-1.5 rounded-full border border-white/20 text-xs text-white/60">{tag}</span>
            ))}
          </div>
          <a href="/gestione-interventi/" class="sl-btn-secondary">Vai alle soluzioni tailormade →</a>
        </div>
      </div>
    </section>

    <!-- STRUMENTI EXTRA -->
    <section class="py-16 md:py-24 border-t border-white/[0.06]">
      <div class="max-w-7xl mx-auto px-8 md:px-16 lg:px-24">
        <p class="text-xs font-semibold tracking-[0.25em] text-white/45 uppercase mb-4">Strumenti</p>
        <h2 class="text-2xl md:text-3xl font-bold mb-8">Da aggiungere quando servono</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
          <a href="/sistemi-aziendali/" class="rounded-2xl border border-white/10 p-6 hover:border-white/30 transition-colors">
            <h3 class="font-bold mb-2">Sistemi aziendali</h3>
            <p class="text-white/60 text-sm">Gestionali, CRM e CMMS integrati ai processi.</p>
          </a>
          <a href="https://shopnfc.bitora.it/" rel="noopener noreferrer" class="rounded-2xl border border-sky-300/25 p-6 hover:border-sky-200/50 transition-colors">
            <h3 class="font-bold mb-2">Shop NFC</h3>
            <p class="text-white/60 text-sm">Tag, tessere, braccialetti e lettori. Catalogo online.</p>
          </a>
          <a href="/nfc-ecosystem/" class="rounded-2xl border border-white/10 p-6 hover:border-white/30 transition-colors">
            <h3 class="font-bold mb-2">Tessere NFC su misura</h3>
            <p class="text-white/60 text-sm">Recensioni, menu e contatti con un tap.</p>
          </a>
          <a href="/bitora-crm/" class="rounded-2xl border border-white/10 p-6 hover:border-white/30 transition-colors">
            <h3 class="font-bold mb-2">Bitora CRM</h3>
            <p class="text-white/60 text-sm">Clienti, lead ed email in un’unica app.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 md:py-32 px-8 md:px-16 lg:px-24 text-center border-t border-white/10">
      <h2 class="text-3xl md:text-5xl font-bold leading-[1.05] tracking-tight mb-5 max-w-2xl mx-auto">
        Non sai da quale servizio partire?
      </h2>
      <p class="text-base md:text-lg text-white/60 mb-10 max-w-lg mx-auto">
        Raccontaci obiettivo e situazione attuale: ti proponiamo il percorso più diretto, senza venderti quello che non serve.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/contattaci/" class="sl-btn-primary">Parla con noi</a>
        <a href="/richiedi-demo/" class="sl-btn-secondary">Demo soluzioni tailormade</a>
      </div>
    </section>

  </div>
</Layout>

<style>
  .sl-btn-primary {
    display:inline-flex;align-items:center;gap:.5rem;
    background:#fff;color:#000;font-weight:600;font-size:.875rem;
    padding:.75rem 1.75rem;border-radius:4px;transition:background .2s;white-space:nowrap;
  }
  .sl-btn-primary:hover{background:#e5e5e5;}
  .sl-btn-secondary {
    display:inline-flex;align-items:center;gap:.5rem;
    background:transparent;color:#fff;font-weight:600;font-size:.875rem;
    padding:.75rem 1.75rem;border-radius:4px;
    border:1.5px solid rgba(255,255,255,.55);
    transition:border-color .2s,background .2s;white-space:nowrap;
  }
  .sl-btn-secondary:hover{border-color:rgba(255,255,255,.9);background:rgba(255,255,255,.08);}
</style>
