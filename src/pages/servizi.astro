---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import BreadcrumbListSchema from '../components/schema/BreadcrumbList.astro';
import { pillars } from '../data/services';

const method = [
  { n: '01', t: 'Ascolto', d: 'Call gratuita di 30 minuti. Obiettivi, problemi, vincoli e budget. Se non siamo la scelta giusta, te lo diciamo.' },
  { n: '02', t: 'Proposta a fasi', d: 'Entro 48 ore: cosa fare prima, cosa dopo, tempi e prezzo fisso per ogni fase.' },
  { n: '03', t: 'Design e sviluppo', d: 'Anteprime online ogni settimana. Vedi il progetto crescere e lo correggi mentre nasce.' },
  { n: '04', t: 'Lancio', d: 'Test, migrazione, SEO, tracciamento e formazione del team. Niente lanci al buio.' },
  { n: '05', t: 'Crescita', d: 'Manutenzione, misurazione e nuove funzioni. Il progetto evolve con l’azienda.' },
];

const platforms = [
  { t: 'Gestione interventi', d: 'Ticket, tecnici e rapportini per chi fa assistenza.', href: '/gestione-interventi/' },
  { t: 'Rapportini digitali', d: 'Schede intervento con foto, firma e PDF automatico.', href: '/rapportini/' },
  { t: 'Ticketing', d: 'Richieste dei clienti tracciate dall’apertura alla chiusura.', href: '/ticketing/' },
  { t: 'Bitora CRM', d: 'Clienti, lead e note con mappa geolocalizzata.', href: '/bitora-crm/' },
];
---

<Layout
  title="Servizi digitali per aziende: siti, e-commerce, gestionali, app e AI | Bitora"
  description="Tutti i servizi Bitora: siti web, e-commerce, gestionali su misura, app mobile, intelligenza artificiale e NFC. Un unico studio a Carmagnola (TO) per tutto il tuo digitale."
  pageType="CollectionPage"
>
  <BreadcrumbListSchema
    crumbs={[
      { name: 'Home', item: 'https://bitora.it/' },
      { name: 'Servizi', item: 'https://bitora.it/servizi/' },
    ]}
  />
  <PageHero
    eyebrow="Servizi"
    title='Sei competenze. <span class="b-grad">Un solo interlocutore.</span>'
    lede="Dal sito per farti trovare al gestionale che organizza il lavoro, fino all’app e all’AI che automatizzano le attività ripetitive. Scegli da dove partire: il resto si collega."
    crumbs={[{ name: 'Servizi', href: '/servizi/' }]}
    primary={{ label: 'Preventivo gratuito', href: '/contattaci/', track: 'servizi_hero' }}
    secondary={{ label: 'Come lavoriamo', href: '#metodo' }}
  />

  <section class="b-section b-section--line">
    <div class="b-shell srv">
      {
        pillars.map((p, i) => (
          <a href={p.href} class="srv__row" data-reveal data-reveal-delay={String((i % 2) + 1)}>
            <span class="b-mono srv__n">{p.n}</span>
            <div class="srv__main">
              <p class="srv__kicker">{p.kicker}</p>
              <h2 class="b-h2 srv__title">{p.title}</h2>
            </div>
            <div class="srv__side">
              <p class="b-text">{p.short}</p>
              <div class="b-chips">
                {p.bullets.map(b => (
                  <span class="b-chip">{b}</span>
                ))}
              </div>
            </div>
            <span class="srv__go" aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="b-section b-section--alt b-section--line" id="metodo">
    <div class="b-shell">
      <div class="b-head b-head--split" data-reveal>
        <div>
          <p class="b-eyebrow">Metodo</p>
          <h2 class="b-h2">Come lavoriamo, <span class="b-accent">passo per passo</span>.</h2>
        </div>
        <p class="b-text">
          Ogni progetto segue lo stesso percorso trasparente, che si tratti di una landing page o di un
          gestionale con app. Sai sempre a che punto siamo e cosa succede dopo.
        </p>
      </div>
      <ol class="mth">
        {
          method.map((m, i) => (
            <li class="b-card" data-reveal data-reveal-delay={String(i + 1)}>
              <span class="b-step__n">{m.n}</span>
              <h3 class="b-h3 b-step__t">{m.t}</h3>
              <p class="b-text">{m.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="b-section b-section--line">
    <div class="b-shell">
      <div class="b-head" data-reveal>
        <p class="b-eyebrow">Piattaforme pronte</p>
        <h2 class="b-h2">Vuoi partire <span class="b-accent">subito</span>?</h2>
        <p class="b-lede">Piattaforme già sviluppate e collaudate, configurate sulla tua azienda in pochi giorni.</p>
      </div>
      <div class="plt">
        {
          platforms.map((p, i) => (
            <a href={p.href} class="b-card" data-reveal data-reveal-delay={String(i + 1)}>
              <h3 class="b-h3">{p.t}</h3>
              <p class="b-text plt__d">{p.d}</p>
              <span class="b-mono plt__go">Scopri →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .srv {
    border-top: 1px solid var(--b-line);
  }
  .srv__row {
    position: relative;
    display: grid;
    gap: 1.25rem;
    padding: clamp(2rem, 4vw, 3rem) 0;
    border-bottom: 1px solid var(--b-line);
    color: inherit;
    text-decoration: none;
  }
  .srv__row:hover {
    opacity: 1;
  }
  @media (min-width: 960px) {
    .srv__row {
      grid-template-columns: 4rem 1fr 1fr 3rem;
      align-items: center;
      gap: 2.5rem;
    }
  }
  .srv__n {
    font-size: 0.82rem;
    color: var(--b-cyan);
  }
  .srv__kicker {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    color: var(--b-fg-3);
  }
  .srv__title {
    transition:
      color 0.3s,
      transform 0.4s var(--b-ease);
  }
  .srv__row:hover .srv__title {
    color: var(--b-cyan);
    transform: translateX(8px);
  }
  .srv__side .b-chips {
    margin-top: 1rem;
  }
  .srv__go {
    display: none;
    justify-self: end;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid var(--b-line-2);
    font-size: 1.2rem;
    transition:
      background 0.3s,
      color 0.3s,
      border-color 0.3s;
  }
  @media (min-width: 960px) {
    .srv__go {
      display: inline-flex;
    }
  }
  .srv__row:hover .srv__go {
    background: var(--b-cyan);
    border-color: var(--b-cyan);
    color: #001318;
  }

  .mth {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 760px) {
    .mth {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .mth {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .plt {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 760px) {
    .plt {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .plt {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .plt__d {
    margin: 0.6rem 0 1.5rem;
  }
  .plt__go {
    font-size: 0.8rem;
    color: var(--b-cyan);
  }
</style>
