---
export const prerender = false;
import OpsLayout from '../../../../layouts/OpsLayout.astro';
import SignalJourney from '../../../../components/blog/SignalJourney.astro';
import { getPrisma, isDatabaseConfigured } from '../../../../lib/db';
import { getArticleBySlug } from '../../../../lib/editorial/articles';

const id = Astro.params.id ?? '';
if (!isDatabaseConfigured()) {
  return Astro.redirect('/ops/editoriale/');
}
const row = await getPrisma().article.findUnique({ where: { id } });
if (!row) return new Response(null, { status: 404 });
const article = await getArticleBySlug(row.slug, {
  preview: true,
  allowStatuses: ['DRAFT', 'IN_REVIEW', 'PUBLISHED', 'ARCHIVED'],
});
if (!article) return new Response(null, { status: 404 });
---

<OpsLayout title={`Anteprima · ${article.title}`} heading="Anteprima">
  <p class="ops-muted">
    <a class="ops-link" href={`/ops/editoriale/articoli/${id}/`}>Torna all’editor</a>
  </p>
  <div style="margin-top:24px;border-radius:24px;overflow:hidden;background:#fff;color:#111">
    <SignalJourney article={article} preview />
  </div>
</OpsLayout>
