---
export const prerender = false;
import OpsLayout from '../../../layouts/OpsLayout.astro';
import { getPrisma, isDatabaseConfigured } from '../../../lib/db';
import { formatClock } from '../../../lib/editorial/format';

const trends = isDatabaseConfigured()
  ? await getPrisma().trendCandidate.findMany({
      include: {
        sources: true,
        articles: { select: { id: true, slug: true, title: true, status: true } },
      },
      orderBy: [{ status: 'asc' }, { score: 'desc' }],
      take: 80,
    })
  : [];
---

<OpsLayout title="Trend" heading="Inbox trend">
  <div class="ops-table-wrap">
    <table class="ops-table">
      <thead>
        <tr>
          <th>Segnale</th>
          <th>Topic</th>
          <th>Score</th>
          <th>Stato</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {
          trends.map(trend => (
            <tr>
              <td class="ops-wrap">
                <a class="ops-link" href={trend.url} target="_blank" rel="noreferrer">
                  {trend.title}
                </a>
                <div class="ops-muted">{trend.excerpt.slice(0, 160)}</div>
                {trend.articles[0] && (
                  <div>
                    <a class="ops-link" href={`/ops/editoriale/articoli/${trend.articles[0].id}/`}>
                      Bozza: {trend.articles[0].title}
                    </a>
                  </div>
                )}
              </td>
              <td>{trend.topic}</td>
              <td>{trend.score.toFixed(2)}</td>
              <td>{trend.status}</td>
              <td>
                <form method="POST" action="/api/ops/editorial/trend/">
                  <input type="hidden" name="id" value={trend.id} />
                  <button class="ops-btn ghost" name="status" value="DISMISSED">
                    Scarta
                  </button>
                </form>
              </td>
            </tr>
          ))
        }
        {
          trends.length === 0 && (
            <tr>
              <td colspan="5">Nessun trend. Lancia una scansione dalla dashboard.</td>
            </tr>
          )
        }
      </tbody>
    </table>
  </div>
  <p class="ops-muted" style="margin-top:12px">Aggiornato: {formatClock(trends[0]?.createdAt)}</p>
</OpsLayout>
