---
export const prerender = false;
import OpsLayout from '../../../layouts/OpsLayout.astro';
import { countEditorialStats } from '../../../lib/editorial/articles';
import { isDatabaseConfigured } from '../../../lib/db';
import { getPrisma } from '../../../lib/db';
import { getEditorialScheduleStatus } from '../../../lib/editorial/pipeline';
import { formatClock, formatUsd } from '../../../lib/editorial/format';
import { tavilyConfigured } from '../../../lib/editorial/tavily';
import { openaiConfigured } from '../../../lib/editorial/openai';

const configured = isDatabaseConfigured();
const stats = await countEditorialStats();
const schedule = await getEditorialScheduleStatus();
const runs = configured
  ? await getPrisma().editorialRun.findMany({ orderBy: { startedAt: 'desc' }, take: 12 })
  : [];
const missingKeys = [
  !tavilyConfigured() && 'TAVILY_API_KEY',
  !openaiConfigured() && 'OPENAI_API_KEY',
].filter(Boolean);
---

<OpsLayout title="Editoriale" heading="Radar editoriale">
  {
    !configured && (
      <p class="ops-note">
        DATABASE_URL assente: configura PostgreSQL per attivare bozze, trend e lead.
      </p>
    )
  }
  {
    missingKeys.length > 0 && (
      <p class="ops-note">
        Job in pausa: manca {missingKeys.join(' e ')}. Senza queste chiavi il cron non chiama le
        API.
      </p>
    )
  }

  <div class="ops-cards">
    <a class="ops-card" href="/ops/editoriale/articoli/">
      <p class="ops-pill"><span class="ops-dot warn"></span> Bozze</p>
      <h2>{stats.drafts}</h2>
      <p class="ops-muted">{stats.review} in review · {stats.published} pubblicati</p>
    </a>
    <a class="ops-card" href="/ops/editoriale/trend/">
      <p class="ops-pill"><span class="ops-dot"></span> Trend</p>
      <h2>{stats.trends}</h2>
      <p class="ops-muted">Segnali nuovi da Tavily, in attesa di bozza.</p>
    </a>
    <div class="ops-card">
      <p class="ops-pill">
        <span class:list={['ops-dot', schedule.cronEnabled && schedule.due && 'warn']}></span>
        Job
      </p>
      <h2>{schedule.cronEnabled ? (schedule.due ? 'Due' : 'Wait') : 'Off'}</h2>
      <p class="ops-muted">
        ogni {schedule.intervalHours}h · prossimo {formatClock(schedule.nextCronAt)}
      </p>
    </div>
  </div>

  <p class="ops-note">
    Low-credit: 1 topic/run, Tavily <code>{schedule.tavilyDepth}</code>, max {
      schedule.queriesPerTopic
    } query, max {schedule.maxDraftsPerRun} bozza, stop se {schedule.maxOpenDrafts} bozze aperte. Budget
    oggi {formatUsd(schedule.spentTodayUsd)} / {formatUsd(schedule.dailyBudgetUsd)}. Modello
    <code>{schedule.model}</code>. L’AI non pubblica mai. Il cron ops (5 min) fa da scheduler e
    salta se non è ora.
  </p>

  <form
    method="POST"
    action="/api/ops/editorial/run/"
    class="ops-form-actions"
    style="margin: 22px 0;"
  >
    <button class="ops-btn" type="submit" name="generateDrafts" value="1"
      >Scan 1 topic + max 1 bozza</button
    >
    <button class="ops-btn ghost" type="submit" name="generateDrafts" value="0">Solo trend</button>
  </form>

  <h2 class="ops-section-title" style="margin-top:28px">Run</h2>
  <div class="ops-table-wrap">
    <table class="ops-table">
      <thead>
        <tr>
          <th>Quando</th>
          <th>Chi</th>
          <th>Tipo</th>
          <th>Stato</th>
          <th>Costo</th>
          <th>Log</th>
        </tr>
      </thead>
      <tbody>
        {
          runs.map(run => (
            <tr>
              <td>{formatClock(run.startedAt)}</td>
              <td>{run.triggeredBy}</td>
              <td>{run.kind}</td>
              <td>{run.status}</td>
              <td>{formatUsd(run.costUsd)}</td>
              <td>
                <a class="ops-link" href={`/ops/editoriale/run/${run.id}/`}>
                  dettagli
                </a>
              </td>
            </tr>
          ))
        }
        {
          runs.length === 0 && (
            <tr>
              <td colspan="6">Nessun run.</td>
            </tr>
          )
        }
      </tbody>
    </table>
  </div>
</OpsLayout>
