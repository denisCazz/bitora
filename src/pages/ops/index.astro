---
export const prerender = false;
import OpsLayout from '../../layouts/OpsLayout.astro';
import { monitoredSites } from '../../data/monitoredTargets';
import { formatRelative } from '../../lib/ops/format';
import { collectDeadlineViews, deadlineSummary } from '../../lib/ops/deadlines';
import { currentSnapshot } from '../../lib/ops/monitor';
import { getOpsState } from '../../lib/ops/store';
import { ensureVaultSeeded, vaultSummary } from '../../lib/ops/vault';

ensureVaultSeeded();
const snapshot = currentSnapshot();
const state = getOpsState();
const vault = vaultSummary(state.vault);
const lastCheck = state.lastCronAt ?? state.lastManualCheckAt;
const siteHealth = snapshot.sites.length === 0 ? 'warn' : snapshot.downCount > 0 ? 'down' : 'ok';
const vpsHealth = snapshot.vpsIssues.some(i => i.severity === 'critical')
  ? 'down'
  : snapshot.vpsIssues.length > 0
    ? 'warn'
    : snapshot.runtime
      ? 'ok'
      : 'warn';
const deadlines = deadlineSummary(
  collectDeadlineViews(state).filter(item => item.source === 'manual')
);
const deadlineHealth = deadlines.overdue ? 'down' : deadlines.week ? 'warn' : undefined;
---

<OpsLayout title="Bitora Ops" heading="Panoramica">
  <div class="ops-cards">
    <a class="ops-card" href="/ops/siti/">
      <p class="ops-pill">
        <span class:list={['ops-dot', siteHealth !== 'ok' && siteHealth]}></span>
        Stato siti
      </p>
      <h2>
        {
          snapshot.sites.length
            ? `${snapshot.upCount}/${snapshot.sites.length} online`
            : `${monitoredSites.length} siti da controllare`
        }
      </h2>
      <p class="ops-muted">
        Uptime HTTP dei siti clienti e dell’infrastruttura Bitora. Ultimo check: {
          formatRelative(lastCheck)
        }.
      </p>
    </a>
    <a class="ops-card" href="/ops/vps/">
      <p class="ops-pill">
        <span class:list={['ops-dot', vpsHealth !== 'ok' && vpsHealth]}></span>
        Monitoraggio VPS
      </p>
      <h2>
        {
          snapshot.vpsIssues.length
            ? `${snapshot.vpsIssues.length} ${snapshot.vpsIssues.length === 1 ? 'segnalazione' : 'segnalazioni'}`
            : 'Risorse nella norma'
        }
      </h2>
      <p class="ops-muted">Load, RAM e disco del runtime, più metriche host se l’agent è attivo.</p>
    </a>
    <a class="ops-card" href="/ops/password/">
      <p class="ops-pill"><span class="ops-dot"></span> Password</p>
      <h2>
        {
          vault.count
            ? `${vault.count} ${vault.count === 1 ? 'credenziale' : 'credenziali'}`
            : 'Nessuna credenziale'
        }
      </h2>
      <p class="ops-muted">
        {
          vault.projects
            ? `${vault.projects} ${vault.projects === 1 ? 'progetto' : 'progetti'} con accessi, database e API.`
            : 'Casseforte per progetto: login, database e chiavi API.'
        }
      </p>
    </a>
    <a class="ops-card" href="/ops/scadenze/">
      <p class="ops-pill">
        <span class:list={['ops-dot', deadlineHealth]}></span>
        Scadenziario
      </p>
      <h2>
        {
          deadlines.overdue
            ? `${deadlines.overdue} ${deadlines.overdue === 1 ? 'scaduta' : 'scadute'}`
            : deadlines.week
              ? `${deadlines.week} in settimana`
              : deadlines.open
                ? `${deadlines.open} ${deadlines.open === 1 ? 'scadenza aperta' : 'scadenze aperte'}`
                : 'Nessuna scadenza'
        }
      </h2>
      <p class="ops-muted">Domini, hosting, contratti, licenze e fatture. Alert Telegram in arrivo.</p>
    </a>
    <a class="ops-card" href="/ops/infrastruttura/">
      <p class="ops-pill">
        <span class:list={['ops-dot', snapshot.vpsIssues.length ? 'warn' : undefined]}></span>
        Infrastruttura
      </p>
      <h2>{Object.keys(state.services).length} container rilevati</h2>
      <p class="ops-muted">Certificati, domini, backup, container e ultimo deploy.</p>
    </a>
    <a class="ops-card" href="/ops/incidenti/">
      <p class="ops-pill">
        <span
          class:list={[
            'ops-dot',
            state.incidents.some(incident => !incident.resolvedAt) ? 'down' : undefined,
          ]}></span>
        Incidenti
      </p>
      <h2>{state.incidents.filter(incident => !incident.resolvedAt).length} aperti</h2>
      <p class="ops-muted">Timeline, durata, presa in carico e note operative.</p>
    </a>
    <a class="ops-card" href="/ops/storico/">
      <p class="ops-pill"><span class="ops-dot"></span> Storico</p>
      <h2>{state.history.length} rilevazioni</h2>
      <p class="ops-muted">Uptime e latenza fino a 30 giorni.</p>
    </a>
  </div>

  <form method="POST" action="/api/ops/check/" style="margin-top: 22px;">
    <button class="ops-btn" type="submit">Esegui check ora</button>
  </form>

  <div class="ops-note">
    <strong style="color:#fff">Cron Coolify</strong> (ogni 5 minuti), con header di autenticazione:<br
    />
    <code>
      curl -fsS -X POST -H "Authorization: Bearer $OPS_CRON_SECRET" https://bitora.it/api/ops/cron/
    </code>
    <br />Watchdog separato (ogni 10 minuti):
    <code>
      curl -fsS -X POST -H "Authorization: Bearer $OPS_CRON_SECRET"
      https://bitora.it/api/ops/watchdog/
    </code>
    {
      !state.lastCronAt && (
        <p style="margin: 10px 0 0">
          Nessun cron registrato finora: finché non gira, gli alert email non partono da soli.
        </p>
      )
    }
  </div>
</OpsLayout>
