---
export const prerender = false;
import OpsLayout from '../../layouts/OpsLayout.astro';
import { getOpsState } from '../../lib/ops/store';
import {
  VAULT_GROUP_LABELS,
  VAULT_KIND_LABELS,
  VAULT_KINDS,
  VAULT_PROJECTS,
  emptyVaultProjects,
  ensureVaultSeeded,
  groupVaultByProject,
  revealVault,
  vaultSummary,
  type VaultView,
} from '../../lib/ops/vault';

ensureVaultSeeded();
const state = getOpsState();
const views = revealVault(state.vault);
const summary = vaultSummary(state.vault);
const errore = Astro.url.searchParams.get('errore');
const modifica = Astro.url.searchParams.get('modifica') || '';
const progetto = Astro.url.searchParams.get('progetto') || '';
const q = (Astro.url.searchParams.get('q') || '').trim().toLowerCase();
const importate = Astro.url.searchParams.get('importate');
const aggiornate = Astro.url.searchParams.get('aggiornate');
const editing = views.find(item => item.id === modifica);

function matches(item: VaultView): boolean {
  if (progetto && item.projectId !== progetto) return false;
  if (!q) return true;
  const haystack = [item.projectName, item.title, item.kindLabel, item.username, item.url, item.notes]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();
  return haystack.includes(q);
}

const filtered = views.filter(matches);
const groups = groupVaultByProject(filtered);
const projectChips = groupVaultByProject(views);
const emptyProjects = emptyVaultProjects(state.vault);
const errorMessages: Record<string, string> = {
  dati: 'Controlla progetto, titolo e password.',
  mancante: 'Credenziale non trovata.',
};

function projectHref(id = ''): string {
  const params = new URLSearchParams();
  if (id) params.set('progetto', id);
  if (q) params.set('q', q);
  const query = params.toString();
  return query ? `/ops/password/?${query}` : '/ops/password/';
}
---

<OpsLayout title="Password | Bitora Ops" heading="Gestore password">
  <div class="ops-cards" style="margin-bottom: 22px;">
    <div class="ops-card">
      <p class="ops-pill"><span class="ops-dot"></span> Credenziali</p>
      <h2>{summary.count}</h2>
      <p class="ops-muted">Login, database, API e pagamenti.</p>
    </div>
    <div class="ops-card">
      <p class="ops-pill"><span class="ops-dot"></span> Progetti con password</p>
      <h2>{summary.projects}</h2>
      <p class="ops-muted">Raggruppate per sito, gestionale o cliente.</p>
    </div>
    <div class="ops-card">
      <p class="ops-pill">
        <span class:list={['ops-dot', emptyProjects.length ? 'warn' : undefined]}></span>
        Senza credenziali
      </p>
      <h2>{emptyProjects.length}</h2>
      <p class="ops-muted">Progetti monitorati ancora da compilare.</p>
    </div>
  </div>

  {
    errore && errorMessages[errore] && (
      <div class="ops-note" style="margin: 0 0 22px;" role="alert">
        {errorMessages[errore]}
      </div>
    )
  }
  {
    importate != null && (
      <div class="ops-note" style="margin: 0 0 22px;">
        Importate {importate} credenziali dai progetti locali
        {aggiornate && Number(aggiornate) > 0 ? `, aggiornate ${aggiornate}` : ''}.
      </div>
    )
  }

  <section class="ops-card" style="margin-bottom: 28px;" id="modulo">
    <h2 class="ops-section-title">{editing ? 'Modifica credenziale' : 'Nuova credenziale'}</h2>
    <form class="ops-form" method="POST" action="/api/ops/vault/" autocomplete="off">
      <input type="hidden" name="action" value={editing ? 'update' : 'create'} />
      {editing && <input type="hidden" name="id" value={editing.id} />}
      <div class="ops-form-row">
        <label>
          Progetto
          <select name="projectId" required>
            {
              VAULT_PROJECTS.map(project => (
                <option value={project.id} selected={(editing?.projectId ?? progetto) === project.id}>
                  {project.name}
                </option>
              ))
            }
          </select>
        </label>
        <label>
          Titolo
          <input
            name="title"
            required
            maxlength="120"
            placeholder="Es. Admin sito"
            value={editing?.title ?? ''}
          />
        </label>
        <label>
          Tipo
          <select name="kind">
            {
              VAULT_KINDS.map(kind => (
                <option value={kind} selected={(editing?.kind ?? 'login') === kind}>
                  {VAULT_KIND_LABELS[kind]}
                </option>
              ))
            }
          </select>
        </label>
        <label>
          Utente / email
          <input
            name="username"
            maxlength="200"
            placeholder="Opzionale"
            value={editing?.username ?? ''}
          />
        </label>
      </div>
      <div class="ops-form-row">
        <label>
          Password / secret
          <input
            name="secret"
            type="password"
            maxlength="20000"
            placeholder={editing ? 'Lascia vuoto per non cambiare' : 'Obbligatoria'}
            required={!editing}
          />
        </label>
        <label>
          URL
          <input
            name="url"
            maxlength="500"
            placeholder="Host, pannello o sito"
            value={editing?.url ?? ''}
          />
        </label>
        <label>
          Note
          <input name="notes" maxlength="1000" placeholder="Opzionale" value={editing?.notes ?? ''} />
        </label>
      </div>
      <div class="ops-form-actions">
        <button class="ops-btn" type="submit">{editing ? 'Salva modifiche' : 'Aggiungi password'}</button>
        {
          editing && (
            <a class="ops-btn ghost" href="/ops/password/">
              Annulla
            </a>
          )
        }
      </div>
    </form>
    <form method="POST" action="/api/ops/vault/" style="margin-top: 12px;">
      <input type="hidden" name="action" value="import" />
      <button class="ops-btn ghost" type="submit">Reimporta dai progetti</button>
    </form>
  </section>

  <form method="GET" action="/ops/password/" class="ops-form" style="margin-bottom: 16px;">
    {progetto && <input type="hidden" name="progetto" value={progetto} />}
    <label>
      Cerca
      <input type="search" name="q" value={q} placeholder="Progetto, titolo, utente…" />
    </label>
  </form>

  <div class="ops-filters" aria-label="Progetti">
    <a href={q ? `/ops/password/?q=${encodeURIComponent(q)}` : '/ops/password/'} class:list={[!progetto && 'is-active']}>
      Tutti
    </a>
    {
      projectChips.map(({ project, entries }) => (
        <a href={projectHref(project.id)} class:list={[progetto === project.id && 'is-active']}>
          {project.name} ({entries.length})
        </a>
      ))
    }
  </div>

  {
    groups.length ? (
      groups.map(({ project, entries }) => (
        <section style="margin-bottom: 28px;" id={project.id}>
          <div class="ops-project-head">
            <h2 class="ops-section-title" style="margin: 0;">
              {project.name}
              <span class="ops-muted" style="margin-left: 8px; letter-spacing: 0; text-transform: none;">
                {VAULT_GROUP_LABELS[project.group]} · {entries.length}
              </span>
            </h2>
            {project.url ? (
              <a class="ops-link" href={project.url} target="_blank" rel="noreferrer">
                Apri sito
              </a>
            ) : null}
          </div>
          <div class="ops-table-wrap">
            <table class="ops-table">
              <thead>
                <tr>
                  <th>Tipo</th>
                  <th>Titolo</th>
                  <th>Utente</th>
                  <th>Password</th>
                  <th>URL / note</th>
                  <th>Gestione</th>
                </tr>
              </thead>
              <tbody>
                {entries.map(item => (
                  <tr>
                    <td>{item.kindLabel}</td>
                    <td class="ops-wrap">{item.title}</td>
                    <td class="ops-wrap">
                      {item.username ? (
                        <div class="ops-secret-cell">
                          <span class="ops-mono">{item.username}</span>
                          <button
                            class="ops-btn ghost"
                            type="button"
                            data-copy={item.username}
                            data-label="utente"
                          >
                            Copia
                          </button>
                        </div>
                      ) : (
                        '—'
                      )}
                    </td>
                    <td class="ops-wrap">
                      <div class="ops-secret-cell">
                        <textarea hidden id={`secret-${item.id}`}>{item.plaintext}</textarea>
                        <span class="ops-secret-value ops-mono" data-secret-for={`secret-${item.id}`} data-shown="0">
                          ••••••••
                        </span>
                        <button class="ops-btn ghost" type="button" data-reveal>Mostra</button>
                        <button class="ops-btn ghost" type="button" data-copy-secret>Copia</button>
                      </div>
                    </td>
                    <td class="ops-wrap">
                      {item.url ? (
                        <div>
                          <span class="ops-mono">{item.url}</span>
                        </div>
                      ) : null}
                      {item.notes ? <div class="ops-muted">{item.notes}</div> : null}
                      {!item.url && !item.notes ? '—' : null}
                    </td>
                    <td>
                      <div class="ops-row-actions">
                        <a class="ops-link" href={`/ops/password/?modifica=${item.id}`}>
                          Modifica
                        </a>
                        <form method="POST" action="/api/ops/vault/">
                          <input type="hidden" name="id" value={item.id} />
                          <input type="hidden" name="action" value="delete" />
                          <button
                            class="ops-link"
                            type="submit"
                            style="background:none;border:0;padding:0;font:inherit;cursor:pointer;"
                            onclick="return confirm('Eliminare questa credenziale?')"
                          >
                            Elimina
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))
    ) : (
      <div class="ops-card">
        <p class="ops-muted">
          Nessuna password in questo filtro. Aggiungine una dal modulo oppure importa il seed dei
          progetti locali.
        </p>
      </div>
    )
  }

  {
    emptyProjects.length > 0 && !progetto && !q && (
      <div class="ops-note">
        <strong style="color:#fff">Progetti senza credenziali:</strong>{' '}
        {emptyProjects.map(project => project.name).join(', ')}.
      </div>
    )
  }

  <div class="ops-note">
    Le password recuperate dai <code>.env</code> dei progetti restano cifrate nello stato ops
    (<code>OPS_STATE_PATH</code>), non nel git. Per popolare la produzione copia
    <code>data/ops-vault.seed.json</code> sul VPS e usa “Reimporta dai progetti”.
  </div>
</OpsLayout>

<script>
  function flash(button: HTMLButtonElement, label: string) {
    const previous = button.textContent;
    button.textContent = label;
    window.setTimeout(() => {
      button.textContent = previous;
    }, 1400);
  }

  async function copyText(value: string, button: HTMLButtonElement) {
    try {
      await navigator.clipboard.writeText(value);
      flash(button, 'Copiato');
    } catch {
      flash(button, 'Errore');
    }
  }

  document.addEventListener('click', event => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement)) return;
    const cell = target.closest('.ops-secret-cell');

    if (target.dataset.copy) {
      void copyText(target.dataset.copy, target);
      return;
    }

    if (!cell) return;
    const secretEl = cell.querySelector<HTMLElement>('[data-secret-for]');
    const rawId = secretEl?.dataset.secretFor || '';
    const raw = rawId ? document.getElementById(rawId) : null;
    const secret = raw instanceof HTMLTextAreaElement ? raw.value : raw?.textContent || '';

    if (target.hasAttribute('data-reveal') && secretEl) {
      const shown = secretEl.dataset.shown === '1';
      secretEl.dataset.shown = shown ? '0' : '1';
      secretEl.textContent = shown ? '••••••••' : secret;
      target.textContent = shown ? 'Mostra' : 'Nascondi';
      return;
    }

    if (target.hasAttribute('data-copy-secret')) {
      void copyText(secret, target);
    }
  });
</script>
