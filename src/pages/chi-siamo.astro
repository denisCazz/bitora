---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import ShotMarquee from '../components/ui/ShotMarquee.astro';
import BreadcrumbListSchema from '../components/schema/BreadcrumbList.astro';
import { getWork } from '../data/work';

const live = getWork().filter(w => !w.isWip).length;

const values = [
  { t: 'Parliamo chiaro', d: 'Niente gergo, niente promesse gonfiate. Ti diciamo cosa serve, cosa no e quanto costa, anche quando la risposta è “non ti serve”.' },
  { t: 'Costruiamo per durare', d: 'Codice pulito, documentato e tuo. Strumenti che puoi far crescere negli anni senza ricominciare da capo.' },
  { t: 'Ci mettiamo la faccia', d: 'Chi progetta è chi sviluppa ed è chi ti risponde al telefono. Nessun passaggio di mano, nessun call center.' },
  { t: 'Misuriamo', d: 'Ogni progetto ha un obiettivo concreto: richieste, ordini, ore risparmiate. Se non si misura, non è finito.' },
];

const stack = [
  'Astro', 'Next.js', 'React', 'React Native', 'Expo', 'TypeScript', 'Tailwind', 'PostgreSQL', 'Prisma',
  'OpenAI', 'Stripe', 'PayPal', 'Cloudflare', 'Docker', 'Coolify', 'MQTT',
];
---

<Layout
  title="Chi siamo | Bitora, studio digitale a Carmagnola (TO)"
  description="Bitora è lo studio digitale di Denis Cazzulo a Carmagnola (TO): siti, e-commerce, gestionali, app e AI per aziende del Piemonte e di tutta Italia, dal 2020."
  pageType="AboutPage"
>
  <BreadcrumbListSchema
    crumbs={[
      { name: 'Home', item: 'https://bitora.it/' },
      { name: 'Chi siamo', item: 'https://bitora.it/chi-siamo/' },
    ]}
  />
  <PageHero
    eyebrow="Chi siamo"
    title='Un piccolo studio, <span class="b-grad">a Carmagnola</span>. Con grandi standard.'
    lede="Bitora nasce nel 2020 con un’idea semplice: dare alle aziende del territorio strumenti digitali fatti su misura, con la qualità delle grandi agenzie e il rapporto diretto di una bottega."
    crumbs={[{ name: 'Chi siamo', href: '/chi-siamo/' }]}
    primary={{ label: 'Conosciamoci', href: '/contattaci/', track: 'about_hero' }}
    secondary={{ label: 'Guarda i lavori', href: '/lavori/' }}
  />

  <section class="b-section b-section--line">
    <div class="b-shell ab">
      <div class="ab__card b-card" data-reveal>
        <img src="/bitora-mark.png" alt="" width="140" height="64" loading="lazy" />
        <dl>
          <div><dt>Fondatore</dt><dd>Denis Cazzulo</dd></div>
          <div><dt>Sede</dt><dd>Carmagnola (TO)</dd></div>
          <div><dt>Attivi dal</dt><dd>2020</dd></div>
          <div><dt>Progetti online</dt><dd>{live}+</dd></div>
          <div><dt>P.IVA</dt><dd>13359170019</dd></div>
        </dl>
      </div>
      <div data-reveal data-reveal-delay="1">
        <p class="b-eyebrow">La storia</p>
        <h2 class="b-h2">Dal sito per il bar sotto casa al gestionale con l’AI.</h2>
        <div class="ab__text">
          <p class="b-text">
            Bitora è l’attività di <strong>Denis Cazzulo</strong>, sviluppatore e progettista. È iniziata
            con i siti per le attività di Carmagnola e dintorni: bar, ristoranti, artigiani,
            professionisti. Lavorando a contatto con i titolari, è diventato chiaro che il sito era solo
            la punta dell’iceberg.
          </p>
          <p class="b-text">
            Dietro c’erano magazzini gestiti a mano, rapportini di carta, preventivi riscritti ogni
            volta, telecomandi da distribuire. Così Bitora è cresciuta: oggi progetta e sviluppa
            e-commerce, gestionali, app iOS e Android e automazioni con l’intelligenza artificiale.
          </p>
          <p class="b-text">
            Il metodo è rimasto lo stesso: ascoltare, capire il lavoro vero e costruire lo strumento
            più semplice che risolve il problema. Poi restare, per farlo crescere.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="b-section b-section--alt b-section--line">
    <div class="b-shell">
      <div class="b-head" data-reveal>
        <p class="b-eyebrow">Come la pensiamo</p>
        <h2 class="b-h2">Quattro regole che <span class="b-accent">non cambiamo</span>.</h2>
      </div>
      <div class="vals">
        {
          values.map((v, i) => (
            <article class="b-card" data-reveal data-reveal-delay={String(i + 1)}>
              <span class="b-step__n">0{i + 1}</span>
              <h3 class="b-h3 b-step__t">{v.t}</h3>
              <p class="b-text">{v.d}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="b-section b-section--line">
    <div class="b-shell">
      <div class="b-head b-head--split" data-reveal>
        <div>
          <p class="b-eyebrow">Strumenti</p>
          <h2 class="b-h2">Tecnologie moderne, <span class="b-accent">scelte con criterio</span>.</h2>
        </div>
        <p class="b-text">
          Usiamo gli stessi strumenti delle aziende tech più avanzate, ma solo quando servono. Ogni
          progetto gira su infrastruttura monitorata 24/7, con backup e avvisi automatici.
        </p>
      </div>
      <div class="b-chips ab__stack" data-reveal>
        {stack.map(s => <span class="b-chip">{s}</span>)}
      </div>
    </div>
    <div class="ab__marquee" data-reveal>
      <ShotMarquee reverse speed={80} />
    </div>
  </section>

  <section class="b-section b-section--alt b-section--line">
    <div class="b-shell ab__local" data-reveal>
      <div>
        <p class="b-eyebrow">Dove siamo</p>
        <h2 class="b-h2">Carmagnola, tra Torino e Cuneo.</h2>
        <p class="b-lede">
          Incontriamo volentieri i clienti di persona in provincia di Torino e Cuneo: Carmagnola,
          Carignano, Racconigi, Bra, Savigliano, Cherasco e dintorni. Per il resto d’Italia lavoriamo
          da remoto, con la stessa cura.
        </p>
      </div>
      <a href="/contattaci/" class="b-btn b-btn--primary b-btn--lg" data-track="cta_click" data-track-location="about_local">
        Fissa un incontro <span class="b-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .ab {
    display: grid;
    gap: 3rem;
    align-items: start;
  }
  @media (min-width: 960px) {
    .ab {
      grid-template-columns: 0.75fr 1.25fr;
      gap: 5rem;
    }
  }
  .ab__card img {
    display: block;
    width: 140px;
    height: auto;
    margin-bottom: 2rem;
  }
  .ab__card dl {
    margin: 0;
  }
  .ab__card dl div {
    display: flex;
    justify-content: space-between;
    padding: 0.85rem 0;
    border-top: 1px solid var(--b-line);
    font-size: 0.92rem;
  }
  .ab__card dt {
    color: var(--b-fg-3);
  }
  .ab__card dd {
    margin: 0;
    color: var(--b-fg);
    font-weight: 500;
  }
  .ab__text {
    display: grid;
    gap: 1.1rem;
    margin-top: 2rem;
  }
  .ab__text strong {
    color: var(--b-fg);
  }
  .vals {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 760px) {
    .vals {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .vals {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .ab__marquee {
    margin-top: 4rem;
  }
  .ab__local {
    display: grid;
    gap: 2rem;
    align-items: end;
  }
  @media (min-width: 960px) {
    .ab__local {
      grid-template-columns: 1fr auto;
      gap: 4rem;
    }
  }
</style>
