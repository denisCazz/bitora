---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Siti Web ed E-commerce per PMI in Piemonte | Bitora"
  description="Bitora realizza siti web ed e-commerce su misura per PMI in Piemonte: SEO, performance, integrazioni e supporto. Guarda i progetti e richiedi un preventivo."
>
  <div class="home">
    <!-- HERO -->
    <section class="hero">
      <div class="hero-media" aria-hidden="true">
        <img src="/programming.jpg" alt="" class="hero-img" fetchpriority="high" decoding="async" />
        <div class="hero-scrim"></div>
      </div>

      <div class="shell hero-copy">
        <p class="eyebrow hero-item">Siti web · E-commerce · Piemonte</p>
        <h1 class="display hero-item">
          Siti web ed e-commerce<br /> su misura per PMI
        </h1>
        <p class="lede hero-item">
          Progettiamo esperienze veloci, credibili e misurabili: dal sito vetrina al negozio online,
          con SEO, contenuti, integrazioni e supporto dopo il lancio.
        </p>
        <div class="cta-row hero-item">
          <a
            href="/contattaci/?topic=sito"
            class="sl-btn-primary"
            data-track="cta_click"
            data-track-location="home_hero">Richiedi un preventivo</a
          >
          <a href="/lavori/" class="sl-btn-secondary">Guarda i progetti</a>
        </div>
        <p class="hero-alt hero-item">
          Cerchi una piattaforma operativa?
          <a href="/gestione-interventi/">Software per interventi, ticket e rapportini</a>
        </p>
      </div>

      <a href="#problema" class="hero-scroll" aria-label="Scorri">
        <span></span>
      </a>
    </section>

    <!-- PROBLEMA -->
    <section id="problema" class="band">
      <div class="shell band-inner">
        <div class="split">
          <div class="split-lead" data-reveal>
            <p class="eyebrow">Il punto di partenza</p>
            <h2 class="headline">
              Un sito deve essere<br />chiaro, veloce e<br />
              <span class="text-secondary">capace di convertire.</span>
            </h2>
          </div>
          <div class="split-body">
            <p class="body-lg" data-reveal data-reveal-delay="1">
              Bitora parte dagli obiettivi commerciali e costruisce un percorso digitale coerente,
              dalla ricerca su Google fino alla richiesta di contatto o all'ordine.
            </p>
            <ul class="list-rows" data-reveal-group>
              {
                [
                  {
                    n: '01',
                    t: 'Poche richieste',
                    d: 'Il traffico arriva, ma il valore dell’offerta non è immediato.',
                  },
                  {
                    n: '02',
                    t: 'Immagine poco credibile',
                    d: 'Design, contenuti e prove non raccontano la qualità reale.',
                  },
                  {
                    n: '03',
                    t: 'Gestione frammentata',
                    d: 'Sito, catalogo, ordini e contatti non lavorano insieme.',
                  },
                ].map(item => (
                  <li class="list-row" data-reveal>
                    <span class="list-num">{item.n}</span>
                    <div>
                      <h3 class="list-title">{item.t}</h3>
                      <p class="body-sm">{item.d}</p>
                    </div>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- FLUSSO -->
    <section class="band band-alt">
      <div class="shell band-inner">
        <header class="band-head" data-reveal>
          <p class="eyebrow">Come lavoriamo</p>
          <h2 class="headline">
            Dal brief<br />al lancio.
          </h2>
          <p class="body-lg" style="margin-top:1rem;max-width:40rem">
            Strategia, contenuti, sviluppo e misurazione restano nello stesso progetto, con un
            referente unico e obiettivi verificabili.
          </p>
        </header>

        <div class="flow" data-reveal-group>
          {
            [
              { n: '01', t: 'Strategia', d: 'Obiettivi, pubblico, struttura e priorità.' },
              { n: '02', t: 'Contenuti', d: 'Messaggi, prove, pagine e call to action.' },
              { n: '03', t: 'Sviluppo', d: 'Performance, mobile, SEO e integrazioni.' },
              { n: '04', t: 'Misurazione', d: 'Analytics, Search Console e miglioramenti.' },
            ].map((step, i) => (
              <article class="flow-cell" data-reveal data-reveal-delay={String(i + 1)}>
                <span class="flow-num">{step.n}</span>
                <div>
                  <h3 class="list-title">{step.t}</h3>
                  <p class="body-sm">{step.d}</p>
                </div>
              </article>
            ))
          }
        </div>

        <div class="band-foot" data-reveal data-reveal-delay="2">
          <a href="/siti-web-professionali/" class="text-link">
            Scopri come realizziamo i siti
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- PER CHI -->
    <section class="audience">
      <div class="audience-media" aria-hidden="true">
        <img src="/communication.jpg" alt="" class="audience-img" loading="lazy" decoding="async" />
        <div class="audience-scrim"></div>
      </div>
      <div class="shell audience-copy" data-reveal>
        <p class="eyebrow">Per chi</p>
        <h2 class="display-sm">
          PMI che vogliono<br />crescere online.
        </h2>
        <p class="lede audience-lede">
          Per aziende che cercano una presenza digitale credibile, più richieste qualificate e
          strumenti semplici da gestire.
        </p>
        <a
          href="/contattaci/?topic=sito"
          class="sl-btn-primary"
          data-track="cta_click"
          data-track-location="home_audience">Parlaci del progetto</a
        >
      </div>
    </section>

    <!-- DUE STRADE -->
    <section class="band">
      <div class="shell band-inner">
        <header class="band-head" data-reveal>
          <p class="eyebrow">Due strade, un partner</p>
          <h2 class="headline">Scegli il punto di partenza.</h2>
        </header>
        <div class="paths" data-reveal-group>
          <div class="path-cell" data-reveal>
            <p class="eyebrow">Strada A</p>
            <h3 class="list-title">Voglio un sito o un e-commerce.</h3>
            <p class="body-sm" style="margin-top:.5rem">
              Sito vetrina, negozio online o restyle: presenza credibile e richieste che arrivano.
            </p>
            <div class="cta-row" style="margin-top:1.5rem">
              <a href="/siti-web-professionali/" class="sl-btn-secondary">Siti web</a>
              <a href="/e-commerce/" class="sl-btn-secondary">E-commerce</a>
            </div>
          </div>
          <div class="path-cell" data-reveal data-reveal-delay="1">
            <p class="eyebrow">Strada B</p>
            <h3 class="list-title">Voglio pratiche digitalizzate.</h3>
            <p class="body-sm" style="margin-top:.5rem">
              Richieste, interventi, rapportini e firme in un sistema unico, adattato al tuo
              processo.
            </p>
            <div class="cta-row" style="margin-top:1.5rem">
              <a href="/gestione-interventi/" class="sl-btn-secondary">Ecosistema</a>
              <a
                href="/richiedi-demo/"
                class="sl-btn-primary"
                data-track="cta_click"
                data-track-location="home_paths">Demo</a
              >
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- OFFERTA -->
    <section class="band">
      <div class="shell band-inner">
        <div class="split split-offer">
          <div class="split-lead" data-reveal>
            <p class="eyebrow">Metodo</p>
            <h2 class="headline">
              Un progetto chiaro.<br />Nessun pacchetto standard.
            </h2>
            <p class="body-lg offer-copy">
              Definiamo insieme obiettivi, contenuti, funzionalità e tempi. Il preventivo separa ciò
              che serve ora dalle evoluzioni successive.
            </p>
            <a
              href="/contattaci/"
              class="sl-btn-primary"
              data-track="cta_click"
              data-track-location="home_offer">Richiedi un confronto</a
            >
          </div>
          <div class="split-body" data-reveal data-reveal-delay="1">
            <div class="offer-rows">
              {
                [
                  { t: 'Analisi', d: 'Obiettivi, pubblico e priorità' },
                  { t: 'Progetto', d: 'Design, contenuti e sviluppo' },
                  { t: 'Lancio', d: 'Test, SEO, tracking e formazione' },
                  { t: 'Supporto', d: 'Manutenzione ed evoluzioni concordate' },
                ].map(row => (
                  <div class="offer-row">
                    <span class="offer-label">{row.t}</span>
                    <span class="offer-value">{row.d}</span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVIZI -->
    <section class="band band-alt" id="servizi">
      <div class="shell band-inner">
        <header class="band-head" data-reveal>
          <p class="eyebrow">Tutti i servizi</p>
          <h2 class="headline">Dal sito vetrina alle pratiche digitalizzate</h2>
        </header>

        <div class="services" data-reveal-group>
          <a href="/siti-web-professionali/" class="service-cell" data-reveal>
            <div>
              <p class="service-num">01 · Siti web</p>
              <h3 class="service-title">Siti web professionali</h3>
              <p class="body-sm">Vetrine veloci, SEO e contenuti per farti trovare e contattare.</p>
            </div>
            <span class="service-cta">Scopri <span aria-hidden="true">→</span></span>
          </a>
          <a href="/e-commerce/" class="service-cell" data-reveal data-reveal-delay="1">
            <div>
              <p class="service-num">02 · E-commerce</p>
              <h3 class="service-title">E-commerce</h3>
              <p class="body-sm">Negozi online su misura: catalogo, pagamenti e gestione ordini.</p>
            </div>
            <span class="service-cta">Scopri <span aria-hidden="true">→</span></span>
          </a>
          <a href="/gestione-interventi/" class="service-cell" data-reveal data-reveal-delay="2">
            <div>
              <p class="service-num">03 · Soluzioni tailormade</p>
              <h3 class="service-title">Ecosistema e pratiche</h3>
              <p class="body-sm">Rapportini, ticketing e pratiche adattabili al tuo processo.</p>
            </div>
            <span class="service-cta">Scopri <span aria-hidden="true">→</span></span>
          </a>
        </div>

        <div class="band-foot" data-reveal data-reveal-delay="3">
          <a href="/servizi/" class="text-link">
            Panoramica completa dei servizi
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="band band-cta" id="demo">
      <div class="shell band-cta-inner" data-reveal>
        <p class="eyebrow">Inizia da qui</p>
        <h2 class="display-cta">
          Raccontaci il progetto.<br />Prepariamo il percorso.
        </h2>
        <p class="lede cta-lede">
          Sito vetrina, e-commerce o restyle: partiamo dagli obiettivi e ti rispondiamo entro 24
          ore.
        </p>

        <ol class="cta-steps">
          <li>
            <span class="cta-step-n">1</span>
            <div><strong>2 minuti</strong><span>Raccontaci azienda e obiettivi</span></div>
          </li>
          <li>
            <span class="cta-step-n">2</span>
            <div><strong>Entro 24 ore</strong><span>Ti ricontattiamo noi</span></div>
          </li>
          <li>
            <span class="cta-step-n">3</span>
            <div><strong>Proposta chiara</strong><span>Priorità, tempi e prossimi passi</span></div>
          </li>
        </ol>

        <div class="cta-row cta-row-center">
          <a
            href="/contattaci/?topic=sito"
            class="sl-btn-primary sl-btn-lg"
            data-track="cta_click"
            data-track-location="home_final"
          >
            Richiedi un preventivo
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="https://wa.me/393514979670?text=Ciao%2C%20vorrei%20parlarvi%20di%20un%20sito%20web%20o%20e-commerce."
            class="sl-btn-whatsapp"
            data-track="whatsapp_click"
            data-track-location="home_final">Scrivici su WhatsApp</a
          >
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Scroll reveals with stagger support
  const reveals = document.querySelectorAll('[data-reveal]');
  if (reduced) {
    reveals.forEach(el => el.classList.add('is-visible'));
  } else {
    const obs = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const delay = Number(el.dataset.revealDelay || 0);
          el.style.transitionDelay = `${delay * 90}ms`;
          el.classList.add('is-visible');
          obs.unobserve(el);
        });
      },
      { threshold: 0.14, rootMargin: '0px 0px -8% 0px' }
    );
    reveals.forEach(el => obs.observe(el));
  }

  // Subtle hero parallax + fade on scroll
  const hero = document.querySelector('.hero') as HTMLElement | null;
  const heroMedia = document.querySelector('.hero-media') as HTMLElement | null;
  const heroCopy = document.querySelector('.hero-copy') as HTMLElement | null;
  const heroScroll = document.querySelector('.hero-scroll') as HTMLElement | null;

  if (!reduced && hero && heroMedia && heroCopy) {
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const h = hero.offsetHeight;
        const y = Math.min(window.scrollY, h);
        const p = y / h;
        heroMedia.style.transform = `translate3d(0, ${y * 0.28}px, 0) scale(${1.04 - p * 0.04})`;
        heroCopy.style.opacity = String(Math.max(0, 1 - p * 1.35));
        heroCopy.style.transform = `translate3d(0, ${y * 0.18}px, 0)`;
        if (heroScroll) heroScroll.style.opacity = String(Math.max(0, 1 - p * 3));
        ticking = false;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

<style>
  .home {
    --home-bg: #000000;
    --home-bg-alt: #0d0d0f;
    --home-surface: #141416;
    --home-text: #f5f5f7;
    --home-secondary: #a1a1a6;
    --home-muted: #86868b;
    --home-faint: #8e8e93;
    --home-line: rgba(255, 255, 255, 0.14);
    --home-line-soft: rgba(255, 255, 255, 0.1);
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --shell: min(1120px, calc(100% - 3rem));
    background: var(--home-bg);
    color: var(--home-text);
    overflow-x: clip;
    -webkit-font-smoothing: antialiased;
  }

  @media (min-width: 768px) {
    .home {
      --shell: min(1120px, calc(100% - 6rem));
    }
  }
  @media (min-width: 1024px) {
    .home {
      --shell: min(1120px, calc(100% - 8rem));
    }
  }

  .shell {
    width: var(--shell);
    margin-inline: auto;
  }

  .text-secondary {
    color: var(--home-secondary);
  }

  /* ——— Type ——— */
  .eyebrow {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--home-muted);
    margin: 0 0 1.25rem;
  }

  .display {
    font-size: clamp(3rem, 8vw, 6.25rem);
    font-weight: 700;
    line-height: 0.94;
    letter-spacing: -0.04em;
    margin: 0 0 1.5rem;
    color: var(--home-text);
  }

  .display-sm {
    font-size: clamp(2.4rem, 5.5vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.02;
    margin: 0 0 1.25rem;
    color: var(--home-text);
  }

  .display-cta {
    font-size: clamp(2.4rem, 6.5vw, 5rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin: 0 0 1.25rem;
    color: var(--home-text);
  }

  .headline {
    font-size: clamp(2.1rem, 4.2vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin: 0;
    color: var(--home-text);
  }

  .lede {
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.55;
    color: var(--home-secondary);
    margin: 0 0 2.25rem;
    max-width: 28rem;
  }

  .body-lg {
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--home-secondary);
    margin: 0;
  }

  .body-sm {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--home-muted);
    margin: 0;
  }

  /* ——— Bands ——— */
  .band {
    border-top: 1px solid var(--home-line-soft);
  }

  .band-alt {
    background: var(--home-bg-alt);
  }

  .band-inner {
    padding: clamp(4.5rem, 10vw, 8rem) 0;
  }

  .band-head {
    margin-bottom: clamp(2.5rem, 5vw, 3.75rem);
    max-width: 36rem;
  }

  .band-foot {
    margin-top: 2rem;
  }

  .band-cta {
    text-align: center;
    position: relative;
    background:
      radial-gradient(ellipse 80% 60% at 50% 100%, rgba(255, 255, 255, 0.06) 0%, transparent 55%),
      var(--home-bg);
  }

  .band-cta-inner {
    padding: clamp(5.5rem, 12vw, 9rem) 0 clamp(4.5rem, 10vw, 7rem);
    max-width: 52rem;
  }

  .cta-steps {
    list-style: none;
    margin: 0 auto 2.75rem;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    max-width: 40rem;
    text-align: left;
  }

  @media (min-width: 768px) {
    .cta-steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
  }

  .cta-steps li {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding: 1.15rem 1.1rem;
    border: 1px solid var(--home-line-soft);
    border-radius: 1.1rem;
    background: rgba(255, 255, 255, 0.03);
  }

  .cta-step-n {
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 700;
    background: #f5f5f7;
    color: #000;
  }

  .cta-steps strong {
    display: block;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--home-text);
    margin-bottom: 0.2rem;
  }

  .cta-steps span {
    display: block;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--home-muted);
  }

  .sl-btn-lg {
    padding: 1.05rem 1.9rem;
    font-size: 1rem;
  }

  .sl-btn-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.9rem 1.7rem;
    border-radius: 980px;
    white-space: nowrap;
    color: #fff;
    background: #1f8f4e;
    border: 1px solid transparent;
    transition:
      background 0.25s,
      transform 0.25s var(--ease-out);
  }
  .sl-btn-whatsapp:hover {
    background: #22a358;
    transform: translateY(-1px);
  }

  /* ——— Split ——— */
  .split {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  @media (min-width: 1024px) {
    .split {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
      align-items: end;
    }
    .split-offer {
      align-items: center;
    }
  }

  .split-body .body-lg {
    margin-bottom: 2.5rem;
    max-width: 28rem;
  }

  .offer-copy {
    margin: 1.75rem 0 2rem;
    max-width: 26rem;
  }

  /* ——— Hero ——— */
  .hero {
    position: relative;
    min-height: 100svh;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-bottom: clamp(5rem, 12vh, 8rem);
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    will-change: transform;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
    transform: scale(1.08);
    animation: heroKen 20s var(--ease-out) forwards;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.45) 40%, #000 100%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.65) 0%, rgba(0, 0, 0, 0.15) 55%, transparent 100%);
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    will-change: transform, opacity;
  }

  .hero-item {
    opacity: 0;
    transform: translate3d(0, 28px, 0);
    animation: riseIn 1.05s var(--ease-out) forwards;
  }
  .hero-item:nth-child(1) {
    animation-delay: 0.1s;
  }
  .hero-item:nth-child(2) {
    animation-delay: 0.26s;
  }
  .hero-item:nth-child(3) {
    animation-delay: 0.42s;
  }
  .hero-item:nth-child(4) {
    animation-delay: 0.56s;
  }
  .hero-item:nth-child(5) {
    animation-delay: 0.7s;
  }

  .hero-alt {
    margin-top: 1.25rem;
    font-size: 0.9rem;
    color: var(--home-muted);
  }
  .hero-alt a {
    color: var(--home-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(255, 255, 255, 0.4);
    transition: text-decoration-color 0.2s;
  }
  .hero-alt a:hover {
    text-decoration-color: rgba(255, 255, 255, 0.9);
  }

  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: 1.75rem;
    z-index: 3;
    width: 24px;
    height: 38px;
    margin-left: -12px;
    border: 1.5px solid rgba(255, 255, 255, 0.35);
