---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ui/ProjectCard.astro';
import ShotMarquee from '../components/ui/ShotMarquee.astro';
import FaqList from '../components/ui/FaqList.astro';
import { pillars, whatsappLink } from '../data/services';
import { getWork, getWorkBySlugs } from '../data/work';
import { testimonials } from '../data/testimonials';
import { clientLogos } from '../data/clients';
import { homeFaq as faq } from '../data/faq';

const work = getWork();
const liveProjects = work.filter(w => !w.isWip).length;
const featured = getWorkBySlugs(['garavella-7', 'mistral-gestionale']);
const more = getWorkBySlugs(['ricambixstufe', 'accessi-aziendali-franchina', 'dalina', 'sartoria-kristina']);

const quotes = ['Mistral Impianti', 'Sartoria Kristina', 'Speedy Pizza', 'Bar Chantilly Carmagnola']
  .map(c => testimonials.find(t => t.company === c))
  .filter((t): t is NonNullable<typeof t> => Boolean(t));

const month = new Intl.DateTimeFormat('it-IT', { month: 'long', year: 'numeric' }).format(new Date());

const pains = [
  {
    q: '“Il sito c’è, ma non chiama nessuno.”',
    a: 'Lento, datato, introvabile su Google. Lo rifacciamo per portare richieste vere, non solo visite.',
  },
  {
    q: '“Gestiamo tutto con Excel, WhatsApp e post-it.”',
    a: 'Ordini, interventi, magazzino e clienti in un gestionale unico, costruito sul tuo modo di lavorare.',
  },
  {
    q: '“Perdiamo ore in lavoro ripetitivo.”',
    a: 'Preventivi, report, email e promemoria che si fanno da soli. L’AI lavora, il team decide.',
  },
];

const reasons = [
  {
    t: 'Un solo referente',
    d: 'Parli sempre con chi progetta e scrive il codice. Niente rimpalli tra agenzia, grafico e sviluppatore.',
  },
  {
    t: 'Tutto collegato',
    d: 'Sito, gestionale e app parlano tra loro. Il menu online si aggiorna dal magazzino, le richieste finiscono nel CRM.',
  },
  {
    t: 'Codice su misura, veloce',
    d: 'Niente template pesanti: siti che si aprono in meno di un secondo e software che fa solo quello che ti serve.',
  },
  {
    t: 'È tutto tuo',
    d: 'Dominio, codice e dati restano di tua proprietà. Nessun vincolo, nessun canone nascosto.',
  },
];

const steps = [
  { n: '01', t: 'Call conoscitiva', time: '30 min · gratis', d: 'Ci racconti obiettivi e problemi. Ti diciamo subito se e come possiamo aiutarti.' },
  { n: '02', t: 'Proposta chiara', time: 'entro 48 ore', d: 'Cosa facciamo, in che ordine, con che tempi e costi. Diviso in fasi, senza sorprese.' },
  { n: '03', t: 'Sviluppo visibile', time: 'anteprime settimanali', d: 'Vedi il progetto crescere online e dai feedback mentre lo costruiamo.' },
  { n: '04', t: 'Lancio e crescita', time: 'supporto continuo', d: 'Formazione, misurazione e miglioramenti. Non spariamo dopo la consegna.' },
];

---

<Layout
  title="Bitora · Siti web, e-commerce, gestionali e app su misura | Carmagnola (TO)"
  description="Studio digitale a Carmagnola: siti web che portano clienti, e-commerce, gestionali su misura, app mobile e AI per aziende in Piemonte e in Italia. Preventivo gratuito in 24 ore."
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__bg" aria-hidden="true">
      <picture>
        <source srcset="/hero-bitora.webp" type="image/webp" />
        <img src="/hero-bitora.jpg" alt="" width="1920" height="1074" fetchpriority="high" decoding="async" />
      </picture>
      <div class="hero__scrim"></div>
      <div class="hero__grid b-grid-bg"></div>
    </div>

    <div class="b-shell hero__inner">
      <p class="hero__status b-rise">
        <span class="hero__dot" aria-hidden="true"></span>
        Disponibili per nuovi progetti · {month}
      </p>
      <h1 class="b-display b-rise" style="animation-delay:.1s">
        Siti che vendono.<br />
        Software che <span class="b-grad">lavora&nbsp;per&nbsp;te.</span>
      </h1>
      <p class="b-lede b-rise" style="animation-delay:.22s">
        Siamo lo studio digitale di Carmagnola che costruisce siti, e-commerce, gestionali, app e
        automazioni AI per le aziende. Un unico referente, dal primo schizzo al supporto dopo il lancio.
      </p>
      <div class="b-cta-row b-rise" style="animation-delay:.34s">
        <a href="/contattaci/" class="b-btn b-btn--primary b-btn--lg" data-track="cta_click" data-track-location="home_hero">
          Preventivo gratuito in 24h <span class="b-arrow" aria-hidden="true">→</span>
        </a>
        <a href="#lavori" class="b-btn b-btn--ghost b-btn--lg">Guarda i lavori</a>
      </div>
      <div class="hero__proof b-rise" style="animation-delay:.46s">
        <div class="hero__faces" aria-hidden="true">
          {
            ['/logo_garavella.png', '/mistral.jpg', '/sartoria_kristina.png', '/logo_dalina.png', '/logo_natura.png'].map(src => (
              <img src={src} alt="" width="36" height="36" loading="lazy" />
            ))
          }
        </div>
        <p>
          <strong>{liveProjects}+ progetti online</strong> per attività e aziende tra Torino e Cuneo
        </p>
      </div>
    </div>
  </section>

  <!-- CLIENT STRIP -->
  <section class="strip" aria-label="Alcuni clienti">
    <div class="b-marquee" style="--b-marquee-speed:45s">
      {
        [0, 1].map(copy => (
          <div class="b-marquee__track" aria-hidden={copy === 1 ? 'true' : undefined}>
            {clientLogos.map(c => (
              <span class="strip__name">{c.name}</span>
            ))}
          </div>
        ))
      }
    </div>
  </section>

  <!-- PAINS -->
  <section class="b-section">
    <div class="b-shell">
      <div class="b-head" data-reveal>
        <p class="b-eyebrow">Ti suona familiare?</p>
        <h2 class="b-h2">Il digitale dovrebbe farti guadagnare tempo e clienti. <span class="b-accent">Non il contrario.</span></h2>
      </div>
      <div class="pains">
        {
          pains.map((p, i) => (
            <article class="b-card pains__card" data-reveal data-reveal-delay={String(i + 1)}>
              <p class="pains__q">{p.q}</p>
              <p class="b-text">{p.a}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PILLARS -->
  <section class="b-section b-section--alt b-section--line" id="soluzioni">
    <div class="b-shell">
      <div class="b-head b-head--split" data-reveal>
        <div>
          <p class="b-eyebrow">Cosa facciamo</p>
          <h2 class="b-h2">Tutto il tuo digitale. <br />Da un solo studio.</h2>
        </div>
        <p class="b-text">
          Puoi partire da un sito e arrivare a un gestionale con app e AI, senza cambiare fornitore e
          senza ricominciare da capo. Ogni pezzo è progettato per collegarsi al successivo.
        </p>
      </div>
      <div class="pillars">
        {
          pillars.map((p, i) => (
            <a href={p.href} class="b-card pillar" data-reveal data-reveal-delay={String((i % 3) + 1)}>
              <div class="pillar__top">
                <span class="b-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={p.icon} />
                  </svg>
                </span>
                <span class="b-mono pillar__n">{p.n}</span>
              </div>
              <p class="pillar__kicker">{p.kicker}</p>
              <h3 class="b-h3">{p.title}</h3>
              <p class="b-text pillar__short">{p.short}</p>
              <div class="b-chips">
                {p.bullets.map(b => <span class="b-chip">{b}</span>)}
              </div>
              <span class="pillar__go" aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- WORK -->
  <section class="b-section b-section--line" id="lavori">
    <div class="b-shell">
      <div class="b-head b-head--split" data-reveal>
        <div>
          <p class="b-eyebrow">Lavori</p>
          <h2 class="b-h2">Progetti veri. <span class="b-accent">Online adesso.</span></h2>
        </div>
        <p class="b-text">
          Dal bar in piazza all’azienda di impianti con 35 anni di storia: ogni progetto parte da un
          problema concreto e finisce con uno strumento che si usa ogni giorno.
        </p>
      </div>
      <div class="work-feat">
        {featured.map((w, i) => <div data-reveal data-reveal-delay={String(i + 1)}><ProjectCard item={w} size="lg" /></div>)}
      </div>
      <div class="work-more">
        {more.map((w, i) => <div data-reveal data-reveal-delay={String((i % 4) + 1)}><ProjectCard item={w} /></div>)}
      </div>
      <div class="work-cta" data-reveal>
        <a href="/lavori/" class="b-btn b-btn--ghost">Vedi tutti i {work.length} progetti <span class="b-arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="work-marquee" data-reveal>
      <ShotMarquee />
    </div>
  </section>

  <!-- CONNECTED: GARAVELLA STORY -->
  <section class="b-section b-section--alt b-section--line">
    <div class="b-shell story">
      <div data-reveal>
        <p class="b-eyebrow">Il nostro vantaggio</p>
        <h2 class="b-h2">Quando sito e gestionale <span class="b-grad">si parlano</span>, succedono cose.</h2>
        <p class="b-lede">
          Da Garavella 7, a Carmagnola, se un ingrediente finisce in magazzino i piatti che lo usano
          spariscono da soli dal menu sul sito. Nessuno deve ricordarsi di aggiornarlo.
        </p>
        <p class="b-text story__p">
          È questo che intendiamo con “software che lavora per te”: strumenti collegati che tolgono
          lavoro invece di aggiungerne.
        </p>
        <a href="/progetti/garavella-7-gestionale/" class="b-link">Leggi il caso Garavella 7 <span aria-hidden="true">→</span></a>
      </div>
      <div class="flow" data-reveal data-reveal-delay="1" aria-hidden="true">
        <div class="flow__node">
          <span class="b-mono">Magazzino</span>
          <b>Spritz Aperol</b>
          <em class="is-out">Scorte: 0</em>
        </div>
        <div class="flow__line"><i></i></div>
        <div class="flow__node">
          <span class="b-mono">Gestionale</span>
          <b>Menu aggiornato</b>
          <em>2 voci nascoste</em>
        </div>
        <div class="flow__line"><i></i></div>
        <div class="flow__node is-live">
          <span class="b-mono">garavella7.it</span>
          <b>Menu online</b>
          <em class="is-ok">Allineato in tempo reale</em>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="b-section b-section--line">
    <div class="b-shell">
      <div class="b-head" data-reveal>
        <p class="b-eyebrow">Perché Bitora</p>
        <h2 class="b-h2">Uno studio piccolo, <br />di proposito.</h2>
      </div>
      <div class="reasons">
        {
          reasons.map((r, i) => (
            <div class="reason" data-reveal data-reveal-delay={String(i + 1)}>
              <span class="b-mono reason__n">0{i + 1}</span>
              <h3 class="b-h3">{r.t}</h3>
              <p class="b-text">{r.d}</p>
            </div>
          ))
        }
      </div>
      <div class="b-kpis why__kpis" data-reveal>
        <div class="b-kpi"><div class="b-kpi__v">{liveProjects}+</div><div class="b-kpi__l">Progetti pubblicati</div></div>
        <div class="b-kpi"><div class="b-kpi__v">24h</div><div class="b-kpi__l">Tempo di risposta</div></div>
        <div class="b-kpi"><div class="b-kpi__v">2020</div><div class="b-kpi__l">Attivi dal</div></div>
        <div class="b-kpi"><div class="b-kpi__v">100%</div><div class="b-kpi__l">Sviluppato in Italia</div></div>
      </div>
    </div>
  </section>

  <!-- AI BAND -->
  <section class="b-section b-section--alt b-section--line ai">
    <div class="b-glow-orb ai__orb" aria-hidden="true"></div>
    <div class="b-shell ai__inner">
      <div class="b-head" data-reveal>
        <p class="b-eyebrow">AI & automazioni</p>
        <h2 class="b-h2">Intelligenza artificiale <span class="b-accent">concreta</span>. <br />Non slide.</h2>
        <p class="b-lede">
          Usiamo l’AI dove fa risparmiare ore misurabili, collegata ai tuoi dati e ai tuoi documenti.
        </p>
      </div>
      <div class="ai__grid">
        <article class="b-card" data-reveal data-reveal-delay="1">
          <p class="b-mono ai__tag">Preventivi</p>
          <h3 class="b-h3">Bozza pronta in minuti</h3>
          <p class="b-text">L’AI legge documenti e lavori passati e prepara il preventivo. L’ufficio rivede ed esporta in PDF.</p>
          <a href="/progetti/mistral-gestionale/" class="b-link ai__link">Caso Mistral Impianti →</a>
        </article>
        <article class="b-card" data-reveal data-reveal-delay="2">
          <p class="b-mono ai__tag">Assistenti</p>
          <h3 class="b-h3">Chiedi ai tuoi documenti</h3>
          <p class="b-text">Manuali, schede tecniche, procedure: il team fa una domanda e ottiene la risposta con la fonte.</p>
        </article>
        <article class="b-card" data-reveal data-reveal-delay="3">
          <p class="b-mono ai__tag">Crescita</p>
          <h3 class="b-h3">Lead e contenuti automatici</h3>
          <p class="b-text">Ricerca di potenziali clienti, articoli del blog e report che si preparano da soli, con te che approvi.</p>
        </article>
      </div>
      <div data-reveal>
        <a href="/intelligenza-artificiale/" class="b-btn b-btn--ghost">Scopri cosa può fare l’AI per te <span class="b-arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="b-section b-section--line" id="metodo">
    <div class="b-shell">
      <div class="b-head b-head--split" data-reveal>
        <div>
          <p class="b-eyebrow">Come lavoriamo</p>
          <h2 class="b-h2">Dalla prima call al lancio, <span class="b-accent">senza sorprese.</span></h2>
        </div>
        <p class="b-text">Sai sempre cosa stiamo facendo, quanto manca e quanto costa. Il primo passo è gratuito.</p>
      </div>
      <ol class="b-steps steps">
        {
          steps.map((s, i) => (
            <li class="b-card" data-reveal data-reveal-delay={String(i + 1)}>
              <span class="b-step__n">{s.n}</span>
              <h3 class="b-h3 b-step__t">{s.t}</h3>
              <p class="steps__time b-mono">{s.time}</p>
              <p class="b-text">{s.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="b-section b-section--alt b-section--line">
    <div class="b-shell">
      <div class="b-head" data-reveal>
        <p class="b-eyebrow">Dicono di noi</p>
        <h2 class="b-h2">Clienti che ci <span class="b-accent">consigliano</span>.</h2>
      </div>
      <div class="quotes">
        {
          quotes.map((t, i) => (
            <figure class="b-card quote" data-reveal data-reveal-delay={String((i % 2) + 1)}>
              <div class="quote__stars" aria-label="5 stelle su 5">★★★★★</div>
              <blockquote>“{t.quote}”</blockquote>
              <figcaption>
                <img src={t.image} alt="" width="44" height="44" loading="lazy" />
                <span>
                  <strong>{t.author}</strong>
                  <small>{t.role} · {t.company}</small>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SHOP NFC -->
  <section class="b-section b-section--tight b-section--line">
    <div class="b-shell">
      <a href="https://shopnfc.bitora.it/" class="b-card nfc" rel="noopener" data-track="cta_click" data-track-location="home_shopnfc" data-reveal>
        <div>
          <p class="b-eyebrow">Novità · Shop NFC Bitora</p>
          <h2 class="b-h2 nfc__title">Tessere, tag e lettori NFC. <br /><span class="b-accent">Programmazione inclusa.</span></h2>
          <p class="b-text">Recensioni Google con un tap, biglietti da visita smart, tag industriali. Da 10 a 100.000 pezzi, spediti in tutta Italia.</p>
          <span class="b-btn b-btn--light nfc__btn">Entra nello shop <span class="b-arrow" aria-hidden="true">→</span></span>
        </div>
        <picture class="nfc__img">
          <source srcset="/shop-nfc-products.webp" type="image/webp" />
          <img src="/shop-nfc-products.jpg" alt="Tessere, tag, braccialetto e lettore NFC Bitora" width="1024" height="1024" loading="lazy" decoding="async" />
        </picture>
      </a>
    </div>
  </section>

  <FaqList items={faq} />

  <section class="b-section b-section--tight b-section--line">
    <div class="b-shell quick" data-reveal>
      <p class="b-h3">Preferisci parlarne a voce?</p>
      <div class="quick__btns">
        <a href="tel:+393514979670" class="b-btn b-btn--ghost" data-track="phone_click" data-track-location="home_quick">Chiama +39 351 497 9670</a>
        <a href={whatsappLink('Ciao Bitora, vorrei fissare una call conoscitiva.')} class="b-btn b-btn--wa" data-track="whatsapp_click" data-track-location="home_quick" target="_blank" rel="noopener">WhatsApp</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: calc(72px + 3rem) 0 4rem;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
  }
  .hero__bg picture,
  .hero__bg img {
    width: 100%;
    height: 100%;
    display: block;
  }
  .hero__bg img {
    object-fit: cover;
    object-position: 70% center;
    animation: heroZoom 18s var(--b-ease) forwards;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(5, 6, 7, 0.96) 0%, rgba(5, 6, 7, 0.8) 38%, rgba(5, 6, 7, 0.2) 70%, rgba(5, 6, 7, 0.1) 100%),
      linear-gradient(180deg, rgba(5, 6, 7, 0.4) 0%, transparent 25%, transparent 70%, var(--b-ink) 100%);
  }
  @media (max-width: 900px) {
    .hero__bg img {
      object-position: 78% center;
      opacity: 0.55;
    }
    .hero__scrim {
      background: linear-gradient(180deg, rgba(5, 6, 7, 0.6) 0%, rgba(5, 6, 7, 0.75) 50%, var(--b-ink) 100%);
    }
  }
  .hero__grid {
    position: absolute;
    inset: 0;
    opacity: 0.6;
  }
  .hero__inner {
    position: relative;
  }
  .hero__inner .b-display {
    max-width: 15ch;
  }
  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1.75rem;
    padding: 0.45rem 0.9rem 0.45rem 0.7rem;
    border-radius: 999px;
    border: 1px solid rgba(34, 211, 238, 0.3);
    background: rgba(34, 211, 238, 0.06);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--b-cyan-2);
  }
  .hero__dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #34d399;
  }
  .hero__dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid #34d399;
    animation: ping 2s ease-out infinite;
  }
  .hero__proof {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2.75rem;
    color: var(--b-fg-2);
    font-size: 0.92rem;
  }
  .hero__proof p {
    margin: 0;
    max-width: 22rem;
  }
  .hero__proof strong {
    color: var(--b-fg);
  }
  .hero__faces {
    display: flex;
    flex-shrink: 0;
  }
  .hero__faces img {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    background: #fff;
    border: 2px solid var(--b-ink);
    margin-left: -10px;
  }
  .hero__faces img:first-child {
    margin-left: 0;
  }

  /* Strip */
  .strip {
    border-block: 1px solid var(--b-line);
    padding: 1.4rem 0;
    background: var(--b-ink-2);
  }
  .strip .b-marquee__track {
    gap: 3rem;
    padding-right: 3rem;
  }
  .strip__name {
    font-family: var(--f-display);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--b-fg-3);
    white-space: nowrap;
  }
  .strip__name::after {
    content: '✦';
    margin-left: 3rem;
    color: rgba(34, 211, 238, 0.45);
    font-size: 0.7rem;
    vertical-align: middle;
  }

  /* Pains */
  .pains {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 900px) {
    .pains {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .pains__q {
    font-family: var(--f-display);
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--b-fg);
    margin: 0 0 1.25rem;
  }

  /* Pillars */
  .pillars {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 720px) {
    .pillars {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .pillars {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .pillar {
    display: flex !important;
    flex-direction: column;
    min-height: 320px;
  }
  .pillar__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }
  .pillar__n {
