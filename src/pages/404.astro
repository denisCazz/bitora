---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { pillars } from '../data/services';
---

<Layout title="Pagina non trovata | Bitora" description="La pagina richiesta non esiste. Ecco da dove ripartire." noindex={true}>
  <section class="nf">
    <div class="nf__bg b-grid-bg" aria-hidden="true"></div>
    <div class="b-glow-orb nf__orb" aria-hidden="true"></div>
    <div class="b-shell nf__inner">
      <p class="nf__code b-outline" aria-hidden="true">404</p>
      <h1 class="b-h1">Questa pagina <span class="b-grad">non esiste</span>.</h1>
      <p class="b-lede">Forse è stata spostata. Riparti da qui:</p>
      <div class="b-cta-row">
        <a href="/" class="b-btn b-btn--primary">Torna alla home</a>
        <a href="/contattaci/" class="b-btn b-btn--ghost">Contattaci</a>
      </div>
      <div class="nf__links">
        {pillars.map(p => <a href={p.href} class="b-chip">{p.title}</a>)}
        <a href="/lavori/" class="b-chip">Lavori</a>
        <a href="/blog/" class="b-chip">Blog</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .nf {
    position: relative;
    overflow: hidden;
    min-height: 90svh;
    display: flex;
    align-items: center;
    padding: calc(72px + 3rem) 0 4rem;
  }
  .nf__bg {
    position: absolute;
    inset: 0;
  }
  .nf__orb {
    top: -15rem;
    right: -15rem;
  }
  .nf__inner {
    position: relative;
  }
  .nf__code {
    margin: 0 0 1rem;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(6rem, 22vw, 14rem);
    line-height: 0.85;
    letter-spacing: -0.05em;
  }
  .nf__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2.5rem;
  }
  .nf__links a {
    text-decoration: none;
  }
  .nf__links a:hover {
    color: var(--b-cyan);
    border-color: rgba(34, 211, 238, 0.4);
    opacity: 1;
  }
</style>
