---
export const prerender = true;
import ServiceLanding from '../components/ui/ServiceLanding.astro';
---

<ServiceLanding
  pillar="ecommerce"
  topic="ecommerce"
  seo={{
    title: 'E-commerce su misura B2C e B2B | Bitora, Piemonte',
    description:
      'Negozi online su misura per aziende in Piemonte e in Italia: catalogo, pagamenti Stripe e PayPal, spedizioni, listini B2B e integrazione con il gestionale. Preventivo gratuito.',
  }}
  hero={{
    eyebrow: 'E-commerce',
    title: 'Il tuo negozio online, <span class="b-grad">aperto 24 ore su 24</span>.',
    lede: 'Costruiamo e-commerce che vendono davvero: catalogo chiaro, checkout veloce, pagamenti sicuri e una gestione ordini che non ti ruba la giornata. Per privati e per rivenditori.',
    chips: ['Stripe, PayPal, bonifico', 'Listini B2B', 'Spedizioni integrate', 'Google Shopping'],
  }}
  ctaLabel="Preventivo e-commerce gratuito"
  signals={{
    title: 'Vendere online è difficile <span class="b-accent">quando lo strumento è sbagliato</span>.',
    items: [
      { t: 'Carrelli abbandonati', d: 'Checkout lungo, costi di spedizione a sorpresa, pagamenti limitati. Il cliente arriva in fondo e se ne va.' },
      { t: 'Catalogo ingestibile', d: 'Centinaia di prodotti, varianti e compatibilità da aggiornare a mano su piattaforme rigide.' },
      { t: 'Ordini su più canali', d: 'Telefono, email, WhatsApp e sito: ordini sparsi e giacenze che non tornano mai.' },
      { t: 'Commissioni che mangiano margine', d: 'Marketplace e piattaforme che trattengono percentuali su ogni vendita.' },
      { t: 'Rivenditori trattati come privati', d: 'Nessun listino dedicato, nessun riordino rapido, preventivi fatti a mano.' },
      { t: 'Invisibile su Google', d: 'Le schede prodotto non compaiono nelle ricerche né su Google Shopping.' },
    ],
  }}
  deliverables={{
    title: 'Un e-commerce che <span class="b-accent">lavora mentre dormi</span>.',
    lede: 'Dalla scheda prodotto alla consegna: progettiamo l’intero flusso di vendita e lo colleghiamo ai tuoi strumenti.',
    items: [
      { t: 'Catalogo intelligente', d: 'Categorie, filtri, varianti e ricerca per modello o codice. Il cliente trova il prodotto giusto in pochi secondi.' },
      { t: 'Checkout senza attriti', d: 'Pochi passaggi, pagamenti con carta, PayPal, Apple Pay e bonifico. Costi chiari fin dall’inizio.' },
      { t: 'Area B2B', d: 'Accessi approvati, listini per cliente, riordini e preventivi per rivenditori e installatori.' },
      { t: 'Spedizioni e ordini', d: 'Calcolo costi, etichette, tracking e notifiche automatiche al cliente.' },
      { t: 'Integrazioni', d: 'Sincronizzazione con gestionale, fornitori e magazzino via API. Prezzi e giacenze sempre aggiornati.' },
      { t: 'SEO prodotto', d: 'Dati strutturati, Google Merchant Center e schede ottimizzate per le ricerche di prodotto.' },
    ],
  }}
  feature={{
    slug: 'ricambixstufe',
    eyebrow: 'Caso in evidenza',
    title: 'RicambiXStufe',
    text: 'E-commerce verticale per ricambi di stufe a pellet: un catalogo tecnico di centinaia di articoli, ricercabile per modello e marca, con pagamenti online e spedizioni in tutta Italia.',
    points: [
      'Catalogo per marca, modello e categoria',
      'Pagamenti PayPal e carta',
      'API partner per rivenditori collegati',
      'Gestione ordini e magazzino integrata',
    ],
  }}
  formats={{
    title: 'Tre modi per <span class="b-accent">iniziare a vendere</span>.',
    items: [
      {
        t: 'Shop essenziale',
        time: '3–4 settimane',
        d: 'Per chi vende un catalogo contenuto e vuole partire rapidamente.',
        bullets: ['Fino a 100 prodotti', 'Pagamenti e spedizioni', 'Email automatiche'],
      },
      {
        t: 'E-commerce su misura',
        time: '4–8 settimane',
        d: 'Catalogo ampio, filtri avanzati e integrazione con i tuoi strumenti.',
        bullets: ['Catalogo illimitato', 'Ricerca per modello/codice', 'Integrazione gestionale', 'Google Shopping'],
      },
      {
        t: 'B2B & multi-canale',
        time: '6–12 settimane',
        d: 'Per produttori e distributori che vendono a privati e rivenditori.',
        bullets: ['Listini per cliente', 'Area rivenditori', 'API e sincronizzazioni', 'Multilingua'],
      },
    ],
  }}
  projects={['ricambixstufe', 'barbara-toffano']}
  stack={['Next.js', 'PostgreSQL', 'Stripe', 'PayPal', 'Cloudflare R2', 'Google Merchant Center', 'Resend']}
  faq={[
    { question: 'Realizzate e-commerce B2B?', answer: 'Sì. Accessi approvati, cataloghi riservati, listini per cliente, preventivi, riordini e integrazioni con gestionali tramite API.' },
    { question: 'Quanto costa un e-commerce?', answer: 'Dipende da catalogo, integrazioni e funzioni. Dopo la call gratuita ricevi un preventivo modulare a prezzo fisso: parti dall’essenziale e aggiungi il resto quando serve.' },
    { question: 'Shopify, WooCommerce o su misura?', answer: 'Ti consigliamo la soluzione più adatta, anche se non è la più costosa. Per cataloghi tecnici, B2B e integrazioni complesse lo sviluppo su misura evita commissioni e limiti.' },
    { question: 'Quanto tempo serve per il lancio?', answer: 'Da 3–4 settimane per uno shop essenziale a 6–12 settimane per progetti B2B con integrazioni.' },
    { question: 'Gestite pagamenti, spedizioni e fatture?', answer: 'Sì: Stripe, PayPal, bonifico, corrieri nazionali e ritiro in negozio. Possiamo collegare la fatturazione al tuo gestionale.' },
    { question: 'Mi seguite anche dopo?', answer: 'Sì: monitoraggio, aggiornamenti, nuove funzioni e ottimizzazione delle conversioni. Non spariamo al lancio.' },
  ]}
/>
