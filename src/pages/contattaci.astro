---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { testimonials } from '../data/testimonials';
import { whatsappLink, phoneDisplay, phoneHref, email } from '../data/services';

const inviato = Astro.url.searchParams.get('inviato') === '1';
const topic = Astro.url.searchParams.get('topic') || '';
const topicMap: Record<string, string> = {
  sito: 'siti-web',
  ecommerce: 'e-commerce',
  sistemi: 'gestionali-crm',
  crm: 'gestionali-crm',
  cmms: 'gestione-interventi',
  interventi: 'gestione-interventi',
  demo: 'demo-gestione-interventi',
  app: 'app-mobile',
  ai: 'intelligenza-artificiale',
  nfc: 'nfc',
};
const preselected = topicMap[topic] ?? '';

const services = [
  { v: 'siti-web', l: 'Sito web' },
  { v: 'e-commerce', l: 'E-commerce' },
  { v: 'gestionali-crm', l: 'Gestionale / CRM' },
  { v: 'gestione-interventi', l: 'Interventi e rapportini' },
  { v: 'app-mobile', l: 'App mobile' },
  { v: 'intelligenza-artificiale', l: 'AI e automazioni' },
  { v: 'nfc', l: 'NFC' },
  { v: 'altro', l: 'Non lo so ancora' },
];

const budgets = ['Da definire', 'Fino a 2.000 €', '2.000 – 5.000 €', '5.000 – 15.000 €', 'Oltre 15.000 €'];
const timings = ['Il prima possibile', 'Entro 1–2 mesi', 'Entro 6 mesi', 'Sto valutando'];

const quote = testimonials.find(t => t.company === 'Mistral Impianti');
---

<Layout
  title="Contatti e preventivo gratuito | Bitora, Carmagnola (TO)"
  description="Raccontaci il tuo progetto: sito web, e-commerce, gestionale, app o AI. Rispondiamo entro 24 ore con una proposta concreta. Telefono, WhatsApp o modulo online."
  pageType="ContactPage"
>
  <section class="ct">
    <div class="ct__grid-bg b-grid-bg" aria-hidden="true"></div>
    <div class="b-glow-orb ct__orb" aria-hidden="true"></div>
    <div class="b-shell ct__inner">
      <div class="ct__intro">
        <p class="b-eyebrow b-rise">Contatti · Preventivo gratuito</p>
        <h1 class="b-h1 b-rise" style="animation-delay:.1s">Parliamo del tuo <span class="b-grad">progetto</span>.</h1>
        <p class="b-lede b-rise" style="animation-delay:.2s">
          Due minuti per raccontarci cosa ti serve. Entro 24 ore lavorative ti rispondiamo con domande
          mirate o con una prima proposta. Nessun impegno.
        </p>

        <ol class="ct__next b-rise" style="animation-delay:.3s">
          <li><span>1</span><div><strong>Ci scrivi</strong><small>Form, WhatsApp o telefono</small></div></li>
          <li><span>2</span><div><strong>Call di 30 minuti</strong><small>Gratuita, anche di persona in Piemonte</small></div></li>
          <li><span>3</span><div><strong>Proposta in 48 ore</strong><small>Fasi, tempi e prezzo fisso</small></div></li>
        </ol>

        <div class="ct__direct b-rise" style="animation-delay:.4s">
          <a href={whatsappLink('Ciao Bitora, vorrei un preventivo.')} class="b-btn b-btn--wa" data-track="whatsapp_click" data-track-location="contattaci" target="_blank" rel="noopener">WhatsApp</a>
          <a href={phoneHref} class="b-btn b-btn--ghost" data-track="phone_click" data-track-location="contattaci">{phoneDisplay}</a>
          <a href={`mailto:${email}`} class="b-btn b-btn--ghost">{email}</a>
        </div>

        {
          quote && (
            <figure class="ct__quote b-rise" style="animation-delay:.5s">
              <blockquote>“{quote.quote}”</blockquote>
              <figcaption>
                <img src={quote.image} alt="" width="40" height="40" loading="lazy" />
                <span><strong>{quote.author}</strong> · {quote.role}, {quote.company}</span>
              </figcaption>
            </figure>
          )
        }
      </div>

      <div class="ct__card b-rise" style="animation-delay:.2s">
        {
          inviato ? (
            <div class="ct__ok" role="status">
              <span class="ct__ok-icon" aria-hidden="true">✓</span>
              <h2 class="b-h2">Richiesta ricevuta.</h2>
              <p class="b-text">Grazie! Ti rispondiamo entro 24 ore lavorative. Se è urgente, scrivici su WhatsApp.</p>
              <div class="b-cta-row">
                <a href={whatsappLink('Ciao, ho appena inviato una richiesta dal sito.')} class="b-btn b-btn--wa" target="_blank" rel="noopener">WhatsApp</a>
                <a href="/lavori/" class="b-btn b-btn--ghost">Guarda i lavori</a>
              </div>
            </div>
          ) : (
            <form id="contact-form" action="/api/contact/" method="POST" novalidate>
              <input type="text" name="_gotcha" class="ct__hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
              <input type="hidden" name="_ts" value="" />

              <fieldset class="ct__fs">
                <legend class="b-label">Di cosa hai bisogno?</legend>
                <div class="ct__choices">
                  {services.map(s => (
                    <label class="b-choice">
                      <input type="radio" name="argomento" value={s.v} checked={preselected === s.v} />
                      <span>{s.l}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <div class="ct__row">
                <div class="b-field">
                  <label class="b-label" for="nome">Nome e cognome *</label>
                  <input class="b-input" type="text" id="nome" name="nome" required minlength="2" autocomplete="name" placeholder="Mario Rossi" />
                  <p id="nome-error" class="ct__err" hidden>Inserisci almeno 2 caratteri</p>
                </div>
                <div class="b-field">
                  <label class="b-label" for="azienda">Azienda</label>
                  <input class="b-input" type="text" id="azienda" name="azienda" autocomplete="organization" placeholder="Nome attività" />
                </div>
              </div>

              <div class="ct__row">
                <div class="b-field">
                  <label class="b-label" for="email">Email *</label>
                  <input class="b-input" type="email" id="email" name="email" required autocomplete="email" placeholder="nome@azienda.it" />
                  <p id="email-error" class="ct__err" hidden>Inserisci un indirizzo email valido</p>
                </div>
                <div class="b-field">
                  <label class="b-label" for="telefono">Telefono</label>
                  <input class="b-input" type="tel" id="telefono" name="telefono" autocomplete="tel" placeholder="+39 …" />
                </div>
              </div>

              <div class="ct__row">
                <div class="b-field">
                  <label class="b-label" for="budget">Budget indicativo</label>
                  <select class="b-input" id="budget" name="budget">
                    {budgets.map(b => <option value={b}>{b}</option>)}
                  </select>
                </div>
                <div class="b-field">
                  <label class="b-label" for="tempi">Tempistiche</label>
                  <select class="b-input" id="tempi" name="tempi">
                    {timings.map(t => <option value={t}>{t}</option>)}
                  </select>
                </div>
              </div>

              <div class="b-field">
                <label class="b-label" for="messaggio">Raccontaci il progetto *</label>
                <textarea class="b-input" id="messaggio" name="messaggio" rows="5" required minlength="10" placeholder="Cosa fai, cosa vorresti ottenere, cosa non funziona oggi…"></textarea>
                <p id="messaggio-error" class="ct__err" hidden>Scrivi almeno 10 caratteri</p>
              </div>

              <label class="ct__privacy">
                <input type="checkbox" id="privacy" name="privacy" required />
                <span>Ho letto la <a href="/privacy-policy/" target="_blank">privacy policy</a> e acconsento al trattamento dei dati per ricevere una risposta. *</span>
              </label>
              <p id="privacy-error" class="ct__err" hidden>Serve il consenso per poterti rispondere</p>

              <div id="form-error" class="ct__form-err" role="alert" hidden></div>

              <button type="submit" id="submit-btn" class="b-btn b-btn--primary b-btn--lg ct__submit">
                <span id="submit-label">Invia la richiesta</span>
                <span class="b-arrow" aria-hidden="true">→</span>
              </button>
              <p class="b-small ct__fine">Risposta entro 24 ore lavorative · Nessuno spam, mai.</p>
            </form>
          )
        }
      </div>
    </div>
  </section>
</Layout>

<script>
  type Tracker = Window & { bitoraTrack?: (n: string, p?: Record<string, string>) => void };

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const submitLabel = document.getElementById('submit-label');
  const errorEl = document.getElementById('form-error');

  const tsInput = form?.querySelector('[name="_ts"]') as HTMLInputElement | null;
  if (tsInput) tsInput.value = String(Date.now());

  const isEmail = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);

  function validate(f: HTMLFormElement) {
    const checks: [string, boolean][] = [
      ['nome', (f.elements.namedItem('nome') as HTMLInputElement).value.trim().length >= 2],
      ['email', isEmail((f.elements.namedItem('email') as HTMLInputElement).value.trim())],
      ['messaggio', (f.elements.namedItem('messaggio') as HTMLTextAreaElement).value.trim().length >= 10],
      ['privacy', (f.elements.namedItem('privacy') as HTMLInputElement).checked],
    ];
    let ok = true;
    for (const [id, valid] of checks) {
      const err = document.getElementById(`${id}-error`);
      if (err) err.hidden = valid;
      if (!valid) ok = false;
    }
    return ok;
  }

  ['nome', 'email', 'messaggio'].forEach(id => {
    document.getElementById(id)?.addEventListener('blur', () => form && validate(form));
  });

  form?.addEventListener('submit', async e => {
    e.preventDefault();
    if (!submitBtn || !errorEl || !validate(form)) return;

    submitBtn.disabled = true;
    if (submitLabel) submitLabel.textContent = 'Invio in corso…';
    errorEl.hidden = true;

    const data = new FormData(form);
    const extras = [
      `Budget: ${data.get('budget') || '-'}`,
      `Tempistiche: ${data.get('tempi') || '-'}`,
    ].join('\n');
    data.set('messaggio', `${String(data.get('messaggio') || '').trim()}\n\n${extras}`);
    const params = new URLSearchParams(window.location.search);
    ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'gclid', 'fbclid'].forEach(k => {
      const v = params.get(k);
      if (v) data.set(k, v);
    });
    data.set('landing_page', window.location.pathname);
    if (document.referrer) data.set('referrer', document.referrer);

    try {
      const res = await fetch('/api/contact/', { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      const isJson = (res.headers.get('content-type') || '').includes('application/json');
      const payload = isJson ? await res.json().catch(() => null) : null;
      if (res.ok && payload?.ok) {
        (window as Tracker).bitoraTrack?.('lead_form_submit', {
          location: 'contattaci',
          argomento: String(data.get('argomento') || ''),
        });
        window.location.href = '/contattaci/?inviato=1';
        return;
      }
      errorEl.textContent = (payload?.error || "Errore durante l'invio. Riprova o scrivici su WhatsApp.") + (res.status ? ` (HTTP ${res.status})` : '');
      errorEl.hidden = false;
    } catch {
      errorEl.textContent = 'Errore di connessione. Riprova o scrivici su WhatsApp.';
      errorEl.hidden = false;
    } finally {
      submitBtn.disabled = false;
      if (submitLabel) submitLabel.textContent = 'Invia la richiesta';
    }
  });
</script>

<style>
  .ct {
    position: relative;
    overflow: hidden;
    padding: calc(72px + clamp(2.5rem, 6vw, 5rem)) 0 clamp(4rem, 8vw, 7rem);
  }
  .ct__grid-bg {
    position: absolute;
    inset: 0;
  }
  .ct__orb {
    top: -18rem;
    left: -18rem;
  }
  .ct__inner {
    position: relative;
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .ct__inner {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 4.5rem;
      align-items: start;
    }
    .ct__intro {
      position: sticky;
      top: 110px;
    }
  }

  .ct__next {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .ct__next li {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .ct__next li > span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid rgba(34, 211, 238, 0.4);
    color: var(--b-cyan);
    font-family: var(--f-mono);
    font-size: 0.85rem;
  }
  .ct__next strong {
    display: block;
    font-size: 0.98rem;
  }
  .ct__next small {
    color: var(--b-fg-3);
    font-size: 0.85rem;
  }
  .ct__direct {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2.5rem;
  }
  .ct__quote {
    margin: 2.5rem 0 0;
    padding: 1.5rem;
    border-radius: 18px;
    border: 1px solid var(--b-line);
    background: rgba(255, 255, 255, 0.02);
  }
  .ct__quote blockquote {
    margin: 0 0 1rem;
    color: var(--b-fg-2);
    line-height: 1.6;
  }
  .ct__quote figcaption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.85rem;
    color: var(--b-fg-3);
  }
  .ct__quote img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    background: #fff;
  }
  .ct__quote strong {
    color: var(--b-fg);
  }

  .ct__card {
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border-radius: 28px;
    border: 1px solid var(--b-line-2);
    background: linear-gradient(180deg, rgba(16, 20, 26, 0.92), rgba(10, 12, 15, 0.92));
    box-shadow: 0 40px 100px -40px rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(12px);
  }
  .ct__card form {
    display: grid;
    gap: 1.25rem;
  }
  .ct__hp {
    position: absolute;
    left: -9999px;
  }
  .ct__fs {
    border: 0;
    margin: 0;
    padding: 0;
  }
  .ct__fs legend {
    margin-bottom: 0.75rem;
  }
  .ct__choices {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }
  @media (min-width: 640px) {
    .ct__choices {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .ct__choices :global(.b-choice span) {
    justify-content: center;
    text-align: center;
    min-height: 3.2rem;
    font-size: 0.85rem;
  }
  .ct__row {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .ct__row {
      grid-template-columns: 1fr 1fr;
    }
  }
  textarea.b-input {
    resize: vertical;
  }
  .ct__err {
    margin: 0;
    font-size: 0.8rem;
    color: #fca5a5;
  }
  .ct__privacy {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: 0.85rem;
    color: var(--b-fg-3);
    line-height: 1.5;
  }
  .ct__privacy input {
    margin-top: 0.2rem;
    width: 1.05rem;
    height: 1.05rem;
    accent-color: var(--b-cyan);
    flex-shrink: 0;
  }
  .ct__privacy a {
    color: var(--b-fg);
  }
  .ct__form-err {
    padding: 0.9rem 1rem;
    border-radius: 12px;
    border: 1px solid rgba(248, 113, 113, 0.4);
    background: rgba(248, 113, 113, 0.08);
    color: #fecaca;
    font-size: 0.9rem;
  }
  .ct__submit {
    width: 100%;
  }
  .ct__submit:disabled {
    opacity: 0.6;
    cursor: wait;
    transform: none;
  }
  .ct__fine {
    text-align: center;
  }

  .ct__ok {
    text-align: center;
    padding: 2rem 0;
  }
  .ct__ok-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    margin-bottom: 1.5rem;
    border-radius: 50%;
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.4);
    color: var(--b-cyan);
    font-size: 1.6rem;
  }
  .ct__ok .b-text {
    margin-top: 1rem;
  }
  .ct__ok .b-cta-row {
    justify-content: center;
  }
</style>
