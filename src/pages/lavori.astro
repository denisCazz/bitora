---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import ProjectCard from '../components/ui/ProjectCard.astro';
import BreadcrumbListSchema from '../components/schema/BreadcrumbList.astro';
import { getWork, workKindLabels, type WorkKind } from '../data/work';

const work = getWork().sort((a, b) => Number(a.isWip ?? false) - Number(b.isWip ?? false));
const kinds = (Object.keys(workKindLabels) as WorkKind[]).filter(k => work.some(w => w.kinds.includes(k)));
const live = work.filter(w => !w.isWip).length;
const listSchema = {
  '@type': 'ItemList',
  '@id': 'https://bitora.it/lavori/#list',
  name: 'Progetti realizzati da Bitora',
  numberOfItems: work.length,
  itemListElement: work.map((w, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://bitora.it/progetti/${w.slug}/`,
    name: w.title,
  })),
};
---

<Layout
  title="Lavori e progetti: siti, e-commerce, gestionali e app | Bitora"
  description="Portfolio Bitora: siti web, e-commerce, gestionali su misura e app realizzati per attività e aziende in Piemonte. Progetti veri, online e in uso ogni giorno."
  pageType="CollectionPage"
  schema={[listSchema]}
>
  <BreadcrumbListSchema
    crumbs={[
      { name: 'Home', item: 'https://bitora.it/' },
      { name: 'Lavori', item: 'https://bitora.it/lavori/' },
    ]}
  />
  <PageHero
    eyebrow={`Lavori · ${live} progetti online`}
    title='Progetti veri. <span class="b-grad">In uso ogni giorno.</span>'
    lede="Bar, ristoranti, artigiani, consulenti, aziende di impianti ed e-commerce tecnici. Ogni progetto è nato da un problema concreto: ecco come l’abbiamo risolto."
    crumbs={[{ name: 'Lavori', href: '/lavori/' }]}
  />

  <section class="b-section b-section--line wk">
    <div class="b-shell">
      <div class="wk__filters" role="tablist" aria-label="Filtra per tipo di progetto">
        <button type="button" class="wk__f is-on" data-filter="all" role="tab" aria-selected="true">
          Tutti <span>{work.length}</span>
        </button>
        {
          kinds.map(k => (
            <button type="button" class="wk__f" data-filter={k} role="tab" aria-selected="false">
              {workKindLabels[k]} <span>{work.filter(w => w.kinds.includes(k)).length}</span>
            </button>
          ))
        }
      </div>
      <div class="wk__grid">
        {
          work.map((w, i) => (
            <div class="wk__item" data-kinds={w.kinds.join(' ')} data-reveal data-reveal-delay={String((i % 3) + 1)}>
              <ProjectCard item={w} />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.wk__f');
  const items = document.querySelectorAll<HTMLElement>('.wk__item');
  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter!;
      buttons.forEach(b => {
        const on = b === btn;
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-selected', String(on));
      });
      items.forEach(it => {
        const show = f === 'all' || (it.dataset.kinds || '').split(' ').includes(f);
        it.hidden = !show;
        if (show) it.classList.add('is-in');
      });
    });
  });
</script>

<style>
  .wk__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 3rem;
  }
  .wk__f {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--b-line-2);
    background: transparent;
    color: var(--b-fg-2);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s,
      border-color 0.2s;
  }
  .wk__f span {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    color: var(--b-fg-3);
  }
  .wk__f:hover {
    border-color: rgba(255, 255, 255, 0.35);
    color: var(--b-fg);
  }
  .wk__f.is-on {
    background: var(--b-cyan);
    border-color: var(--b-cyan);
    color: #001318;
  }
  .wk__f.is-on span {
    color: rgba(0, 19, 24, 0.6);
  }
  .wk__grid {
    display: grid;
    gap: 3rem 2rem;
  }
  @media (min-width: 760px) {
    .wk__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .wk__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .wk__item[hidden] {
    display: none;
  }
</style>
