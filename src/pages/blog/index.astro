---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import PostCard from '../../components/blog/PostCard.astro';
import ProjectCard from '../../components/ui/ProjectCard.astro';
import BreadcrumbListSchema from '../../components/schema/BreadcrumbList.astro';
import { listPublishedArticles } from '../../lib/editorial/articles';
import { TOPIC_PILLARS } from '../../lib/editorial/topics';
import { getWorkBySlugs } from '../../data/work';
import { FOUNDER_ID, ORG_ID, SITE } from '../../data/seo';

const articles = await listPublishedArticles();
const [featured, ...rest] = articles;
const topics = TOPIC_PILLARS.filter(p => articles.some(a => a.topic === p.id));
const projects = getWorkBySlugs(['mistral-gestionale', 'garavella-7', 'accessi-aziendali-franchina']);

const blogSchema = {
  '@type': 'Blog',
  '@id': `${SITE}/blog/#blog`,
  name: 'Blog Bitora',
  alternateName: 'Radar Bitora',
  url: `${SITE}/blog/`,
  description:
    'Guide pratiche su siti web, SEO locale, e-commerce, gestionali, CRM, AI e NFC per PMI e attività locali, con costi, tempi e casi reali.',
  inLanguage: 'it-IT',
  publisher: { '@id': ORG_ID },
  author: { '@id': FOUNDER_ID },
  blogPost: articles.map(a => ({
    '@type': 'BlogPosting',
    '@id': `${SITE}/blog/${a.slug}/#article`,
    headline: a.title,
    url: `${SITE}/blog/${a.slug}/`,
    ...(a.publishedAt ? { datePublished: a.publishedAt.toISOString() } : {}),
  })),
};

---

<Layout
  title="Blog Bitora: guide su siti web, SEO, e-commerce, gestionali e AI per PMI"
  description="Guide pratiche per PMI e attività locali: quanto costa un sito, come scegliere un gestionale o un CRM, NFC per recensioni, AI applicata. Costi, tempi e casi reali."
  pageType="CollectionPage"
  schema={[blogSchema]}
>
  <BreadcrumbListSchema
    crumbs={[
      { name: 'Home', item: `${SITE}/` },
      { name: 'Blog', item: `${SITE}/blog/` },
    ]}
  />

  <PageHero
    eyebrow={`Blog · ${articles.length} guide`}
    title='Guide concrete per <span class="b-grad">vendere di più</span> e lavorare meno.'
    lede="Costi veri, tempi realistici ed esempi dai nostri progetti. Niente fuffa: quello che diremmo a un cliente seduto al nostro tavolo."
    crumbs={[{ name: 'Blog', href: '/blog/' }]}
    primary={{ label: 'Fai una domanda', href: '/contattaci/', track: 'blog_hero' }}
    secondary={{ label: 'Vedi i lavori', href: '/lavori/' }}
  />

  {
    featured ? (
      <section class="b-section b-section--tight">
        <div class="b-shell">
          <p class="b-eyebrow bl-label" data-reveal>
            Ultima guida
          </p>
          <div data-reveal data-reveal-delay="1">
            <PostCard article={featured} size="lg" eager />
          </div>
        </div>
      </section>
    ) : (
      <section class="b-section">
        <div class="b-shell">
          <p class="b-lede">Le prime guide arrivano a breve. Nel frattempo, scrivici: rispondiamo entro 24 ore.</p>
        </div>
      </section>
    )
  }

  {
    rest.length > 0 && (
      <section class="b-section b-section--line" id="guide">
        <div class="b-shell">
          <div class="bl-head" data-reveal>
            <h2 class="b-h2">Tutte le guide</h2>
            {topics.length > 1 && (
              <div class="bl-filters" role="toolbar" aria-label="Filtra per argomento">
                <button type="button" class="b-chip bl-f is-on" data-f="all" aria-pressed="true">
                  Tutte
                </button>
                {topics.map(t => (
                  <button type="button" class="b-chip bl-f" data-f={t.id} aria-pressed="false">
                    {t.label}
                  </button>
                ))}
              </div>
            )}
          </div>
          <div class="bl-grid">
            {rest.map((a, i) => (
              <div class="bl-item" data-topic={a.topic} data-reveal data-reveal-delay={String((i % 3) + 1)}>
                <PostCard article={a} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="b-section b-section--alt">
    <div class="b-shell">
      <div class="b-head b-head--split" data-reveal>
        <div>
          <p class="b-eyebrow">Dalla teoria ai progetti</p>
          <h2 class="b-h2">Quello che scriviamo, <span class="b-accent">lo facciamo</span>.</h2>
        </div>
        <a href="/lavori/" class="b-link">Tutti i lavori →</a>
      </div>
      <div class="bl-grid">
        {
          projects.map((p, i) => (
            <div data-reveal data-reveal-delay={String(i + 1)}>
              <ProjectCard item={p} />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.bl-f')];
  const items = [...document.querySelectorAll<HTMLElement>('.bl-item')];
  buttons.forEach(btn =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.f;
      buttons.forEach(b => {
        const on = b === btn;
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-pressed', String(on));
      });
      items.forEach(el => {
        el.hidden = f !== 'all' && el.dataset.topic !== f;
      });
      window.bitoraTrack?.('blog_filter', { label: f });
    })
  );
</script>

<style>
  .bl-label {
    margin-bottom: 1.25rem;
  }
  .bl-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  .bl-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .bl-f {
    cursor: pointer;
    font: inherit;
    font-size: 0.85rem;
    transition:
      background 0.2s,
      color 0.2s,
      border-color 0.2s;
  }
  .bl-f:hover {
    border-color: var(--b-line-2);
    color: var(--b-fg);
  }
  .bl-f.is-on {
    background: var(--b-cyan);
    border-color: var(--b-cyan);
    color: var(--b-ink);
  }
  .bl-grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 720px) {
    .bl-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1080px) {
    .bl-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .bl-item[hidden] {
    display: none;
  }
</style>
