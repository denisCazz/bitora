---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import RadarHub from '../../components/blog/RadarHub.astro';
import { listPublishedArticles } from '../../lib/editorial/articles';
import { formatArticleDate } from '../../lib/editorial/format';
import { getPublicCaseStudies } from '../../data/caseStudies';
import { TOPIC_PILLARS } from '../../lib/editorial/topics';

const articles = await listPublishedArticles();
const grouped = new Map<string, typeof articles>();
for (const article of articles) {
  const list = grouped.get(article.category) ?? [];
  list.push(article);
  grouped.set(article.category, list);
}
const cases = getPublicCaseStudies()
  .filter(cs =>
    ['nfc', 'web', 'gestionali', 'ecommerce'].some(topic =>
      cs.tecnologie
        .join(' ')
        .toLowerCase()
        .includes(topic === 'web' ? 'seo' : topic)
    )
  )
  .slice(0, 6);
---

<Layout
  title="Radar Bitora | Blog su NFC, siti, AI e gestionali per PMI"
  description="Il magazine Bitora: tendenze tech tradotte in casi reali su NFC, siti web, AI e gestionali. L’AI propone, un umano pubblica."
>
  <main id="main-content">
    <RadarHub articles={articles} />

    <section class="px-6 md:px-12 lg:px-20 py-16 border-t border-gray-200 dark:border-white/5">
      <h2 class="text-2xl md:text-4xl font-bold mb-8">Percorsi</h2>
      <div class="grid gap-10">
        {
          [...grouped.entries()].map(([category, items]) => (
            <div id={`percorso-${category.toLowerCase().replace(/\s+/g, '-')}`}>
              <h3 class="text-sm uppercase tracking-[0.16em] text-gray-500 mb-4">{category}</h3>
              <div class="grid md:grid-cols-2 gap-4">
                {items.map(article => (
                  <a
                    href={`/blog/${article.slug}/`}
                    class="rounded-2xl border border-gray-200 dark:border-white/10 p-5 hover:border-gray-400 dark:hover:border-white/30"
                  >
                    <p class="text-xs text-gray-500 mb-2">
                      {formatArticleDate(article.publishedAt)} · {article.readTime}
                    </p>
                    <h4 class="text-xl font-bold mb-2">{article.title}</h4>
                    <p class="text-sm text-gray-600 dark:text-gray-400">{article.excerpt}</p>
                  </a>
                ))}
              </div>
            </div>
          ))
        }
        {
          articles.length === 0 && (
            <p class="text-gray-500">Radar in calibratura. I segnali pubblicati appariranno qui.</p>
          )
        }
      </div>
    </section>

    <section class="px-6 md:px-12 lg:px-20 py-16 border-t border-gray-200 dark:border-white/5">
      <h2 class="text-2xl md:text-4xl font-bold mb-4">Casi reali</h2>
      <p class="text-gray-600 dark:text-gray-400 mb-8 max-w-2xl">
        Ogni articolo deve tornare a un lavoro fatto. Questi sono i ponti.
      </p>
      <div class="grid md:grid-cols-3 gap-4">
        {
          (cases.length ? cases : getPublicCaseStudies().slice(0, 6)).map(cs => (
            <a
              href={`/progetti/${cs.slug}/`}
              class="rounded-2xl border border-gray-200 dark:border-white/10 p-5"
            >
              <p class="text-xs uppercase tracking-[0.16em] text-gray-500">{cs.category}</p>
              <h3 class="text-lg font-bold mt-2">{cs.title}</h3>
              <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">{cs.subtitle}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="px-6 md:px-12 lg:px-20 py-16">
      <h2 class="text-2xl font-bold mb-6">Esplora per pilastro</h2>
      <div class="flex flex-wrap gap-3">
        {
          TOPIC_PILLARS.map(pillar => (
            <a
              href={pillar.href}
              class="px-4 py-2 rounded-full border border-gray-200 dark:border-white/10 text-sm"
            >
              {pillar.label}
            </a>
          ))
        }
      </div>
    </section>
  </main>
</Layout>
