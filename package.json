{
  "name": "bitora",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:production": "npm run build && npm run optimize",
    "optimize": "echo Running post-build optimizations...",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "analyze": "npx vite-bundle-analyzer dist",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "verify:seo": "node scripts/verify-seo-build.mjs",
    "security-check": "npm audit && npm outdated",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test:unit": "tsx --test src/lib/editorial/editorial.test.ts src/lib/spamGuard.test.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.5",
    "@astrojs/node": "^9.5.5",
    "@astrojs/react": "^5.0.1",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/tailwind": "^6.0.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "astro": "^5.16.0",
    "astro-compressor": "^1.0.0",
    "astro-robots-txt": "^1.0.0",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "qr-code-styling": "^1.9.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "resend": "^6.12.3",
    "tailwindcss": "^3.4.17",
    "terser": "^5.42.0",
    "web-vitals": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "astro-eslint-parser": "^1.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-astro": "^0.31.4",
    "lightningcss": "^1.30.1",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.13.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "vite-bundle-analyzer": "^0.10.4"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  }
}
