# Turbo-SMTP (pro.eu.turbo-smtp.com)
# https://serversmtp.com - Consumer Key = username, Consumer Secret = password

SMTP_HOST=pro.eu.turbo-smtp.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Umami Analytics (cloud.umami.is)
UMAMI_WEBSITE_ID=
UMAMI_API_TOKEN=

# Resend
RESEND_API_KEY=
MAIL_FROM="Bitora <info@bitora.it>"
MAIL_TO=info@bitora.it
MAIL_CC=deniscazzulo@icloud.com

# Area privata /ops (monitoraggio siti + VPS)
# Login: https://bitora.it/ops/
OPS_PASSWORD=
OPS_SESSION_SECRET=
OPS_CRON_SECRET=
# OPS_STATE_PATH=/data/bitora-ops-state.json
# Seed locale del gestore password (file gitignored, da copiare sul VPS se serve)
# OPS_VAULT_SEED_PATH=data/ops-vault.seed.json
# OPS_TELEGRAM_BOT_TOKEN=
# OPS_TELEGRAM_CHAT_ID=
# OPS_COOLIFY_URL=https://coolify.example.com/
# OPS_VPS_DISK_WARN=85
# OPS_VPS_MEM_WARN=90
# OPS_VPS_LOAD_WARN=1
# OPS_CRON_STALE_MS=720000
# OPS_SITE_TIMEOUT_MS=12000
# OPS_AGENT_STALE_MS=1200000
# OPS_ALERT_REMIND_MS=21600000
#
# Cron Coolify (ogni 5 minuti):
# curl -fsS -X POST -H "Authorization: Bearer $OPS_CRON_SECRET" https://bitora.it/api/ops/cron/
# Watchdog separato (ogni 10 minuti):
# curl -fsS -X POST -H "Authorization: Bearer $OPS_CRON_SECRET" https://bitora.it/api/ops/watchdog/
#
# Agent VPS:
# OPS_BACKUP_PATHS="postgres=/backup/postgres,files=/backup/files"
