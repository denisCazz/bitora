# Turbo-SMTP (pro.eu.turbo-smtp.com)
# https://serversmtp.com - Consumer Key = username, Consumer Secret = password

SMTP_HOST=pro.eu.turbo-smtp.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Umami Analytics (cloud.umami.is)
UMAMI_WEBSITE_ID=
UMAMI_API_TOKEN=

# Resend
RESEND_API_KEY=
MAIL_FROM="Bitora <info@bitora.it>"
MAIL_TO=info@bitora.it
MAIL_CC=deniscazzulo@icloud.com

# Area privata /ops (monitoraggio siti + VPS)
# Login: https://bitora.it/ops/
OPS_PASSWORD=
OPS_SESSION_SECRET=
OPS_CRON_SECRET=
# Authenticator TOTP opzionale (altrimenti si configura al primo login da /ops/)
# OPS_TOTP_SECRET=
# OPS_STATE_PATH=/data/bitora-ops-state.json
# Seed locale del gestore password (file gitignored).
# Import sul VPS: node scripts/push-ops-vault.mjs
# OPS_VAULT_SEED_PATH=data/ops-vault.seed.json
# OPS_TELEGRAM_BOT_TOKEN=
# OPS_TELEGRAM_CHAT_ID=
# OPS_COOLIFY_URL=https://coolify.example.com/
# OPS_VPS_DISK_WARN=85
# OPS_VPS_MEM_WARN=90
# OPS_VPS_LOAD_WARN=1
# OPS_CRON_STALE_MS=720000
# OPS_SITE_TIMEOUT_MS=12000
# OPS_AGENT_STALE_MS=1200000
# OPS_ALERT_REMIND_MS=21600000
#
# Cron Coolify (ogni 5 minuti):
# curl -fsS -X POST -H "Authorization: Bearer $OPS_CRON_SECRET" https://bitora.it/api/ops/cron/
# Watchdog separato (ogni 10 minuti):
# curl -fsS -X POST -H "Authorization: Bearer $OPS_CRON_SECRET" https://bitora.it/api/ops/watchdog/
#
# Agent VPS:
# OPS_BACKUP_PATHS="postgres=/backup/postgres,files=/backup/files"

# Blog editoriale (PostgreSQL + Tavily + OpenAI)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bitora?schema=public"
TAVILY_API_KEY=
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
EDITORIAL_CRON_ENABLED=true
EDITORIAL_CRON_INTERVAL_HOURS=48
EDITORIAL_TOPICS_PER_RUN=1
EDITORIAL_QUERIES_PER_TOPIC=1
EDITORIAL_TAVILY_DEPTH=basic
EDITORIAL_TAVILY_MAX_RESULTS=3
EDITORIAL_MAX_DRAFTS_PER_RUN=1
EDITORIAL_MAX_OPEN_DRAFTS=1
EDITORIAL_DAILY_BUDGET_USD=0.40
# EDITORIAL_MEDIA_PATH=/data/editorial-media
#
# Scheduler = cron ops esistente (ogni 5 min). La pipeline parte solo se è passato
# EDITORIAL_CRON_INTERVAL_HOURS. Non serve un secondo cron Coolify.
# Override: POST /api/ops/editorial/run/ con Bearer OPS_CRON_SECRET

